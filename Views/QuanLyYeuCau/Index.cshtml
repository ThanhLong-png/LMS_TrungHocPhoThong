@model IEnumerable<LMS_THPT.Models.YeuCauGiaoVien>
@{
    ViewData["Title"] = "Quản Lý Yêu Cầu Giáo Viên";
    Layout = User.IsInRole("HieuTruong") ? "_HieuTruongLayout" : "_AdminLayout";
}

@section Styles {
<style>
    .yc-stat-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
        gap: 1rem;
        margin-bottom: 1.5rem;
    }
    .yc-filter-bar {
        background: #fff; border: 1px solid var(--admin-border);
        border-radius: var(--admin-radius); padding: 1rem 1.25rem;
        margin-bottom: 1.25rem; display: flex; gap: 1rem;
        align-items: center; flex-wrap: wrap;
    }
    .filter-group { display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; }
    .filter-group label { font-size: 0.8rem; color: var(--admin-text-muted); font-weight: 600; white-space: nowrap; }
    .filter-pill {
        padding: 0.3rem 0.8rem; border-radius: 50px;
        border: 1.5px solid var(--admin-border); background: #fff;
        color: var(--admin-text-muted); font-size: 0.78rem; cursor: pointer;
        text-decoration: none; transition: all 0.18s; white-space: nowrap;
    }
    .filter-pill:hover { border-color: var(--admin-accent); color: var(--admin-accent); text-decoration: none; }
    .filter-pill.active { background: var(--admin-navy); border-color: var(--admin-navy); color: #fff; }
    .search-wrap { margin-left: auto; }
    .search-wrap input {
        border: 1.5px solid var(--admin-border); border-radius: 8px;
        padding: 0.4rem 0.9rem; font-size: 0.85rem; outline: none;
        width: 210px; transition: border-color 0.2s; font-family: inherit;
    }
    .search-wrap input:focus { border-color: var(--admin-accent); }

    .gv-avatar {
        width: 34px; height: 34px; border-radius: 50%;
        background: #eff6ff; color: #2563eb;
        font-weight: 700; font-size: 0.78rem;
        display: flex; align-items: center; justify-content: center; flex-shrink: 0;
    }
    .gv-name { font-weight: 600; color: var(--admin-text-primary); font-size: 0.88rem; }
    .gv-ma   { font-size: 0.73rem; color: var(--admin-text-muted); }

    .badge-loai {
        display: inline-block; padding: 0.18rem 0.65rem; border-radius: 50px;
        font-size: 0.72rem; font-weight: 600; white-space: nowrap;
        background: #dbeafe; color: #1d4ed8;
    }
    .badge-loai.nghiphep  { background: #fce7f3; color: #9d174d; }
    .badge-loai.doilich   { background: #ede9fe; color: #5b21b6; }
    .badge-loai.tailieu   { background: #d1fae5; color: #065f46; }
    .badge-loai.khieunai  { background: #fee2e2; color: #991b1b; }
    .badge-loai.khac      { background: #f3f4f6; color: #4b5563; }

    .badge-tt {
        display: inline-flex; align-items: center; gap: 0.3rem;
        padding: 0.22rem 0.7rem; border-radius: 50px;
        font-size: 0.75rem; font-weight: 600; white-space: nowrap;
    }
    .badge-tt::before { content: ''; width: 6px; height: 6px; border-radius: 50%; }
    .badge-cho    { background: #fef3c7; color: #7c5c00; } .badge-cho::before    { background: #d4a017; }
    .badge-duyet  { background: #dcfce7; color: #166534; } .badge-duyet::before  { background: #16a34a; }
    .badge-tuchoi { background: #fee2e2; color: #991b1b; } .badge-tuchoi::before { background: #dc2626; }

    .btn-xuly {
        background: var(--admin-navy); color: #fff; border: none;
        border-radius: 7px; padding: 0.3rem 0.85rem; font-size: 0.79rem;
        font-weight: 500; text-decoration: none; transition: background 0.2s; white-space: nowrap;
    }
    .btn-xuly:hover { background: #252d4a; color: #fff; text-decoration: none; }
    .btn-xuly.done { background: var(--admin-border); color: var(--admin-text-muted); }

    .cho-count {
        background: #f59e0b; color: #fff; border-radius: 50px;
        padding: 0.1rem 0.45rem; font-size: 0.7rem; font-weight: 700; margin-left: 0.2rem;
    }
</style>
}

<div class="admin-page-header">
    <div>
        <h1 class="admin-page-title">📬 Quản Lý Yêu Cầu Giáo Viên</h1>
        <div style="font-size:0.85rem; color:var(--admin-text-muted); margin-top:4px;">
            Xem xét và xử lý các yêu cầu từ giáo viên trong trường
        </div>
    </div>

</div>

@if (TempData["Success"] != null)
{
    <div class="admin-alert admin-alert-success"><span class="admin-alert-icon">✅</span> @TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="admin-alert admin-alert-danger"><span class="admin-alert-icon">❌</span> @TempData["Error"]</div>
}

<!-- STAT CARDS -->
<div class="yc-stat-grid">
    <div class="admin-stat-card">
        <div class="admin-stat-icon">📋</div>
        <div><div class="admin-stat-num">@ViewBag.TongSo</div><div class="admin-stat-label">Tổng yêu cầu</div></div>
    </div>
    <div class="admin-stat-card">
        <div class="admin-stat-icon" style="background:#fef3c7;">⏳</div>
        <div><div class="admin-stat-num" style="color:#7c5c00;">@ViewBag.ChoDuyet</div><div class="admin-stat-label">Chờ duyệt</div></div>
    </div>
    <div class="admin-stat-card">
        <div class="admin-stat-icon" style="background:#dcfce7;">✅</div>
        <div><div class="admin-stat-num" style="color:#166534;">@ViewBag.DaDuyet</div><div class="admin-stat-label">Đã duyệt</div></div>
    </div>
    <div class="admin-stat-card">
        <div class="admin-stat-icon" style="background:#fee2e2;">❌</div>
        <div><div class="admin-stat-num" style="color:#991b1b;">@ViewBag.TuChoi</div><div class="admin-stat-label">Từ chối</div></div>
    </div>
</div>

<!-- FILTER BAR -->
<div class="yc-filter-bar">
    <div class="filter-group">
        <label>Trạng thái:</label>
        <a href="@Url.Action("Index")" class="filter-pill @(ViewBag.Filter == null ? "active" : "")">Tất cả</a>
        <a href="@Url.Action("Index", new { trangThai = 0 })" class="filter-pill @(ViewBag.Filter == "0" ? "active" : "")">
            ⏳ Chờ duyệt @if ((int)ViewBag.ChoDuyet > 0) { <span class="cho-count">@ViewBag.ChoDuyet</span> }
        </a>
        <a href="@Url.Action("Index", new { trangThai = 2 })" class="filter-pill @(ViewBag.Filter == "2" ? "active" : "")">✅ Đã duyệt</a>
        <a href="@Url.Action("Index", new { trangThai = 3 })" class="filter-pill @(ViewBag.Filter == "3" ? "active" : "")">❌ Từ chối</a>
    </div>
    <div class="filter-group">
        <label>Loại:</label>
        <a href="@Url.Action("Index")" class="filter-pill @(ViewBag.LoaiFilter == null ? "active" : "")">Tất cả</a>
        <a href="@Url.Action("Index", new { loai = "NghiPhep" })" class="filter-pill @(ViewBag.LoaiFilter == "NghiPhep" ? "active" : "")">Nghỉ phép</a>
        <a href="@Url.Action("Index", new { loai = "DoiLich" })" class="filter-pill @(ViewBag.LoaiFilter == "DoiLich" ? "active" : "")">Đổi lịch</a>
        <a href="@Url.Action("Index", new { loai = "YeuCauTaiNguyen" })" class="filter-pill @(ViewBag.LoaiFilter == "YeuCauTaiNguyen" ? "active" : "")">Tài nguyên</a>
        <a href="@Url.Action("Index", new { loai = "KhieuNai" })" class="filter-pill @(ViewBag.LoaiFilter == "KhieuNai" ? "active" : "")">Khiếu nại</a>
    </div>
    <div class="search-wrap">
        <input type="text" id="searchInput" placeholder="🔍 Tìm giáo viên, tiêu đề..." />
    </div>
</div>

<!-- TABLE -->
<div class="admin-card">
    <div class="admin-card-body" style="padding:0;">
        <table class="admin-table" id="mainTable">
            <thead>
                <tr>
                    <th>Giáo Viên</th>
                    <th>Tiêu Đề</th>
                    <th>Loại</th>
                    <th>Ngày Gửi</th>
                    <th>Trạng Thái</th>
                    <th>Ngày Xử Lý</th>
                    <th style="text-align:center;">Thao Tác</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7">
                            <div class="admin-empty">
                                <div class="admin-empty-icon">📭</div>
                                <div class="admin-empty-title">Không có yêu cầu nào</div>
                                <div class="admin-empty-text">Chưa có yêu cầu nào phù hợp bộ lọc hiện tại</div>
                            </div>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var yc in Model)
                    {
                        var initials = yc.GiaoVien?.HoTen != null
                            ? string.Join("", yc.GiaoVien.HoTen.Split(' ').TakeLast(2).Select(x => x[0]))
                            : "GV";
                        var loaiClass = yc.LoaiYeuCau switch {
                            LMS_THPT.Models.LoaiYeuCau.NghiPhep         => "nghiphep",
                            LMS_THPT.Models.LoaiYeuCau.DoiLich          => "doilich",
                            LMS_THPT.Models.LoaiYeuCau.YeuCauTaiNguyen  => "tailieu",
                            LMS_THPT.Models.LoaiYeuCau.KhieuNai         => "khieunai",
                            LMS_THPT.Models.LoaiYeuCau.HocBu            => "doilich",
                            _                                            => "khac"
                        };
                        var loaiText = yc.LoaiYeuCau switch {
                            LMS_THPT.Models.LoaiYeuCau.NghiPhep              => "Nghỉ phép",
                            LMS_THPT.Models.LoaiYeuCau.DoiLich               => "Đổi lịch",
                            LMS_THPT.Models.LoaiYeuCau.YeuCauTaiNguyen       => "Tài nguyên",
                            LMS_THPT.Models.LoaiYeuCau.KhieuNai              => "Khiếu nại",
                            LMS_THPT.Models.LoaiYeuCau.HocBu                 => "Học bù",
                            LMS_THPT.Models.LoaiYeuCau.DangKyLopChuNhiem    => "ĐK Chủ nhiệm",
                            LMS_THPT.Models.LoaiYeuCau.ThayDoiLopChuNhiem   => "Đổi Chủ nhiệm",
                            LMS_THPT.Models.LoaiYeuCau.HuyLopChuNhiem       => "Hủy Chủ nhiệm",
                            LMS_THPT.Models.LoaiYeuCau.TangCapCongChuc      => "Tăng cấp CC",
                            LMS_THPT.Models.LoaiYeuCau.DanhGiaHangNam       => "Đánh giá HN",
                            _                                                 => "Khác"
                        };
                        var ttClass = yc.TrangThai switch {
                            LMS_THPT.Models.TrangThaiYeuCau.ChoXuLy  => "badge-cho",
                            LMS_THPT.Models.TrangThaiYeuCau.ChoDuyet => "badge-cho",
                            LMS_THPT.Models.TrangThaiYeuCau.DaDuyet  => "badge-duyet",
                            LMS_THPT.Models.TrangThaiYeuCau.TuChoi   => "badge-tuchoi",
                            _ => ""
                        };
                        var ttText = yc.TrangThai switch {
                            LMS_THPT.Models.TrangThaiYeuCau.ChoXuLy  => "Chờ duyệt",
                            LMS_THPT.Models.TrangThaiYeuCau.ChoDuyet => "Chờ duyệt",
                            LMS_THPT.Models.TrangThaiYeuCau.DaDuyet  => "Đã duyệt",
                            LMS_THPT.Models.TrangThaiYeuCau.TuChoi   => "Từ chối",
                            _ => ""
                        };
                        <tr>
                            <td>
                                <div style="display:flex; align-items:center; gap:0.65rem;">
                                    <div class="gv-avatar">@initials</div>
                                    <div>
                                        <div class="gv-name">@(yc.GiaoVien?.HoTen ?? "Không rõ")</div>
                                        <div class="gv-ma">@(yc.GiaoVien?.UserName ?? yc.MaGiaoVien)</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span style="font-weight:500; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; max-width:180px; display:block;"
                                      title="@yc.TieuDe">@yc.TieuDe</span>
                            </td>
                            <td><span class="badge-loai @loaiClass">@loaiText</span></td>
                            <td style="color:var(--admin-text-muted); font-size:0.82rem;">
                                @yc.NgayGui.ToString("dd/MM/yyyy")<br />
                                <span style="font-size:0.72rem;">@yc.NgayGui.ToString("HH:mm")</span>
                            </td>
                            <td><span class="badge-tt @ttClass">@ttText</span></td>
                            <td style="color:var(--admin-text-muted); font-size:0.82rem;">
                                @(yc.NgayXuLy.HasValue ? yc.NgayXuLy.Value.ToString("dd/MM/yyyy") : "—")
                            </td>
                            <td style="text-align:center;">
                                @if (yc.TrangThai == LMS_THPT.Models.TrangThaiYeuCau.ChoDuyet || yc.TrangThai == LMS_THPT.Models.TrangThaiYeuCau.ChoXuLy)
                                {
                                    <a asp-action="XuLy" asp-route-id="@yc.Id" class="btn-xuly">⚡ Xử lý</a>
                                }
                                else
                                {
                                    <a asp-action="XuLy" asp-route-id="@yc.Id" class="btn-xuly done">👁 Xem</a>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
<script>
    document.getElementById('searchInput').addEventListener('input', function () {
        const kw = this.value.toLowerCase();
        document.querySelectorAll('#mainTable tbody tr').forEach(r => {
            r.style.display = r.textContent.toLowerCase().includes(kw) ? '' : 'none';
        });
    });
</script>
}
