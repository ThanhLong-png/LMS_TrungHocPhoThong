@model LMS_THPT.Models.LichHoc

@{
    ViewData["Title"] = "Chỉnh sửa lịch học";
    Layout = User.IsInRole("HieuTruong") ? "_HieuTruongLayout" : "_AdminLayout";
    var lops = ViewBag.Lops as List<LMS_THPT.Models.Lop>;
}

<div style="max-width: 580px; margin: 2rem auto;">
    <div class="admin-card">
        <div class="admin-card-header">
            <h3>✏️ Cập nhật lịch học</h3>
        </div>

        <!-- META INFO -->
        <div style="background:var(--admin-surface); border-bottom:1px solid var(--admin-border);
                    padding:1rem 1.5rem; display:flex; gap:2rem; align-items:center;">
            <div>
                <div style="font-size:0.72rem; font-weight:600; color:var(--admin-text-muted);
                            text-transform:uppercase; letter-spacing:0.06em;">Lớp</div>
                <div style="font-weight:700; color:var(--admin-text-primary);">@Model.Lop?.TenLop</div>
            </div>
            <div style="width:1px; height:36px; background:var(--admin-border);"></div>
            <div>
                <div style="font-size:0.72rem; font-weight:600; color:var(--admin-text-muted);
                            text-transform:uppercase; letter-spacing:0.06em;">Thứ</div>
                <div style="font-weight:700; color:var(--admin-text-primary);">@Model.Thu</div>
            </div>
            <div style="width:1px; height:36px; background:var(--admin-border);"></div>
            <div>
                <div style="font-size:0.72rem; font-weight:600; color:var(--admin-text-muted);
                            text-transform:uppercase; letter-spacing:0.06em;">Tiết</div>
                <div style="font-weight:700; color:var(--admin-text-primary);">@Model.TietHoc</div>
            </div>
        </div>

        <div class="admin-card-body">
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="date" value="@Context.Request.Query["date"]" />
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="LopId" />

                <div class="admin-form-group">
                    <label class="admin-form-label">Môn học</label>
                    <select id="monSelect" name="MonHocId" class="admin-form-control">
                        <option value="@Model.MonHocId">@Model.MonHoc?.TenMonHoc</option>
                    </select>
                </div>

                <div class="admin-form-group">
                    <label class="admin-form-label">Giáo viên</label>
                    <input id="gvInput" class="admin-form-control" value="@Model.GiaoVien?.HoTen" readonly
                           style="background:#f8fafc; color:var(--admin-text-muted);" />
                    <input type="hidden" id="gvId" name="GiaoVienId" value="@Model.GiaoVienId" />
                </div>

                <div style="height:1px; background:var(--admin-border); margin:1.2rem 0;"></div>

                <div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem;">
                    <div class="admin-form-group">
                        <label class="admin-form-label">Thứ</label>
                        <input asp-for="Thu" class="admin-form-control" type="number" min="2" max="7" />
                    </div>
                    <div class="admin-form-group">
                        <label class="admin-form-label">Tiết</label>
                        <input asp-for="TietHoc" class="admin-form-control" type="number" min="1" max="10" />
                    </div>
                </div>

                <div class="admin-form-group">
                    <label class="admin-form-label">Phòng học</label>
                    <input asp-for="PhongHoc" class="admin-form-control" placeholder="Ví dụ: P.201" />
                </div>

                <div asp-validation-summary="All" class="admin-alert admin-alert-danger" style="display:none;"></div>

                <div style="display:flex; gap:0.75rem; margin-top:1.5rem;">
                    <button type="submit" class="admin-btn admin-btn-primary" style="flex:1;">Lưu thay đổi</button>
                    <a href="/LichHoc/ThoiKhoaBieu?lopId=@Model.LopId&date=@Context.Request.Query["date"]"
                       class="admin-btn admin-btn-secondary">Hủy bỏ</a>
                </div>
            </form>
        </div>

        <!-- XÓA -->
        <div style="padding:1rem 1.5rem; border-top:1px solid var(--admin-border);
                    display:flex; align-items:center; justify-content:space-between;
                    background:var(--admin-surface);">
            <span style="font-size:0.82rem; color:var(--admin-text-muted);">Xóa lịch học này khỏi hệ thống</span>
            <form asp-action="Delete" asp-controller="LichHoc" method="post"
                  onsubmit="return confirm('Xác nhận xóa lịch học này?')">
                @Html.AntiForgeryToken()
                <input type="hidden" name="date" value="@Context.Request.Query["date"]" />
                <input type="hidden" name="id" value="@Model.Id" />
                <button type="submit" class="admin-btn admin-btn-danger admin-btn-sm">🗑️ Xóa lịch</button>
            </form>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document).ready(function () {
        var lopId = @Model.LopId;
        $.get("/LichHoc/GetMonByLop", { lopId: lopId }, function (data) {
            $("#monSelect").html("");
            data.forEach(x => {
                var selected = x.monHocId == @Model.MonHocId ? "selected" : "";
                $("#monSelect").append(`<option value="${x.monHocId}" ${selected}>${x.tenMonHoc}</option>`);
            });
        });
    });

    $("#monSelect").change(function () {
        var monId = $(this).val();
        var lopId = @Model.LopId;
        $.get("/LichHoc/GetGiaoVienByMonHoc", { lopId: lopId, monHocId: monId }, function (data) {
            if (data.length > 0) {
                $("#gvInput").val(data[0].hoTen);
                $("#gvId").val(data[0].giaoVienId);
            } else {
                $("#gvInput").val("Chưa phân công");
                $("#gvId").val("");
            }
        });
    });
</script>
