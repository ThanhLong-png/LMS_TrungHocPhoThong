@model List<LMS_THPT.Models.DiemHocKy>
@{
    ViewData["Title"] = "Quản lý điểm học sinh";
    Layout = User.IsInRole("HieuTruong") ? "_HieuTruongLayout" : "_AdminLayout";

    var hs = (LMS_THPT.Models.NguoiDung)ViewBag.HocSinh;
    var dsNamHoc = (List<string>)(ViewBag.DsNamHoc ?? new List<string>());
    string selectedNamHoc = ViewBag.SelectedNamHoc ?? "";
    int? selectedHK = ViewBag.SelectedHocKy;
    var monHocs = (List<LMS_THPT.Models.MonHoc>)ViewBag.MonHocs;
    bool isLichSu = (bool)(ViewBag.IsLichSu ?? false);

    var hk1 = Model.Where(x => x.HocKy == 1).ToList();
    var hk2 = Model.Where(x => x.HocKy == 2).ToList();

    // Tạo danh sách năm học gợi ý
    int nam = DateTime.Now.Month >= 9 ? DateTime.Now.Year : DateTime.Now.Year - 1;
    var namHocGoiY = new List<string> {
        $"{nam}-{nam+1}", $"{nam-1}-{nam}", $"{nam-2}-{nam-1}"
    };
}

@if (TempData["Success"] != null) {
    <div class="admin-alert admin-alert-success"><span class="admin-alert-icon">✅</span> @TempData["Success"]</div>
}
@if (TempData["Error"] != null) {
    <div class="admin-alert admin-alert-danger"><span class="admin-alert-icon">❌</span> @TempData["Error"]</div>
}

<div class="admin-page-header">
    <div>
        <h1 class="admin-page-title">Điểm học sinh: @hs.HoTen</h1>
        <div style="font-size:.85rem;color:var(--admin-text-muted);margin-top:4px;">
            Mã: <strong>@hs.MaHocSinh</strong> &nbsp;·&nbsp;
            Lớp: <strong>@(hs.Lop?.TenLop ?? "Chưa có lớp")</strong>
        </div>
    </div>
</div>

<!-- CHỌN NĂM HỌC VÀ HỌC KỲ -->
<div class="admin-card mb-4">
    <div class="admin-card-body">
        <div class="d-flex flex-wrap align-items-center gap-3">
            <div>
                <span style="font-size:.82rem;color:var(--admin-text-muted);font-weight:600;">📆 Năm học:</span>
                <div class="d-flex flex-wrap gap-1 mt-1">
                    @foreach (var nh in dsNamHoc) {
                        <a href="@Url.Action("XemDiemHocSinh","QuanLyHocSinh",new{hocSinhId=hs.Id,namHoc=nh})"
                           class="admin-badge @(selectedNamHoc==nh?"admin-badge-primary":"admin-badge-secondary")"
                           style="text-decoration:none;padding:.35rem .9rem;font-size:.82rem;cursor:pointer;">
                            @nh
                        </a>
                    }
                    @if (!dsNamHoc.Any()) {
                        <span class="text-muted" style="font-size:.82rem;">Chưa có điểm nào</span>
                    }
                </div>
            </div>
            @if (!string.IsNullOrEmpty(selectedNamHoc)) {
                <div class="ms-auto">
                    <span style="font-size:.82rem;color:var(--admin-text-muted);font-weight:600;">Học kỳ:</span>
                    <div class="d-flex gap-1 mt-1">
                        <a href="@Url.Action("XemDiemHocSinh","QuanLyHocSinh",new{hocSinhId=hs.Id,namHoc=selectedNamHoc,hocKy=1})"
                           class="admin-badge @(selectedHK==1?"admin-badge-primary":"admin-badge-secondary")"
                           style="text-decoration:none;padding:.35rem .9rem;font-size:.82rem;">HK1</a>
                        <a href="@Url.Action("XemDiemHocSinh","QuanLyHocSinh",new{hocSinhId=hs.Id,namHoc=selectedNamHoc,hocKy=2})"
                           class="admin-badge @(selectedHK==2?"admin-badge-primary":"admin-badge-secondary")"
                           style="text-decoration:none;padding:.35rem .9rem;font-size:.82rem;">HK2</a>
                        @if (isLichSu)
                        {
                            <a href="@Url.Action("XemDiemHocSinh","QuanLyHocSinh",new{hocSinhId=hs.Id,namHoc=selectedNamHoc})"
                               class="admin-badge @(!selectedHK.HasValue?"admin-badge-primary":"admin-badge-secondary")"
                               style="text-decoration:none;padding:.35rem .9rem;font-size:.82rem;">Cả năm</a>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- BẢNG ĐIỂM -->
@if (!Model.Any())
{
    <div class="admin-empty">
        <div class="admin-empty-icon">📋</div>
        <div class="admin-empty-title">Chưa có điểm cho năm @selectedNamHoc</div>
        <div class="admin-empty-text">Bấm "+ Nhập điểm" để thêm điểm mới</div>
    </div>
}
else
{
    @if (!selectedHK.HasValue)
    {
        if (!isLichSu)
        {
            <div class="admin-card mb-4">
                <div class="admin-card-body" style="text-align:center;padding:2.5rem;">
                    <div style="font-size:3rem;margin-bottom:.8rem;">⏳</div>
                    <div style="font-weight:700;font-size:1.05rem;color:#92400e;">Năm học đang tiến hành</div>
                    <div style="font-size:.88rem;color:#78350f;margin-top:.4rem;">
                        Bảng tổng kết cả năm chỉ có khi cả 2 học kỳ đã kết thúc.<br/>
                        Hãy chọn <strong>HK1</strong> hoặc <strong>HK2</strong> để xem chi tiết từng kỳ.
                    </div>
                </div>
            </div>
        }
        else
        {
        var tbCaNam = ViewBag.TbCaNam as IEnumerable<dynamic>;
        if (tbCaNam != null)
        {
            <div class="admin-card mb-4">
                <div class="admin-card-body" style="padding:0;">
                    <div style="padding:1rem 1.5rem;font-weight:700;font-size:.95rem;
                                background:linear-gradient(90deg,#1a1f36,#3730a3); color:#fff;
                                border-bottom:1px solid var(--admin-border);display:flex;align-items:center;gap:.6rem;">
                        <span>🏆</span>
                        Bảng tổng kết cả năm — @selectedNamHoc
                    </div>
                    <div style="overflow-x:auto;">
                        <table class="admin-table" style="min-width:900px;">
                            <thead>
                                <tr>
                                    <th>Môn học</th>
                                    <th class="text-center">TK Học Kỳ 1</th>
                                    <th class="text-center">TK Học Kỳ 2</th>
                                    <th class="text-center" style="color:#059669;">TB Cả Năm</th>
                                    <th class="text-center">Xếp loại năm</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in tbCaNam)
                                {
                                    string? xl = row.XepLoai;
                                    string xlColor = xl=="Giỏi"?"#15803d":xl=="Khá"?"#1d4ed8":xl=="Trung bình"?"#854d0e":xl=="Yếu"?"#dc2626":"#9d174d";
                                    string xlBg = xl=="Giỏi"?"#dcfce7":xl=="Khá"?"#dbeafe":xl=="Trung bình"?"#fef9c3":xl=="Yếu"?"#fee2e2":"#fce7f3";
                                    <tr>
                                        <td style="font-weight:700;">@row.TenMonHoc</td>
                                        <td class="text-center" style="font-weight:600; color:#475569;">
                                            @(row.TkHK1 != null ? ((double)row.TkHK1).ToString("F1") : "—")
                                        </td>
                                        <td class="text-center" style="font-weight:600; color:#475569;">
                                            @(row.TkHK2 != null ? ((double)row.TkHK2).ToString("F1") : "—")
                                        </td>
                                        <td class="text-center">
                                            <span style="font-size:1.1rem;font-weight:800;color:#059669;">
                                                @(row.TbNam != null ? ((double)row.TbNam).ToString("F1") : "—")
                                            </span>
                                        </td>
                                        <td class="text-center">
                                            @if (!string.IsNullOrEmpty(xl)) {
                                                <span style="background:@xlBg;color:@xlColor;padding:2px 10px;border-radius:999px;font-size:.76rem;font-weight:700;">@xl</span>
                                            } else { <span style="color:#cbd5e1;">—</span> }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
        } // end else isLichSu
    }
    else
    {
        @foreach (var grp in Model.GroupBy(x => x.HocKy).OrderBy(g => g.Key))
        {
            <div class="admin-card mb-4">
                <div class="admin-card-body" style="padding:0;">
                    <div style="padding:1rem 1.5rem;font-weight:700;font-size:.95rem;
                                background:linear-gradient(90deg,@(grp.Key==1?"#eff6ff":"#f0fdf4"),#fff);
                                border-bottom:1px solid var(--admin-border);display:flex;align-items:center;gap:.6rem;">
                        <span>@(grp.Key==1?"📘":"📗")</span>
                        Học Kỳ @grp.Key — @selectedNamHoc
                    </div>
                    <div style="overflow-x:auto;">
                        <table class="admin-table" style="min-width:900px;">
                            <thead>
                                <tr>
                                    <th>Môn học</th>
                                    <th class="text-center">Miệng</th>
                                    <th class="text-center">15 phút</th>
                                    <th class="text-center">1 tiết</th>
                                    <th class="text-center">Giữa kỳ</th>
                                    <th class="text-center">Cuối kỳ</th>
                                    <th class="text-center" style="color:var(--admin-accent);">Tổng kết</th>
                                    <th class="text-center">Xếp loại</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var d in grp.OrderBy(x => x.MonHoc?.TenMonHoc))
                                {
                                    string? xl = d.XepLoai;
                                    string xlColor = xl=="Giỏi"?"#15803d":xl=="Khá"?"#1d4ed8":xl=="Trung bình"?"#854d0e":xl=="Yếu"?"#dc2626":"#9d174d";
                                    string xlBg = xl=="Giỏi"?"#dcfce7":xl=="Khá"?"#dbeafe":xl=="Trung bình"?"#fef9c3":xl=="Yếu"?"#fee2e2":"#fce7f3";
                                    var miengs = new[]{ d.DiemMieng1, d.DiemMieng2, d.DiemMieng3, d.DiemMieng4 }.Where(x=>x.HasValue).Select(x=>x!.Value.ToString("F1"));
                                    var p15s = new[]{ d.Diem15Phut1, d.Diem15Phut2 }.Where(x=>x.HasValue).Select(x=>x!.Value.ToString("F1"));
                                    var mts = new[]{ d.DiemMotTiet1, d.DiemMotTiet2 }.Where(x=>x.HasValue).Select(x=>x!.Value.ToString("F1"));
                                    <tr>
                                        <td style="font-weight:700;">@(d.MonHoc?.TenMonHoc??  "—")</td>
                                        <td class="text-center" style="font-size:.85rem;color:#475569;">
                                            @(miengs.Any() ? string.Join(" | ", miengs) : "—")
                                        </td>
                                        <td class="text-center" style="font-size:.85rem;color:#475569;">
                                            @(p15s.Any() ? string.Join(" | ", p15s) : "—")
                                        </td>
                                        <td class="text-center" style="font-size:.85rem;color:#475569;">
                                            @(mts.Any() ? string.Join(" | ", mts) : "—")
                                        </td>
                                        <td class="text-center" style="font-weight:600;">@(d.DiemGiuaKy?.ToString("F1") ?? "—")</td>
                                        <td class="text-center" style="font-weight:600;">@(d.DiemCuoiKy?.ToString("F1") ?? "—")</td>
                                        <td class="text-center">
                                            @{
                                                bool isCurrentYear = d.NamHoc == hs.NamHoc;
                                                bool isLocked = d.IsChotMieng && d.IsChotGiuaKy && d.IsChotCuoiKy;
                                                bool showTongKet = !isCurrentYear || isLocked;
                                            }
                                            <span style="font-size:1.1rem;font-weight:800;color:var(--admin-accent);">
                                                @(showTongKet && d.DiemTongKet.HasValue ? d.DiemTongKet.Value.ToString("F1") : "—")
                                            </span>
                                        </td>
                                        <td class="text-center">
                                            @if (showTongKet && !string.IsNullOrEmpty(xl)) {
                                                <span style="background:@xlBg;color:@xlColor;padding:2px 10px;border-radius:999px;font-size:.76rem;font-weight:700;">@xl</span>
                                            } else { <span style="color:#cbd5e1;">—</span> }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    }
}

<!-- MODAL: CHỌN NĂM XEM ĐIỂM -->
<div class="modal fade" id="modalChonNam" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-sm">
        <div class="modal-content" style="border-radius:var(--admin-radius);border:none;box-shadow:0 10px 40px rgba(0,0,0,.15);">
            <div class="modal-header" style="background:var(--admin-navy);color:#fff;border-radius:var(--admin-radius) var(--admin-radius) 0 0;">
                <h5 class="modal-title" style="font-weight:700;">📅 Chọn năm học</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" style="padding:1rem;">
                <div class="list-group list-group-flush">
                    @foreach (var nh in namHocGoiY) {
                        <a href="@Url.Action("XemDiemHocSinh","QuanLyHocSinh",new{hocSinhId=hs.Id,namHoc=nh})" 
                           class="list-group-item list-group-item-action d-flex justify-content-between align-items-center @(selectedNamHoc == nh ? "active" : "")"
                           style="border-radius:8px; margin-bottom: 4px; border: none;">
                            @nh
                            @if (selectedNamHoc == nh) { <small>● Đang xem</small> }
                        </a>
                    }
                </div>
                <hr />
                <div class="text-muted" style="font-size:.75rem;">Năm học hiện tại của HS: <strong>@(hs.NamHoc ?? "Chưa đặt")</strong></div>
            </div>
        </div>
    </div>
</div>


