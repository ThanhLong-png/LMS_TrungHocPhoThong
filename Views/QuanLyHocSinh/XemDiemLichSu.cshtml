@model List<LMS_THPT.Models.LichSuDiemHocSinh>
@{
    ViewData["Title"] = "Điểm lịch sử học sinh";
    Layout = "_AdminLayout";
    var lichSu = (LMS_THPT.Models.LichSuHocSinh)ViewBag.LichSu;
}

<div class="admin-page-header">
    <div>
        <h1 class="admin-page-title">📊 Lịch sử điểm: @lichSu.HoTen</h1>
        <div style="font-size:.85rem;color:var(--admin-text-muted);margin-top:4px;">
            Mã: <strong>@(lichSu.MaHocSinh ?? "—")</strong> &nbsp;·&nbsp;
            Lớp cuối: <strong>@(lichSu.TenLop ?? "—")</strong> &nbsp;·&nbsp;
            Nghỉ ngày: <strong>@lichSu.NgayXoa.ToString("dd/MM/yyyy")</strong>
        </div>
    </div>

</div>

<!-- THÔNG TIN HỌC SINH -->
<div class="admin-card mb-4">
    <div class="admin-card-body">
        <div class="row g-3">
            <div class="col-md-3">
                <div style="font-size:.78rem;color:var(--admin-text-muted);text-transform:uppercase;letter-spacing:.04em;">Họ và tên</div>
                <div style="font-weight:700;margin-top:2px;">@lichSu.HoTen</div>
            </div>
            <div class="col-md-2">
                <div style="font-size:.78rem;color:var(--admin-text-muted);text-transform:uppercase;letter-spacing:.04em;">Giới tính</div>
                <div style="font-weight:600;margin-top:2px;">@(lichSu.GioiTinh ?? "—")</div>
            </div>
            <div class="col-md-2">
                <div style="font-size:.78rem;color:var(--admin-text-muted);text-transform:uppercase;letter-spacing:.04em;">Ngày sinh</div>
                <div style="font-weight:600;margin-top:2px;">@(lichSu.NgaySinh?.ToString("dd/MM/yyyy") ?? "—")</div>
            </div>
            <div class="col-md-2">
                <div style="font-size:.78rem;color:var(--admin-text-muted);text-transform:uppercase;letter-spacing:.04em;">Năm học cuối</div>
                <div style="font-weight:700;color:#4f46e5;margin-top:2px;">@(lichSu.NamHocCuoi ?? "—")</div>
            </div>
            <div class="col-md-3">
                <div style="font-size:.78rem;color:var(--admin-text-muted);text-transform:uppercase;letter-spacing:.04em;">Lý do nghỉ</div>
                <div style="font-weight:600;margin-top:2px;color:#dc2626;">@(lichSu.LyDoXoa ?? "Không ghi chú")</div>
            </div>
        </div>
    </div>
</div>

@if (!Model.Any())
{
    <div class="admin-empty">
        <div class="admin-empty-icon">📋</div>
        <div class="admin-empty-title">Không có dữ liệu điểm</div>
        <div class="admin-empty-text">Học sinh này chưa có điểm được lưu trước khi nghỉ</div>
    </div>
}
else
{
    @foreach (var grpNam in Model.GroupBy(x => x.NamHoc).OrderByDescending(g => g.Key))
    {
        <div style="font-size:1rem;font-weight:700;color:#1e293b;margin:1.5rem 0 .8rem;display:flex;align-items:center;gap:.6rem;">
            📅 Năm học @grpNam.Key
        </div>

        @foreach (var grpHK in grpNam.GroupBy(x => x.HocKy).OrderBy(g => g.Key))
        {
            <div class="admin-card mb-3">
                <div class="admin-card-body" style="padding:0;overflow-x:auto;">
                    <div style="padding:.9rem 1.4rem;font-weight:700;font-size:.9rem;
                                background:linear-gradient(90deg,@(grpHK.Key==1?"#eff6ff":"#f0fdf4"),#fff);
                                border-bottom:1px solid var(--admin-border);display:flex;align-items:center;gap:.5rem;">
                        @(grpHK.Key==1?"📘":"📗") Học Kỳ @grpHK.Key
                        @if (!string.IsNullOrEmpty(grpHK.First().TenLop)) {
                            <span class="admin-badge admin-badge-info ms-2">Lớp @grpHK.First().TenLop</span>
                        }
                    </div>
                    <table class="admin-table" style="min-width:860px;">
                        <thead>
                            <tr>
                                <th>Môn học</th>
                                <th class="text-center">Miệng</th>
                                <th class="text-center">15 phút</th>
                                <th class="text-center">1 tiết</th>
                                <th class="text-center">Giữa kỳ</th>
                                <th class="text-center">Cuối kỳ</th>
                                <th class="text-center" style="color:var(--admin-accent);">Tổng kết</th>
                                <th class="text-center">Xếp loại</th>
                                <th>Nhận xét</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var d in grpHK.OrderBy(x => x.TenMonHoc))
                            {
                                string? xl = d.XepLoai;
                                string xlColor = xl=="Giỏi"?"#15803d":xl=="Khá"?"#1d4ed8":xl=="Trung bình"?"#854d0e":xl=="Yếu"?"#dc2626":"#9d174d";
                                string xlBg = xl=="Giỏi"?"#dcfce7":xl=="Khá"?"#dbeafe":xl=="Trung bình"?"#fef9c3":xl=="Yếu"?"#fee2e2":"#fce7f3";
                                var miengs = new[]{ d.DiemMieng1, d.DiemMieng2, d.DiemMieng3 }.Where(x=>x.HasValue).Select(x=>x!.Value.ToString("F1"));
                                var p15s = new[]{ d.Diem15Phut1, d.Diem15Phut2 }.Where(x=>x.HasValue).Select(x=>x!.Value.ToString("F1"));
                                var mts = new[]{ d.DiemMotTiet1, d.DiemMotTiet2 }.Where(x=>x.HasValue).Select(x=>x!.Value.ToString("F1"));
                                <tr>
                                    <td style="font-weight:700;">@(d.TenMonHoc ?? "—")</td>
                                    <td class="text-center" style="font-size:.85rem;color:#475569;">@(miengs.Any()?string.Join(" | ",miengs):"—")</td>
                                    <td class="text-center" style="font-size:.85rem;color:#475569;">@(p15s.Any()?string.Join(" | ",p15s):"—")</td>
                                    <td class="text-center" style="font-size:.85rem;color:#475569;">@(mts.Any()?string.Join(" | ",mts):"—")</td>
                                    <td class="text-center" style="font-weight:600;">@(d.DiemGiuaKy?.ToString("F1")??"—")</td>
                                    <td class="text-center" style="font-weight:600;">@(d.DiemCuoiKy?.ToString("F1")??"—")</td>
                                    <td class="text-center">
                                        <span style="font-size:1.05rem;font-weight:800;color:var(--admin-accent);">
                                            @(d.DiemTongKet?.ToString("F1")??"—")
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        @if (!string.IsNullOrEmpty(xl)) {
                                            <span style="background:@xlBg;color:@xlColor;padding:2px 10px;border-radius:999px;font-size:.76rem;font-weight:700;">@xl</span>
                                        } else { <span style="color:#cbd5e1;">—</span> }
                                    </td>
                                    <td style="font-size:.82rem;color:#475569;max-width:200px;">@(d.NhanXet ?? "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
}
