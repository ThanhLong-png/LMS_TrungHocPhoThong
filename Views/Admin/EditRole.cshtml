@{
    ViewData["Title"] = "Sửa vai trò";
    ViewData["PageTitle"] = "Sửa vai trò tài khoản";
    Layout = "_AdminLayout";
}

@section Styles {
<style>
    .ad-form-card {
        max-width: 480px;
        margin: 0 auto;
        background: #fff;
        border-radius: 16px;
        padding: 32px 36px;
        box-shadow: 0 4px 24px rgba(0,0,0,0.08);
        border: 1px solid rgba(0,0,0,0.06);
    }

    .ad-form-title {
        font-size: 1.2rem;
        font-weight: 800;
        color: #1e293b;
        margin-bottom: 24px;
        letter-spacing: -0.02em;
    }

    .ad-user-info {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 14px 18px;
        margin-bottom: 20px;
    }

    .ad-user-info p {
        margin: 0;
        font-size: 0.88rem;
        color: #475569;
        line-height: 1.8;
    }

    .ad-user-info strong { color: #1e293b; }

    .ad-form-group { margin-bottom: 16px; }

    .ad-form-label {
        display: block;
        font-size: 0.82rem;
        font-weight: 600;
        color: #64748b;
        margin-bottom: 6px;
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }

    .ad-form-control {
        width: 100%;
        padding: 10px 14px;
        border: 1.5px solid #e2e8f0;
        border-radius: 10px;
        font-size: 0.9rem;
        font-family: inherit;
        color: #1e293b;
        background: #f8fafc;
        transition: border-color 0.18s, box-shadow 0.18s;
        outline: none;
    }

    .ad-form-control:focus {
        border-color: #6366f1;
        background: #fff;
        box-shadow: 0 0 0 3px rgba(99,102,241,0.1);
    }

    .ad-form-actions {
        display: flex;
        gap: 10px;
        margin-top: 24px;
    }

    .ad-btn-primary {
        flex: 1;
        padding: 11px;
        background: linear-gradient(135deg, #6366f1, #4f46e5);
        color: #fff;
        border: none;
        border-radius: 10px;
        font-size: 0.9rem;
        font-weight: 700;
        cursor: pointer;
        transition: opacity 0.18s;
    }

    .ad-btn-primary:hover { opacity: 0.88; }

    .ad-btn-secondary {
        padding: 11px 18px;
        background: #f1f5f9;
        color: #64748b;
        border: 1.5px solid #e2e8f0;
        border-radius: 10px;
        font-size: 0.9rem;
        font-weight: 600;
        cursor: pointer;
        text-decoration: none;
        display: flex;
        align-items: center;
        transition: background 0.18s;
    }

    .ad-btn-secondary:hover { background: #e2e8f0; color: #334155; text-decoration: none; }
</style>
}

<div class="ad-form-card">
    <div class="ad-form-title">✏️ Sửa Vai Trò Tài Khoản</div>

    <div class="ad-user-info">
        <p><strong>Họ tên:</strong> @ViewBag.User.HoTen</p>
        <p><strong>Email:</strong> @ViewBag.User.Email</p>
        <p><strong>Vai trò hiện tại:</strong> @string.Join(", ", ViewBag.UserRoles)</p>
    </div>

    <form asp-action="EditRole" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="userId" value="@ViewBag.User.Id" />

        <div class="ad-form-group">
            <label class="ad-form-label">Vai trò mới</label>
            <select name="role" class="ad-form-control">
                @foreach (var r in ViewBag.Roles)
                {
                    if (ViewBag.UserRoles.Contains(r))
                    {
                        <option value="@r" selected>@r</option>
                    }
                    else
                    {
                        <option value="@r">@r</option>
                    }
                }
            </select>
        </div>

        <div class="ad-form-actions">
            <button type="submit" class="ad-btn-primary">Lưu thay đổi</button>
        </div>
    </form>
</div>