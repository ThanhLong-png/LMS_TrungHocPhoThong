@model LMS_THPT.Models.BaiTap
@{
    ViewData["Title"] = Model.TieuDe;
    Layout = "~/Views/Shared/_LayoutHocSinh.cshtml";
    var binhLuans = ViewBag.BinhLuans as List<LMS_THPT.Models.BinhLuan> ?? new List<LMS_THPT.Models.BinhLuan>();
    var daNop = ViewBag.DaNop as LMS_THPT.Models.BaiNop;
    bool conHan = Model.HanNop > DateTime.Now;
}

<style>
    .bg-back-btn {
        display: inline-flex; align-items: center; gap: 0.4rem;
        color: #475569; text-decoration: none; font-size: 0.88rem;
        margin-bottom: 1.2rem; transition: color 0.2s;
    }
    .bg-back-btn:hover { color: #ff6b00; }

    .detail-card { background: #fff; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.08); overflow: hidden; }

    .detail-banner {
        background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
        padding: 2rem 2.5rem; color: #fff;
        box-shadow: 0 10px 30px rgba(37,99,235,0.15);
    }

    .detail-body { padding: 2rem 2.5rem; }

    .info-grid {
        display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 1rem; margin-bottom: 2rem;
    }
    .info-item { background: #f8fafc; border-radius: 12px; padding: 1rem; }
    .info-label { font-size: 0.78rem; color: #94a3b8; font-weight: 600; text-transform: uppercase; margin-bottom: 0.3rem; }
    .info-value { font-size: 0.95rem; color: #1e293b; font-weight: 600; }

    .content-section {
        background: #f8fafc; border-radius: 14px;
        padding: 1.5rem; margin-bottom: 2rem;
        color: #334155; line-height: 1.7; font-size: 0.95rem;
    }

    .btn-nop-hs {
        background: linear-gradient(135deg, #ff6b00, #ff8c00);
        color: #fff; border: none; border-radius: 10px;
        padding: 0.6rem 1.8rem; font-size: 0.92rem; font-weight: 600;
        text-decoration: none; display: inline-flex; align-items: center; gap: 0.4rem;
        transition: opacity 0.2s;
    }
    .btn-nop-hs:hover { opacity: 0.85; color: #fff; }

    /* ====== COMMENT SECTION ====== */
    .comment-section {
        background: #f8fafc; border-radius: 14px;
        padding: 1.4rem; margin-top: 2rem;
    }
    .comment-section-title {
        font-size: 0.95rem; font-weight: 700; color: #334155;
        margin-bottom: 1rem; display: flex; align-items: center; gap: 0.4rem;
    }
    .comment-item { display: flex; gap: 10px; margin-bottom: 14px; }
    .comment-avatar-wrap { flex-shrink: 0; }
    .comment-avatar-img { width: 36px; height: 36px; border-radius: 50%; object-fit: cover; }
    .comment-avatar-txt {
        width: 36px; height: 36px; border-radius: 50%;
        background: #334155; color: #fff;
        display: flex; align-items: center; justify-content: center;
        font-size: 0.9rem; font-weight: 700;
    }
    .comment-bubble {
        background: #fff; border-radius: 12px;
        padding: 0.7rem 1rem; border: 1px solid #e2e8f0; flex: 1;
    }
    .comment-author { font-weight: 700; font-size: 0.87rem; color: #1e293b; }
    .comment-text { font-size: 0.9rem; color: #334155; margin: 3px 0 5px; }
    .comment-meta { font-size: 0.76rem; color: #94a3b8; display: flex; align-items: center; gap: 10px; }
    .btn-reply-toggle {
        background: none; border: none; color: #ff6b00;
        font-size: 0.76rem; font-weight: 600; cursor: pointer; padding: 0;
    }
    .comment-input-row { display: flex; gap: 8px; margin-top: 10px; }
    .comment-input {
        flex: 1; border: 1.5px solid #e2e8f0; border-radius: 10px;
        padding: 0.55rem 1rem; font-size: 0.88rem; outline: none;
        background: #fff; transition: border-color 0.2s;
    }
    .comment-input:focus { border-color: #ff6b00; }
    .comment-submit {
        background: linear-gradient(135deg,#ff6b00,#ff8c00);
        color:#fff; border:none; border-radius:10px;
        padding: 0.55rem 1.3rem; font-size:0.88rem;
        font-weight:600; cursor:pointer; transition:opacity 0.2s;
    }
    .comment-submit:hover { opacity: 0.85; }
</style>

<a href="@Url.Action("BaiTap","HocSinh")" class="bg-back-btn">← Quay lại danh sách bài tập</a>

<div class="detail-card">
    <!-- BANNER -->
    <div class="detail-banner">
        <div class="mb-2">
            <span style="background:rgba(255,255,255,0.2); color:#fff; padding:3px 12px; border-radius:8px; font-size:0.8rem;">
                📝 @(Model.MonHoc?.TenMonHoc ?? "Bài tập")
            </span>
        </div>
        <h1 style="font-size:1.6rem; font-weight:700; margin-bottom:0.5rem;">@Model.TieuDe</h1>
        @if (!string.IsNullOrEmpty(Model.MoTa))
        {
            <p class="opacity-75 mb-0" style="font-size:0.95rem;">@Model.MoTa</p>
        }
    </div>

    <div class="detail-body">
        <!-- INFO GRID -->
        <div class="info-grid">
            <div class="info-item">
                <div class="info-label">Môn học</div>
                <div class="info-value">@(Model.MonHoc?.TenMonHoc ?? "—")</div>
            </div>
            <div class="info-item">
                <div class="info-label">Giáo viên</div>
                <div class="info-value">@(Model.NguoiDung?.HoTen ?? "—")</div>
            </div>
            <div class="info-item">
                <div class="info-label">Hạn nộp</div>
                <div class="info-value" style="color: @(conHan ? "#15803d" : "#dc2626");">
                    @Model.HanNop.ToString("dd/MM/yyyy HH:mm")
                </div>
            </div>
            <div class="info-item">
                <div class="info-label">Điểm tối đa</div>
                <div class="info-value">@Model.DiemToiDa điểm</div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.NoiDung))
        {
            <h5 class="fw-bold mb-3" style="color:#1e293b;">📋 Nội dung bài tập</h5>
            <div class="content-section">@Html.Raw(Model.NoiDung)</div>
        }

        <!-- NỘP BÀI -->
        @if (daNop != null)
        {
            <div style="background:#dcfce7; border-radius:12px; padding:1rem 1.4rem; margin-bottom:1.5rem;">
                <div style="font-weight:700; color:#15803d; margin-bottom:0.3rem;">✅ Đã nộp bài</div>
                <div style="font-size:0.85rem; color:#166534;">
                    Nộp lúc: @daNop.NgayNop.ToString("dd/MM/yyyy HH:mm")
                    @if (daNop.Diem.HasValue)
                    {
                        <span style="margin-left:12px; background:#fff; padding:2px 10px; border-radius:8px; font-weight:700; color:#d97706;">
                            Điểm: @daNop.Diem / @Model.DiemToiDa
                        </span>
                    }
                    else
                    {
                        <span style="margin-left:12px; color:#6b7280;">⌛ Chờ chấm điểm</span>
                    }
                </div>
                @if (!string.IsNullOrEmpty(daNop.NhanXet))
                {
                    <div style="margin-top:0.5rem; font-size:0.88rem; color:#374151;">
                        💬 Nhận xét: @daNop.NhanXet
                    </div>
                }
            </div>
            <a href="@Url.Action("NopBai","HocSinh", new { id = Model.Id })" class="btn-nop-hs" style="background: linear-gradient(135deg,#6366f1,#4f46e5);">
                🔄 Nộp lại
            </a>
        }
        else if (conHan)
        {
            <a href="@Url.Action("NopBai","HocSinh", new { id = Model.Id })" class="btn-nop-hs">
                📤 Nộp bài
            </a>
        }
        else
        {
            <span style="color:#94a3b8; font-size:0.9rem;">🔴 Đã hết hạn nộp bài</span>
        }

        <!-- ===== BÌNH LUẬN ===== -->
        <div class="comment-section">
            <div class="comment-section-title">💬 Bình luận (@binhLuans.Count)</div>

            @foreach (var bl in binhLuans)
            {
                <div class="comment-item">
                    <div class="comment-avatar-wrap">
                        @if (!string.IsNullOrEmpty(bl.NguoiDung?.AnhDaiDien))
                        {
                            <img src="@bl.NguoiDung.AnhDaiDien" class="comment-avatar-img" />
                        }
                        else
                        {
                            <div class="comment-avatar-txt">@(bl.NguoiDung?.HoTen?.Substring(0,1).ToUpper() ?? "?")</div>
                        }
                    </div>
                    <div style="flex:1; min-width:0;">
                        <div class="comment-bubble">
                            <div class="comment-author">@(bl.NguoiDung?.HoTen ?? "Ẩn danh")</div>
                            <div class="comment-text">@bl.NoiDung</div>
                            <div class="comment-meta">
                                <span>@bl.NgayTao.ToString("g")</span>
                                <button class="btn-reply-toggle" onclick="toggleReply('reply-@bl.Id', this)">Trả lời</button>
                            </div>
                        </div>

                        <div id="reply-@bl.Id" style="display:none; margin-top:6px; margin-left:8px;">
                            <form asp-controller="HocSinh" asp-action="TraLoiBinhLuan" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="parentId" value="@bl.Id" />
                                <input type="hidden" name="baiTapId" value="@Model.Id" />
                                <div class="comment-input-row">
                                    <input name="noiDung" class="comment-input" placeholder="Trả lời @(bl.NguoiDung?.HoTen)..." required />
                                    <button type="submit" class="comment-submit">Gửi</button>
                                </div>
                            </form>
                        </div>

                        @if (bl.Replies != null && bl.Replies.Any())
                        {
                            <div style="margin-top:8px; margin-left:8px; border-left:2px solid #e2e8f0; padding-left:10px;">
                                @foreach (var reply in bl.Replies.OrderBy(r => r.NgayTao))
                                {
                                    <div class="comment-item" style="margin-bottom:8px;">
                                        <div class="comment-avatar-wrap">
                                            @if (!string.IsNullOrEmpty(reply.NguoiDung?.AnhDaiDien))
                                            {
                                                <img src="@reply.NguoiDung.AnhDaiDien" class="comment-avatar-img" />
                                            }
                                            else
                                            {
                                                <div class="comment-avatar-txt">@(reply.NguoiDung?.HoTen?.Substring(0,1).ToUpper() ?? "?")</div>
                                            }
                                        </div>
                                        <div class="comment-bubble" style="flex:1;">
                                            <div class="comment-author">@(reply.NguoiDung?.HoTen ?? "Ẩn danh")</div>
                                            <div class="comment-text">@reply.NoiDung</div>
                                            <div class="comment-meta">@reply.NgayTao.ToString("g")</div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }

            @if (!binhLuans.Any())
            {
                <div style="text-align:center; color:#94a3b8; padding: 1rem 0; font-size:0.9rem;">
                    Chưa có bình luận nào. Hãy là người đầu tiên!
                </div>
            }

            <!-- Form thêm bình luận mới -->
            <form asp-controller="HocSinh" asp-action="ThemBinhLuanBaiTap" method="post" style="margin-top:12px;">
                @Html.AntiForgeryToken()
                <input type="hidden" name="baiTapId" value="@Model.Id" />
                <div class="comment-input-row">
                    <input name="noiDung" class="comment-input" placeholder="Viết bình luận..." required />
                    <button type="submit" class="comment-submit">Gửi</button>
                </div>
            </form>
        </div>

        <div class="mt-4">
            <a href="@Url.Action("BaiTap","HocSinh")" class="btn btn-outline-secondary" style="border-radius:10px;">
                ← Quay lại
            </a>
        </div>
    </div>
</div>

<script>
function toggleReply(id, btn) {
    var el = document.getElementById(id);
    if (!el) return;
    el.style.display = el.style.display === 'none' ? 'block' : 'none';
    btn.textContent = el.style.display === 'none' ? 'Trả lời' : 'Huỷ';
}
</script>
