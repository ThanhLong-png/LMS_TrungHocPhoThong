@model List<LMS_THPT.Models.BaiGiang>
@{
    ViewData["Title"] = "Bài giảng";
    Layout = "~/Views/Shared/_LayoutHocSinh.cshtml";
    var monHocs = (List<LMS_THPT.Models.MonHoc>)ViewBag.MonHocs;
    int? selectedMon = ViewBag.SelectedMonHoc;
    string? q = ViewBag.SearchQuery;
}

<style>
    .page-header {
        background: linear-gradient(135deg, #ff6b00 0%, #ff8c00 100%);
        border-radius: 16px;
        padding: 1.8rem 2rem;
        color: #fff;
        margin-bottom: 2rem;
        box-shadow: 0 10px 30px rgba(255,107,0,0.15);
    }

    .filter-bar {
        background: #fff;
        border-radius: 14px;
        padding: 1.2rem 1.5rem;
        box-shadow: 0 2px 12px rgba(0,0,0,0.07);
        margin-bottom: 1.5rem;
        display: flex;
        flex-wrap: wrap;
        gap: 0.8rem;
        align-items: center;
    }

    .lecture-card {
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.07);
        border: 1px solid rgba(0,0,0,0.05);
        overflow: hidden;
        transition: transform 0.2s, box-shadow 0.2s;
        height: 100%;
    }

    .lecture-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 30px rgba(0,0,0,0.12);
    }

    .lecture-thumb {
        height: 140px;
        background: linear-gradient(135deg, #ff8c00 0%, #ff6b00 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 3rem;
        position: relative;
        overflow: hidden;
    }

    .lecture-thumb::after {
        content: '';
        position: absolute;
        bottom: 0; left: 0; right: 0;
        height: 40px;
        background: linear-gradient(transparent, rgba(0,0,0,0.2));
    }

    .lecture-body {
        padding: 1.2rem;
    }

    .mon-badge {
        display: inline-block;
        background: #fff7ed;
        color: #ff6b00;
        padding: 3px 10px;
        border-radius: 8px;
        font-size: 0.78rem;
        font-weight: 600;
        margin-bottom: 0.5rem;
    }

    .lecture-title {
        font-weight: 700;
        font-size: 1rem;
        color: #1e293b;
        margin-bottom: 0.4rem;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .lecture-desc {
        font-size: 0.85rem;
        color: #64748b;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .btn-detail {
        background: linear-gradient(135deg, #ff6b00, #ff8c00);
        color: #fff;
        border: none;
        border-radius: 10px;
        padding: 0.5rem 1.2rem;
        font-size: 0.88rem;
        font-weight: 500;
        text-decoration: none;
        display: inline-block;
        transition: opacity 0.2s;
    }

    .btn-detail:hover { opacity: 0.85; color: #fff; box-shadow: 0 4px 15px rgba(255,107,0,0.25); }

    .empty-state {
        text-align: center;
        padding: 4rem 1rem;
        color: #94a3b8;
    }

    .filter-chip {
        padding: 0.35rem 1rem;
        border-radius: 999px;
        font-size: 0.85rem;
        font-weight: 500;
        border: 2px solid transparent;
        cursor: pointer;
        text-decoration: none;
        transition: all 0.2s;
    }

    .filter-chip.active {
        background: #ff6b00;
        color: #fff;
    }

    .filter-chip:not(.active) {
        background: #f1f5f9;
        color: #475569;
    }

    .filter-chip:not(.active):hover {
        background: #e2e8f0;
        color: #1e293b;
    }
</style>

<!-- PAGE HEADER -->
<div class="page-header">
    <div class="d-flex align-items-center gap-3">
        <div style="font-size:2.5rem;">📖</div>
        <div>
            <h1 class="fw-bold mb-0" style="font-size:1.6rem;">Bài giảng trực tuyến</h1>
            <p class="mb-0 opacity-75" style="font-size:0.9rem;">
                @Model.Count bài giảng &bull; Truy cập và học mọi lúc, mọi nơi
            </p>
        </div>
    </div>
</div>

<!-- FILTER BAR -->
<div class="filter-bar">
    <!-- Search -->
    <form method="get" class="d-flex gap-2 flex-grow-1" style="min-width:220px; max-width:360px;">
        @if (selectedMon.HasValue)
        {
            <input type="hidden" name="monHocId" value="@selectedMon" />
        }
        <input type="text" name="q" value="@q"
               class="form-control" style="border-radius:10px; font-size:0.9rem;"
               placeholder="🔍 Tìm bài giảng..." />
        <button type="submit" class="btn btn-primary" style="border-radius:10px; white-space:nowrap;">Tìm</button>
    </form>

    <!-- Môn học chips -->
    <div class="d-flex gap-2 flex-wrap">
        <a href="@Url.Action("BaiGiang","HocSinh", new { q })"
           class="filter-chip @(!selectedMon.HasValue ? "active" : "")">
            Tất cả
        </a>
        @foreach (var mon in monHocs)
        {
            <a href="@Url.Action("BaiGiang","HocSinh", new { monHocId = mon.Id, q })"
               class="filter-chip @(selectedMon == mon.Id ? "active" : "")">
                @mon.TenMonHoc
            </a>
        }
    </div>

    @if (!string.IsNullOrEmpty(q) || selectedMon.HasValue)
    {
        <a href="@Url.Action("BaiGiang","HocSinh")" class="text-muted ms-auto" style="font-size:0.85rem; white-space:nowrap;">
            ✕ Xóa bộ lọc
        </a>
    }
</div>

<!-- GRID BÀI GIẢNG -->
@if (Model.Count == 0)
{
    <div class="empty-state">
        <div style="font-size:3.5rem; margin-bottom:1rem;">📭</div>
        <h5>Không có bài giảng nào</h5>
        <p>Thử thay đổi bộ lọc hoặc từ khóa tìm kiếm.</p>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var item in Model)
        {
            <div class="col-sm-6 col-lg-4">
                <div class="lecture-card">
                    <div class="lecture-thumb">
                        📝
                        <span style="position:absolute; top:10px; right:10px; background:rgba(255,255,255,0.2); color:#fff; padding:2px 8px; border-radius:6px; font-size:0.75rem;">
                            #@item.ThuTu
                        </span>
                    </div>
                    <div class="lecture-body">
                        <div class="mon-badge">@(item.MonHoc?.TenMonHoc ?? "Chung")</div>
                        <div class="lecture-title">@item.TieuDe</div>
                        @if (!string.IsNullOrEmpty(item.MoTa))
                        {
                            <div class="lecture-desc mb-3">@item.MoTa</div>
                        }
                        <div class="d-flex align-items-center justify-content-between mt-2">
                            <small class="text-muted">
                                📅 @item.NgayTao.ToString("dd/MM/yyyy")
                            </small>
                            <a href="@Url.Action("ChiTietBaiGiang","HocSinh", new { id = item.Id })"
                               class="btn-detail">
                                Xem chi tiết →
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
