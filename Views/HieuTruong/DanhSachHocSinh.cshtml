@model IEnumerable<LMS_THPT.Models.NguoiDung>
@{
    ViewData["Title"] = "Danh Sách Học Sinh";
    ViewData["PageTitle"] = "Quản lý học sinh";
    Layout = "_HieuTruongLayout";
    var danhSachLop = ViewBag.DanhSachLop as List<LMS_THPT.Models.Lop>;
    var lopId = ViewBag.LopId as int?;
    var search = ViewBag.Search as string;
}

<div class="admin-page-header">
    <div>
        <h1 class="admin-page-title">🎓 Danh Sách Học Sinh</h1>
        <div style="font-size:0.85rem; color:var(--text-muted); margin-top:4px;">
            Tra cứu thông tin học sinh theo lớp và tìm kiếm nâng cao toàn trường
        </div>
    </div>

</div>

<!-- TOOLBAR -->
<div class="admin-card" style="margin-bottom: 1.5rem;">
    <div class="admin-card-body" style="padding: 1.25rem;">
        <form method="get" asp-action="DanhSachHocSinh" style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem;">
            <div style="display: flex; gap: 0.75rem; flex: 1; min-width: 300px;">
                <div style="position: relative; flex: 1.5; display: flex; gap: 0.5rem;">
                    <div style="position: relative; flex: 1;">
                        <span style="position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: var(--text-muted); font-size: 0.9rem;">🔍</span>
                        <input type="text" name="search" value="@search" class="admin-form-control" 
                               placeholder="Tìm tên hoặc mã học sinh..." style="padding-left: 40px;" />
                    </div>
                    <button type="submit" class="admin-btn admin-btn-primary">🔍 Lọc</button>
                </div>
                <select name="lopId" class="admin-form-control" style="flex: 1;" onchange="this.form.submit()">
                    <option value="">-- Tất cả lớp --</option>
                    @if (danhSachLop != null)
                    {
                        foreach (var lop in danhSachLop)
                        {
                            <option value="@lop.Id" selected="@(lopId == lop.Id)">
                                Lớp @lop.TenLop @(lop.Khoi != null ? $"({lop.Khoi.TenKhoi})" : "")
                            </option>
                        }
                    }
                </select>
                @if (!string.IsNullOrEmpty(search) || lopId.HasValue)
                {
                    <a asp-action="DanhSachHocSinh" class="admin-btn admin-btn-secondary">✕ Xóa lọc</a>
                }
            </div>
            <div class="admin-badge admin-badge-info" style="font-size: 0.85rem; padding: 0.6rem 1.2rem;">
                Tổng số: <strong>@ViewBag.SoLuong</strong> học sinh
            </div>
        </form>
    </div>
</div>

<!-- TABLE -->
<div class="admin-card">
    <div class="admin-card-body" style="padding: 0;">
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th style="width: 60px;">#</th>
                            <th>Học Sinh</th>
                            <th>Mã Học Sinh</th>
                            <th>Giới Tính</th>
                            <th>Ngày Sinh</th>
                            <th>Lớp học</th>
                            <th>Địa Chỉ</th>
                            <th style="text-align: right;">Trạng Thái</th>
                            <th style="text-align: center;">Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int stt = 1; }
                        @foreach (var hs in Model)
                        {
                            var tenHienThi = string.IsNullOrEmpty(hs.HoTen) ? hs.UserName : hs.HoTen;
                            var avatarClaim = hs.AnhDaiDien;
                            var avatarUrl = string.IsNullOrEmpty(avatarClaim)
                                ? Url.Content("~/images/default-avatar.svg")
                                : Url.Content(avatarClaim.StartsWith("~") ? avatarClaim : "~/" + avatarClaim.TrimStart('/'));

                            <tr>
                                <td style="color:var(--text-muted); font-size:0.8rem;">@(stt++)</td>
                                <td>
                                    <div style="display: flex; align-items: center; gap: 12px;">
                                        <img src="@avatarUrl" style="width: 40px; height: 40px; border-radius: 10px; object-fit: cover; border: 1px solid var(--border);" />
                                        <div>
                                            <div style="font-weight: 700; color: var(--navy);">@tenHienThi</div>
                                            <div style="font-size: 0.75rem; color: var(--text-muted);">@hs.Email</div>
                                        </div>
                                    </div>
                                </td>
                                <td><code style="background: #f1f5f9; color: #0f172a; padding: 2px 6px; border-radius: 4px; font-size: 0.85rem; font-weight:600;">@(hs.MaHocSinh ?? "—")</code></td>
                                <td>@hs.GioiTinh</td>
                                <td style="font-size: 0.9rem;">
                                    @(hs.NgaySinh.HasValue ? hs.NgaySinh.Value.ToString("dd/MM/yyyy") : "—")
                                </td>
                                <td>
                                    @if (hs.Lop != null)
                                    {
                                        <span class="admin-badge admin-badge-info" style="font-size: 0.7rem;">Lớp @hs.Lop.TenLop</span>
                                        @if (hs.Lop.Khoi != null)
                                        {
                                            <div style="font-size: 0.7rem; color: var(--text-muted); margin-top: 2px;">@hs.Lop.Khoi.TenKhoi</div>
                                        }
                                    }
                                    else
                                    {
                                        <span style="color:var(--text-muted); font-style: italic; font-size: 0.85rem;">Chưa xếp lớp</span>
                                    }
                                </td>
                                <td style="max-width:180px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; font-size:0.9rem;" title="@hs.DiaChi">
                                    @(hs.DiaChi ?? "—")
                                </td>
                                <td style="text-align: right;">
                                    @if (hs.IsActive)
                                    {
                                        <span class="admin-badge admin-badge-success" style="font-size: 0.7rem;">● ĐANG HOẠT ĐỘNG</span>
                                    }
                                    else
                                    {
                                        <span class="admin-badge admin-badge-danger" style="font-size: 0.7rem;">● ĐÃ KHÓA</span>
                                    }
                                </td>
                                <td style="text-align: center;">
                                    <a asp-controller="QuanLyHocSinh" asp-action="XemDiemHocSinh" asp-route-hocSinhId="@hs.Id" 
                                       class="admin-btn admin-btn-sm admin-btn-secondary" title="Xem điểm học kỳ">
                                        📊 Xem điểm
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div style="padding: 4rem 2rem; text-align: center;">
                <div style="font-size: 3rem; margin-bottom: 1rem;">🎓</div>
                <h3 style="font-weight: 700; color: var(--navy);">Không tìm thấy học sinh nào</h3>
                <p style="color: var(--text-muted);">Vui lòng kiểm tra lại bộ lọc hoặc từ khóa tìm kiếm.</p>
                @if (!string.IsNullOrEmpty(search) || lopId.HasValue)
                {
                    <a asp-action="DanhSachHocSinh" class="admin-btn admin-btn-secondary mt-3">Xóa bộ lọc</a>
                }
            </div>
        }
    </div>
</div>
