@model IEnumerable<LMS_THPT.Models.YeuCauGiaoVien>
@{
    ViewData["Title"] = "Duyệt Yêu Cầu Giáo Viên";
    ViewData["PageTitle"] = "Phê duyệt yêu cầu";
    Layout = "_HieuTruongLayout";
}

<div class="admin-page-header">
    <div>
        <h1 class="admin-page-title">✉️ Duyệt Yêu Cầu Giáo Viên</h1>
        <div style="font-size:0.85rem; color:var(--text-muted); margin-top:4px;">
            Hệ thống xử lý các đề nghị, kiến nghị và báo cáo từ đội ngũ giáo viên toàn trường
        </div>
    </div>
    <div class="admin-page-actions">
        <a asp-action="Index" class="admin-btn admin-btn-secondary">← Dashboard</a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="admin-alert admin-alert-success" style="margin-bottom: 2rem;">
        <span class="admin-alert-icon">✅</span>
        <div>@TempData["Success"]</div>
    </div>
}

<div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(380px, 1fr)); gap: 1.5rem;">
    @foreach (var yc in Model)
    {
        <div class="admin-card" style="height: 100%; display: flex; flex-direction: column;">
            <div class="admin-card-header" style="justify-content: space-between; align-items: flex-start; padding-bottom: 0.75rem;">
                <div>
                    <span class="admin-badge admin-badge-secondary" style="font-size: 0.7rem; font-weight: 700;">@yc.LoaiYeuCau</span>
                    <div style="font-weight: 800; color: var(--navy); margin-top: 8px; font-size: 1.1rem; line-height: 1.3;">@yc.TieuDe</div>
                </div>
                <span class="admin-badge @(yc.TrangThai == LMS_THPT.Models.TrangThaiYeuCau.ChoDuyet ? "admin-badge-warning" : 
                                        yc.TrangThai == LMS_THPT.Models.TrangThaiYeuCau.DaDuyet ? "admin-badge-success" : "admin-badge-danger")" 
                      style="font-size: 0.65rem;">
                    @(yc.TrangThai == LMS_THPT.Models.TrangThaiYeuCau.ChoDuyet ? "CHỜ DUYỆT" : 
                      yc.TrangThai == LMS_THPT.Models.TrangThaiYeuCau.DaDuyet ? "ĐÃ DUYỆT" : "TỪ CHỐI")
                </span>
            </div>

            <div class="admin-card-body" style="flex: 1; padding-top: 0.5rem;">
                <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 1.25rem; padding: 0.75rem; background: #f8fafc; border-radius: 10px;">
                    <div style="width: 36px; height: 36px; background: var(--navy); color: white; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-weight: 800;">
                        @(yc.GiaoVien?.HoTen?.Substring(0, 1).ToUpper() ?? "G")
                    </div>
                    <div>
                        <div style="font-weight: 700; font-size: 0.9rem; color: var(--navy);">@yc.GiaoVien?.HoTen</div>
                        <div style="font-size: 0.75rem; color: var(--text-muted);">Mã GV: @yc.MaGiaoVien</div>
                    </div>
                </div>

                <div style="font-size: 0.92rem; color: var(--text-primary); line-height: 1.6; padding: 1rem; background: #fff; border: 1px dashed var(--border); border-radius: 12px; margin-bottom: 1rem;">
                    @yc.NoiDung
                </div>

                @if (!string.IsNullOrEmpty(yc.GhiChuAdmin))
                {
                    <div style="font-size: 0.85rem; color: #6366f1; background: #eef2ff; padding: 0.75rem; border-radius: 10px; margin-top: 0.5rem;">
                        <span style="font-weight: 700;">💬 Phản hồi HT:</span> @yc.GhiChuAdmin
                    </div>
                }
            </div>

            <div class="admin-card-footer" style="justify-content: space-between; align-items: center; border-top: 1px solid var(--border);">
                <span style="font-size: 0.8rem; color: var(--text-muted); font-weight: 500;">📅 @yc.NgayGui.ToString("dd/MM/yyyy HH:mm")</span>
                
                @if (yc.TrangThai == LMS_THPT.Models.TrangThaiYeuCau.ChoDuyet)
                {
                    <div style="display: flex; gap: 8px;">
                        <button class="admin-btn admin-btn-sm admin-btn-primary" onclick="openReviewModal(@yc.Id, 'DaDuyet')">Duyệt</button>
                        <button class="admin-btn admin-btn-sm admin-btn-secondary" style="border-color: #ef4444; color: #ef4444;" onclick="openReviewModal(@yc.Id, 'TuChoi')">Từ chối</button>
                    </div>
                }
            </div>
        </div>
    }
</div>

<!-- Modal xử lý hiện đại -->
<div id="reviewModal" style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(15, 23, 42, 0.6); backdrop-filter: blur(4px); display: none; align-items: center; justify-content: center; z-index: 9999; padding: 1.5rem;">
    <div class="admin-card" style="width: 100%; max-width: 500px; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);">
        <div class="admin-card-header">
            <h3 id="modalTitle" style="font-weight: 800; font-size: 1.25rem;">Xử lý yêu cầu</h3>
        </div>
        <div class="admin-card-body">
            <form asp-action="XuLyYeuCau" method="post" id="reviewForm">
                @Html.AntiForgeryToken()
                <input type="hidden" id="modalYcId" name="id" />
                <input type="hidden" id="modalTrangThai" name="trangThai" />
                
                <div class="admin-form-group">
                    <label class="admin-form-label" style="font-weight: 700; margin-bottom: 0.5rem;">Ghi chú / Lý do phản hồi:</label>
                    <textarea name="ghiChu" class="admin-form-control" rows="4" placeholder="Nhập ghi chú hoặc lý do từ chối để giáo viên nắm rõ..."></textarea>
                </div>
                
                <div style="display: flex; gap: 10px; justify-content: flex-end; margin-top: 1.5rem;">
                    <button type="button" class="admin-btn admin-btn-secondary" onclick="closeReviewModal()">Hủy bỏ</button>
                    <button type="submit" id="modalSubmitBtn" class="admin-btn admin-btn-primary">Xác nhận xử lý</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function openReviewModal(id, status) {
        document.getElementById('modalYcId').value = id;
        document.getElementById('modalTrangThai').value = status;
        document.getElementById('modalTitle').innerText = status === 'DaDuyet' ? '✅ Phê duyệt yêu cầu' : '❌ Từ chối yêu cầu';
        
        const submitBtn = document.getElementById('modalSubmitBtn');
        if(status === 'DaDuyet') {
            submitBtn.className = 'admin-btn admin-btn-primary';
            submitBtn.innerText = 'Chấp nhận ngay';
        } else {
            submitBtn.className = 'admin-btn admin-btn-danger';
            submitBtn.style.backgroundColor = '#ef4444';
            submitBtn.style.borderColor = '#ef4444';
            submitBtn.innerText = 'Từ chối yêu cầu';
        }
        
        document.getElementById('reviewModal').style.display = 'flex';
    }

    function closeReviewModal() {
        document.getElementById('reviewModal').style.display = 'none';
    }

    window.onclick = function(event) {
        const modal = document.getElementById('reviewModal');
        if (event.target == modal) {
            closeReviewModal();
        }
    }
</script>
