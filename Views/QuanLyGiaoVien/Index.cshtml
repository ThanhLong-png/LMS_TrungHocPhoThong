@model IEnumerable<dynamic>
@{
    ViewData["Title"] = "Quản lý Giáo viên";
    Layout = "_AdminLayout";
}

@section Styles {
<style>
    .gv-search-bar {
        display: flex; gap: 10px; align-items: center; flex-wrap: wrap;
        background: #fff; border: 1px solid var(--admin-border);
        border-radius: var(--admin-radius); padding: 1rem 1.25rem;
        margin-bottom: 1.25rem;
    }
    .gv-search-bar input {
        flex: 1; min-width: 200px;
        padding: 0.5rem 0.9rem;
        border: 1.5px solid var(--admin-border); border-radius: 8px;
        font-size: 0.9rem; font-family: inherit; outline: none;
        transition: border-color 0.18s;
    }
    .gv-search-bar input:focus { border-color: var(--admin-accent); }

    .badge-gv { padding: 4px 10px; border-radius: 6px; font-size: 11px; font-weight: 700; color: #fff; }
    .bg-nam { background: #2563eb; }
    .bg-nu  { background: #db2777; }

    .row-k10 td:first-child { border-left: 3px solid #6366f1; }
    .row-k11 td:first-child { border-left: 3px solid #22c55e; }
    .row-k12 td:first-child { border-left: 3px solid #ef4444; }

    .modal-overlay {
        display: none; position: fixed; inset: 0;
        background: rgba(26,31,54,0.55); z-index: 1000;
        align-items: flex-start; justify-content: center;
        padding: 15px; backdrop-filter: blur(4px);
        overflow-y: auto;
    }
    .modal-box {
        background: #fff; width: 100%; max-width: 680px;
        border-radius: var(--admin-radius); overflow: hidden;
        box-shadow: 0 20px 60px rgba(0,0,0,0.2);
    }
    .modal-header-custom {
        background: linear-gradient(135deg, var(--admin-navy), #252d4a);
        color: #fff; padding: 1.2rem 1.5rem;
        display: flex; justify-content: space-between; align-items: center;
    }
    .modal-header-custom h5 { margin: 0; font-weight: 700; font-size: 1rem; }
    .modal-body-custom { padding: 1.5rem; }
    .modal-footer-custom {
        padding: 1rem 1.5rem; border-top: 1px solid var(--admin-border);
        display: flex; justify-content: flex-end; gap: 0.75rem;
    }
    .modal-close-btn {
        background: none; border: none; color: rgba(255,255,255,0.7);
        font-size: 1.3rem; cursor: pointer; line-height: 1; padding: 0;
    }
    .modal-close-btn:hover { color: #fff; }
    .form-row-2 { display: flex; gap: 1rem; }
    .form-row-2 > * { flex: 1; }
</style>
}

<div class="admin-page-header">
    <div>
        <h1 class="admin-page-title">👨‍🏫 Hệ thống Giáo viên</h1>
        <div style="font-size:0.85rem; color:var(--admin-text-muted); margin-top:4px;">
            Tổng số: <strong>@ViewBag.SoLuong</strong> giáo viên
        </div>
    </div>
    <div class="admin-page-actions">
        <a asp-action="TaoGiaoVien" class="admin-btn admin-btn-primary">+ Thêm giáo viên mới</a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="admin-alert admin-alert-success">
        <span class="admin-alert-icon">✅</span> @TempData["Success"]
    </div>
}

<div class="gv-search-bar">
    <form method="get" asp-action="Index" style="display:flex; gap:8px; width:100%; align-items:center;">
        <input type="text" name="search" value="@ViewBag.Search" placeholder="🔍 Tìm giáo viên theo tên..." />
        <button type="submit" class="admin-btn admin-btn-primary">Tìm kiếm</button>
        @if (!string.IsNullOrEmpty(ViewBag.Search as string))
        {
            <a asp-action="Index" class="admin-btn admin-btn-secondary">✖ Xóa</a>
        }
    </form>
</div>

<div class="admin-card">
    <div class="admin-card-body" style="padding:0;">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Mã số</th>
                    <th>Họ và Tên</th>
                    <th>Giới tính</th>
                    <th>Chuyên môn</th>
                    <th>Chủ nhiệm</th>
                    <th>Chức vụ</th>
                    <th>Ngày sinh</th>
                    <th style="text-align:center;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    var tenKhoi = item.TenKhoi as string ?? "";
                    string kClass = tenKhoi.Contains("10") ? "row-k10"
                                    : tenKhoi.Contains("11") ? "row-k11"
                                    : tenKhoi.Contains("12") ? "row-k12"
                                    : "";
                    var gioiTinh = item.User.GioiTinh ?? "";

                    <tr class="@kClass">
                        <td style="font-weight:700; color:var(--admin-accent);">@item.User.UserName</td>
                        <td style="font-weight:600;">@item.User.HoTen</td>
                        <td>
                            <span class="badge-gv @(gioiTinh == "Nam" ? "bg-nam" : "bg-nu")">
                                @(string.IsNullOrEmpty(gioiTinh) ? "---" : gioiTinh)
                            </span>
                        </td>
                        <td>
                            @{
                                var monList = item.MonPhanCong as IEnumerable<string>;
                                if (monList != null && monList.Any())
                                {
                                    <span>@string.Join(", ", monList)</span>
                                }
                                else
                                {
                                    @(item.User.ChuyenMon ?? "---")
                                }
                            }
                        </td>
                        <td>
                            <strong>@item.TenLop</strong><br />
                            <small style="color:var(--admin-text-muted);">@item.TenKhoi</small>
                        </td>
                        <td>@(item.User.ChucVu ?? "---")</td>
                        <td style="color:var(--admin-text-muted); font-size:0.85rem;">
                            @(item.User.NgaySinh?.ToString("dd/MM/yyyy") ?? "---")
                        </td>
                        <td style="text-align:center;">
                            <div style="display:inline-flex; gap:4px; flex-wrap:wrap; justify-content:center;">
                                <button class="admin-btn admin-btn-secondary admin-btn-sm"
                                        onclick="openEditModal('@item.User.Id')">Sửa</button>

                                <form asp-action="XoaGiaoVien" method="post" style="display:inline;"
                                      onsubmit="return confirm('Xóa giáo viên này?')">
                                    <input type="hidden" name="id" value="@item.User.Id" />
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="admin-btn admin-btn-danger admin-btn-sm">Xóa</button>
                                </form>

                                <form asp-action="ToggleActive" method="post" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.User.Id" />
                                    <button type="submit" class="admin-btn admin-btn-sm"
                                            style="background:@(item.User.IsActive ? "#fef2f2" : "#f0fdf4");
                                                   color:@(item.User.IsActive ? "#dc2626" : "#16a34a");
                                                   border:1px solid @(item.User.IsActive ? "#fecaca" : "#bbf7d0");">
                                        @(item.User.IsActive ? "Khóa" : "Kích hoạt")
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- MODAL SỬA GIÁO VIÊN -->
<div id="modalSua" class="modal-overlay">
    <div class="modal-box">
        <div class="modal-header-custom">
            <h5>✏️ Chỉnh sửa Giáo viên</h5>
            <button type="button" class="modal-close-btn" onclick="closeEditModal()">✕</button>
        </div>
        <form asp-action="SuaGiaoVien" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" id="edit-id" />
            <div class="modal-body-custom">
                <div class="admin-form-group">
                    <label class="admin-form-label">Họ và tên</label>
                    <input type="text" name="hoTen" id="edit-hoTen" class="admin-form-control" required />
                </div>
                <div class="form-row-2">
                    <div class="admin-form-group">
                        <label class="admin-form-label">Giới tính</label>
                        <select name="gioiTinh" id="edit-gioiTinh" class="admin-form-control">
                            <option value="Nam">Nam</option>
                            <option value="Nữ">Nữ</option>
                        </select>
                    </div>
                    <div class="admin-form-group">
                        <label class="admin-form-label">Ngày sinh</label>
                        <input type="date" name="ngaySinh" id="edit-ngaySinh" class="admin-form-control" />
                    </div>
                </div>
                <div class="form-row-2">
                    <div class="admin-form-group">
                        <label class="admin-form-label">Chức vụ</label>
                        <select name="chucVu" id="edit-chucVu" class="admin-form-control">
                            <option value="Giáo viên">Giáo viên</option>
                            <option value="Tổ trưởng">Tổ trưởng</option>
                            <option value="Ban giám hiệu">Ban giám hiệu</option>
                        </select>
                    </div>
                    <div class="admin-form-group">
                        <label class="admin-form-label">Phân công lớp chủ nhiệm</label>
                        <select name="lopId" id="edit-lopId" class="admin-form-control">
                            <option value="">-- Không phân công chủ nhiệm --</option>
                            @foreach (var l in ViewBag.TatCaLop)
                            {
                                <option value="@l.Id">Lớp @l.TenLop (Khối @l.MaKhoi)</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="admin-form-group">
                    <label class="admin-form-label">Chọn môn phân công (theo khối)</label>
                    <div id="editMonHocCheckboxList"
                         style="border:1.5px solid var(--admin-border); border-radius:10px;
                                max-height:200px; overflow-y:auto; padding:0.5rem 0.75rem;
                                background:#fff; display:flex; flex-direction:column; gap:0.25rem;">
                        @{
                            var allMon = ViewBag.TatCaMonHoc as IEnumerable<dynamic>;
                            if (allMon != null)
                            {
                                var grouped = allMon.GroupBy(m => (string)(m.Khoi?.TenKhoi ?? "Khác"));
                                foreach (var grp in grouped)
                                {
                                    <div style="padding:0.4rem 0 0.2rem; font-size:0.72rem; font-weight:700;
                                                color:var(--admin-text-muted); text-transform:uppercase;
                                                letter-spacing:0.06em; border-bottom:1px solid var(--admin-border);
                                                margin-bottom:0.25rem;">
                                        @grp.Key
                                    </div>
                                    foreach (var m in grp)
                                    {
                                        <label style="display:flex; align-items:center; gap:0.6rem;
                                                      padding:0.35rem 0.5rem; border-radius:7px; cursor:pointer;
                                                      transition:background 0.15s;"
                                               onmouseover="this.style.background='var(--admin-surface)';"
                                               onmouseout="this.style.background='';">
                                            <input type="checkbox" name="monHocIds" value="@m.Id" class="edit-mon-checkbox"
                                                   style="width:15px; height:15px; accent-color:var(--admin-accent);
                                                          cursor:pointer; flex-shrink:0;" />
                                            <span style="font-size:0.88rem; font-weight:500; color:var(--admin-text-primary);">
                                                @m.TenMonHoc
                                            </span>
                                        </label>
                                    }
                                }
                            }
                            else
                            {
                                <div style="padding:1rem; color:var(--admin-text-muted); font-size:0.85rem; text-align:center;">
                                    Chưa có môn học nào
                                </div>
                            }
                        }
                    </div>
                    <div style="display:flex; align-items:center; justify-content:space-between; margin-top:6px;">
                        <div style="font-size:0.78rem; color:var(--admin-text-muted);">
                            Tích chọn các môn muốn phân công cho giáo viên này
                        </div>
                        <div style="display:flex; gap:8px;">
                            <button type="button" onclick="selectEditAllMon(true)"
                                    style="font-size:0.75rem; color:var(--admin-accent); background:none;
                                           border:none; cursor:pointer; padding:0; font-weight:600;">Chọn tất cả</button>
                            <span style="color:var(--admin-border);">|</span>
                            <button type="button" onclick="selectEditAllMon(false)"
                                    style="font-size:0.75rem; color:var(--admin-text-muted); background:none;
                                           border:none; cursor:pointer; padding:0; font-weight:600;">Bỏ chọn</button>
                        </div>
                    </div>
                </div>
                <div class="admin-form-group">
                    <label class="admin-form-label">Địa chỉ</label>
                    <input type="text" name="diaChi" id="edit-diaChi" class="admin-form-control"
                           placeholder="Nhập địa chỉ liên hệ" />
                </div>
                <div class="form-row-2">
                    <div class="admin-form-group">
                        <label class="admin-form-label">Mật khẩu mới</label>
                        <input type="password" name="matKhauMoi" id="edit-matKhau" class="admin-form-control"
                               placeholder="Nhập mật khẩu mới" />
                    </div>
                    <div class="admin-form-group">
                        <label class="admin-form-label">Xác nhận mật khẩu</label>
                        <input type="password" name="xacNhanMatKhau" id="edit-xacNhanMatKhau" class="admin-form-control"
                               placeholder="Nhập lại mật khẩu mới" />
                    </div>
                </div>
            </div>
            <div class="modal-footer-custom">
                <button type="button" onclick="closeEditModal()" class="admin-btn admin-btn-secondary">Hủy</button>
                <button type="submit" class="admin-btn admin-btn-primary">Cập nhật</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
    function openEditModal(id) {
        // Reset all checkboxes first
        document.querySelectorAll('.edit-mon-checkbox').forEach(cb => cb.checked = false);

        fetch(`/QuanLyGiaoVien/GetGiaoVien/${id}`)
            .then(res => res.json())
            .then(data => {
                document.getElementById('edit-id').value        = data.id;
                document.getElementById('edit-hoTen').value     = data.hoTen;
                document.getElementById('edit-gioiTinh').value  = data.gioiTinh;
                document.getElementById('edit-chucVu').value    = data.chucVu;
                document.getElementById('edit-ngaySinh').value  = data.ngaySinh || '';
                document.getElementById('edit-diaChi').value    = data.diaChi || '';
                document.getElementById('edit-lopId').value     = data.maLop || '';
                document.getElementById('edit-matKhau').value   = '';
                document.getElementById('edit-xacNhanMatKhau').value = '';

                // Tick assigned subjects
                if (data.monHocIds && data.monHocIds.length > 0) {
                    data.monHocIds.forEach(mhId => {
                        const cb = document.querySelector(`.edit-mon-checkbox[value="${mhId}"]`);
                        if (cb) cb.checked = true;
                    });
                }

                document.getElementById('modalSua').style.display = 'flex';
            });
    }
    function selectEditAllMon(checked) {
        document.querySelectorAll('.edit-mon-checkbox').forEach(cb => cb.checked = checked);
    }
    function closeEditModal() {
        document.getElementById('modalSua').style.display = 'none';
    }
    document.getElementById('modalSua').addEventListener('click', function(e) {
        if (e.target === this) closeEditModal();
    });
</script>
}