@model LMS_THPT.Models.NguoiDung
@{
    ViewData["Title"] = "Thêm giáo viên mới";
    Layout = "_AdminLayout";
}


<div style="max-width: 820px; margin: 0 auto;">
    <div class="admin-card">
        <div class="admin-card-header">
            <h3>👨‍🏫 Thêm Giáo viên mới</h3>
        </div>
        <div class="admin-card-body">
            @if (TempData["Error"] != null)
            {
                <div class="admin-alert admin-alert-danger">
                    <span class="admin-alert-icon">⚠️</span> @TempData["Error"]
                </div>
            }

            <form asp-action="TaoGiaoVien" method="post">
                @Html.AntiForgeryToken()

                <div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem;">
                    <div class="admin-form-group">
                        <label class="admin-form-label">Mã giáo viên</label>
                        <div style="display:flex; align-items:center; gap:10px;">
                            <input type="text" class="admin-form-control"
                                   value="@ViewBag.MaGVPreview" readonly
                                   style="background:#f8fafc; font-weight:700; font-size:1rem; letter-spacing:1px; cursor:default;" />
                            <span style="font-size:0.78rem; color:var(--admin-text-muted); white-space:nowrap;">🔒 Tự động</span>
                        </div>
                        <div style="font-size:0.78rem; color:var(--admin-text-muted); margin-top:5px;">
                            Mã tạo tự động: GV0001, GV0002...
                        </div>
                    </div>
                    <div class="admin-form-group">
                        <label class="admin-form-label">Mật khẩu mặc định</label>
                        <input type="text" class="admin-form-control" readonly
                               value="@ViewBag.MaGVPreview"
                               style="background:#f8fafc; color:var(--admin-text-muted);" />
                        <div style="font-size:0.78rem; color:var(--admin-text-muted); margin-top:5px;">
                            Mật khẩu mặc định = Mã giáo viên
                        </div>
                    </div>
                </div>

                <div class="admin-form-group">
                    <label class="admin-form-label">Họ và tên</label>
                    <input name="hoTen" class="admin-form-control" required placeholder="Nhập họ tên đầy đủ" />
                </div>

                <div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem;">
                    <div class="admin-form-group">
                        <label class="admin-form-label">Chức vụ</label>
                        <select name="chucVu" class="admin-form-control">
                            <option value="Giáo viên">Giáo viên</option>
                            <option value="Tổ trưởng">Tổ trưởng</option>
                            <option value="Ban giám hiệu">Ban giám hiệu</option>
                        </select>
                    </div>
                    <div class="admin-form-group">
                        <label class="admin-form-label">Phân công lớp chủ nhiệm</label>
                        <select name="lopId" class="admin-form-control">
                            <option value="">-- Không phân công --</option>
                            @foreach (var lop in (ViewBag.LopTrong ?? new List<dynamic>()))
                            {
                                <option value="@lop.Id">Lớp @lop.TenLop</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="admin-form-group">
                    <label class="admin-form-label">Chọn môn phân công (theo khối)</label>
                    <div id="monHocCheckboxList"
                         style="border:1.5px solid var(--admin-border); border-radius:10px;
                                max-height:260px; overflow-y:auto; padding:0.5rem 0.75rem;
                                background:#fff; display:flex; flex-direction:column; gap:0.25rem;">
                        @{
                            var allMon = ViewBag.TatCaMonHoc as IEnumerable<dynamic>;
                            if (allMon != null)
                            {
                                var grouped = allMon.GroupBy(m => (string)(m.Khoi?.TenKhoi ?? "Khác"));
                                foreach (var grp in grouped)
                                {
                                    <div style="padding:0.4rem 0 0.2rem; font-size:0.72rem; font-weight:700;
                                                color:var(--admin-text-muted); text-transform:uppercase;
                                                letter-spacing:0.06em; border-bottom:1px solid var(--admin-border);
                                                margin-bottom:0.25rem;">
                                        @grp.Key
                                    </div>
                                    foreach (var m in grp)
                                    {
                                        <label style="display:flex; align-items:center; gap:0.6rem;
                                                      padding:0.35rem 0.5rem; border-radius:7px; cursor:pointer;
                                                      transition:background 0.15s;"
                                               onmouseover="this.style.background='var(--admin-surface)';"
                                               onmouseout="this.style.background='';">
                                            <input type="checkbox" name="monHocIds" value="@m.Id"
                                                   style="width:15px; height:15px; accent-color:var(--admin-accent);
                                                          cursor:pointer; flex-shrink:0;" />
                                            <span style="font-size:0.88rem; font-weight:500; color:var(--admin-text-primary);">
                                                @m.TenMonHoc
                                            </span>
                                        </label>
                                    }
                                }
                            }
                            else
                            {
                                <div style="padding:1rem; color:var(--admin-text-muted); font-size:0.85rem; text-align:center;">
                                    Chưa có môn học nào
                                </div>
                            }
                        }
                    </div>
                    <div style="display:flex; align-items:center; justify-content:space-between; margin-top:6px;">
                        <div style="font-size:0.78rem; color:var(--admin-text-muted);">
                            Tích chọn các môn muốn phân công cho giáo viên này
                        </div>
                        <div style="display:flex; gap:8px;">
                            <button type="button" onclick="selectAllMon(true)"
                                    style="font-size:0.75rem; color:var(--admin-accent); background:none;
                                           border:none; cursor:pointer; padding:0; font-weight:600;">Chọn tất cả</button>
                            <span style="color:var(--admin-border);">|</span>
                            <button type="button" onclick="selectAllMon(false)"
                                    style="font-size:0.75rem; color:var(--admin-text-muted); background:none;
                                           border:none; cursor:pointer; padding:0; font-weight:600;">Bỏ chọn</button>
                        </div>
                    </div>
                </div>

                <div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem;">
                    <div class="admin-form-group">
                        <label class="admin-form-label">Giới tính</label>
                        <select name="gioiTinh" class="admin-form-control">
                            <option value="Nam">Nam</option>
                            <option value="Nữ">Nữ</option>
                        </select>
                    </div>
                    <div class="admin-form-group">
                        <label class="admin-form-label">Ngày sinh</label>
                        <input name="ngaySinh" type="date" class="admin-form-control" />
                    </div>
                </div>

                <div class="admin-form-group">
                    <label class="admin-form-label">Địa chỉ</label>
                    <input name="diaChi" class="admin-form-control" placeholder="Nhập địa chỉ liên hệ" />
                </div>

                <div class="admin-card-footer" style="padding:0; background:none; border:none; margin-top:1.5rem; justify-content:flex-start; gap:0.75rem;">
                    <button type="submit" class="admin-btn admin-btn-primary">Lưu giáo viên</button>
                    <a asp-action="Index" class="admin-btn admin-btn-secondary">Hủy</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function selectAllMon(checked) {
        document.querySelectorAll('#monHocCheckboxList input[type="checkbox"]')
                .forEach(cb => cb.checked = checked);
    }
</script>
}