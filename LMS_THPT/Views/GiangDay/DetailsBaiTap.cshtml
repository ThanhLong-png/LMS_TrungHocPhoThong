@model LMS_THPT.Models.BaiTap
@{
    ViewData["Title"] = "Chi tiết bài tập";
}

<div class="card p-3">
    <h3>@Model.TieuDe</h3>
    <div class="text-muted">@Model.NgayTao.ToString("g") · Môn: @Model.MonHoc?.TenMonHoc</div>
    <hr />
    <div>@Html.Raw(Model.MoTa ?? "")</div>

    <div style="margin-top:12px;">Hạn nộp: <strong>@Model.HanNop.ToString("g")</strong></div>

    <div style="margin-top:16px;">
        <a asp-action="Index" asp-route-monHocId="@Model.MonHocId" asp-route-lopId="@ViewBag.LopId" class="btn-outline-soft">Quay lại</a>
        @if (User.IsInRole("GiaoVien") || User.IsInRole("Admin"))
        {
            <a asp-action="Submissions" asp-route-baiTapId="@Model.Id" asp-route-lopId="@ViewBag.LopId" class="btn-primary-soft" style="margin-left:8px;">Xem nộp bài</a>
        }
    </div>
</div>