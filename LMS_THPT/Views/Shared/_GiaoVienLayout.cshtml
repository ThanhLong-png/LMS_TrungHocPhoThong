<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LMS Quốc Học</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/teacher-dashboard.css" asp-append-version="true" />

    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        :root {
            --sidebar-w: 68px;
            --topnav-h: 56px;
            --navy: #1a1f36;
            --navy-hover: #252d4a;
            --accent: #6366f1;
            --accent-light: #818cf8;
            --surface: #f4f5f7;
            --white: #ffffff;
            --text-primary: #1e293b;
            --text-muted: #64748b;
            --border: #e2e8f0;
            --radius: 12px;
            --transition: 0.18s ease;
        }

        html, body {
            height: 100%;
            font-family: 'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            background: var(--surface);
            color: var(--text-primary);
            margin-bottom: 0 !important;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
            text-rendering: optimizeLegibility;
        }

        /* ===== TOP NAV ===== */
        .gv-topnav {
            position: fixed;
            top: 0; left: 0; right: 0;
            height: var(--topnav-h);
            background: var(--navy);
            display: flex;
            align-items: center;
            padding: 0 1.2rem 0 calc(var(--sidebar-w) + 1rem);
            z-index: 200;
            box-shadow: 0 1px 0 rgba(255,255,255,0.06);
            gap: 1rem;
        }

        .gv-topnav-logo {
            color: #fff;
            font-weight: 700;
            font-size: 1rem;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            letter-spacing: -0.02em;
        }

        .gv-topnav-logo span { opacity: 0.85; }

        .gv-page-title {
            font-size: 0.9rem;
            font-weight: 500;
            color: rgba(255,255,255,0.6);
            margin-left: 0.5rem;
            padding-left: 1rem;
            border-left: 1px solid rgba(255,255,255,0.15);
        }

        .gv-topnav-right {
            margin-left: auto;
            display: flex;
            align-items: center;
            gap: 0.8rem;
        }

        .gv-user-btn {
            display: flex;
            align-items: center;
            gap: 0.6rem;
            background: rgba(255,255,255,0.1);
            color: #fff;
            text-decoration: none;
            font-size: 0.88rem;
            font-weight: 500;
            padding: 0.3rem 0.7rem;
            border-radius: 999px;
            transition: background var(--transition);
        }

        .gv-user-btn:hover { background: white; color: #000000; }

        .gv-avatar {
            width: 32px; height: 32px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid rgba(255,255,255,0.3);
            transition: opacity var(--transition);
        }

        .gv-user-btn:hover .gv-avatar {
            opacity: 0.8;
        }

        .gv-logout-btn {
            background: rgba(255,255,255,0.08);
            color: rgba(255,255,255,0.75);
            border: 1px solid rgba(255,255,255,0.12);
            border-radius: 8px;
            padding: 0.35rem 0.85rem;
            font-size: 0.82rem;
            font-weight: 500;
            cursor: pointer;
            transition: all var(--transition);
            display: flex;
            align-items: center;
            gap: 0.4rem;
        }

        .gv-logout-btn:hover {
            background: rgba(255,255,255,0.16);
            color: #fff;
            border-color: rgba(255,255,255,0.25);
        }

        /* ===== SIDEBAR ===== */
        .gv-sidebar {
            position: fixed;
            top: var(--topnav-h);
            left: 0;
            bottom: 0;
            width: var(--sidebar-w);
            background: var(--navy);
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 0.8rem 0;
            z-index: 150;
            border-right: 1px solid rgba(255,255,255,0.06);
        }

        .gv-sidenav {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 0.2rem;
            width: 100%;
            flex: 1;
        }

        .gv-nav-item {
            position: relative;
            width: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 0.65rem 0.5rem;
            color: rgba(255,255,255,0.55);
            text-decoration: none;
            font-size: 0.65rem;
            font-weight: 600;
            letter-spacing: 0.02em;
            gap: 0.25rem;
            cursor: pointer;
            transition: color var(--transition);
            border-radius: 0;
        }

        .gv-nav-item:hover { color: rgba(255,255,255,0.9); }
        .gv-nav-item.active { color: #fff; }

        .gv-nav-item.active::before {
            content: '';
            position: absolute;
            left: 0; top: 20%; bottom: 20%;
            width: 3px;
            background: var(--accent-light);
            border-radius: 0 3px 3px 0;
        }

        .gv-nav-icon {
            width: 38px; height: 38px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
            transition: background var(--transition), transform var(--transition);
            background: transparent;
        }

        .gv-nav-item:hover .gv-nav-icon { background: rgba(255,255,255,0.1); transform: scale(1.05); }
        .gv-nav-item.active .gv-nav-icon { background: rgba(99,102,241,0.3); }

        .gv-nav-label {
            font-size: 0.60rem;
            font-weight: 600;
            letter-spacing: 0;
            text-align: center;
            line-height: 1.1;
        }

        .gv-nav-divider {
            width: 36px;
            height: 1px;
            background: rgba(255,255,255,0.1);
            margin: 0.4rem 0;
        }

        /* Sidebar footer profile */
        .gv-sidebar-footer {
            width: 100%;
            border-top: 1px solid rgba(255,255,255,0.08);
            padding: 0.6rem 0;
            position: relative;
        }

        .gv-profile-btn {
            width: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 0.5rem;
            cursor: pointer;
            gap: 0.3rem;
            color: rgba(255,255,255,0.55);
            font-size: 0.60rem;
            font-weight: 600;
            transition: color var(--transition);
            text-decoration: none;
        }

        .gv-profile-btn:hover { color: rgba(255,255,255,0.9); }

        .gv-profile-avatar {
            width: 34px; height: 34px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid rgba(255,255,255,0.2);
            transition: border-color var(--transition);
        }

        .gv-profile-btn:hover .gv-profile-avatar { border-color: rgba(99,102,241,0.6); }

        /* Profile dropdown */
        .gv-profile-dropdown {
            position: fixed;
            right: 1.2rem;
            top: calc(var(--topnav-h) + 8px);
            z-index: 9999;
            background: var(--white);
            border-radius: 12px;
            border: 1px solid var(--border);
            box-shadow: 0 8px 30px rgba(0,0,0,0.14);
            min-width: 200px;
            padding: 0.5rem;
            display: none;
            animation: dropFadeIn 0.18s ease;
        }

        .gv-profile-dropdown.show { display: block; }

        @@keyframes dropFadeIn {
            from { opacity: 0; transform: translateY(-8px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        .gv-profile-header {
            display: flex;
            align-items: center;
            gap: 0.6rem;
            padding: 0.6rem 0.8rem 0.8rem;
            border-bottom: 1px solid var(--border);
            margin-bottom: 0.4rem;
        }

        .gv-profile-header img {
            width: 38px; height: 38px;
            border-radius: 50%; object-fit: cover;
            border: 2px solid var(--border);
        }

        .gv-profile-info .name {
            font-size: 0.85rem;
            font-weight: 600;
            color: var(--text-primary);
        }

        .gv-profile-info .role {
            font-size: 0.75rem;
            color: var(--text-muted);
        }

        .gv-dd-item {
            display: flex;
            align-items: center;
            gap: 0.6rem;
            padding: 0.5rem 0.8rem;
            border-radius: 8px;
            font-size: 0.85rem;
            color: var(--text-primary);
            text-decoration: none;
            transition: background var(--transition);
            cursor: pointer;
            width: 100%;
            border: none;
            background: none;
            text-align: left;
            font-family: inherit;
        }

        .gv-dd-item:hover { background: var(--surface); color: var(--text-primary); }
        .gv-dd-item.danger { color: #ef4444; }
        .gv-dd-item.danger:hover { background: #fef2f2; }

        .gv-dd-sep {
            height: 1px;
            background: var(--border);
            margin: 0.4rem 0;
        }

        /* ===== MAIN CONTENT ===== */
        .gv-content {
            margin-left: var(--sidebar-w);
            margin-top: var(--topnav-h);
            min-height: calc(100vh - var(--topnav-h));
            padding: 1.8rem 2rem;
        }

        @@media (max-width: 768px) {
            .gv-content { padding: 1rem; }
            .gv-nav-label { display: none; }
            .gv-nav-icon { width: 34px; height: 34px; font-size: 1rem; }
            .gv-page-title { display: none; }
        }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    @{
        var avatarClaim = User.Claims.FirstOrDefault(c => c.Type == "AnhDaiDien")?.Value;
        var avatarUrl = string.IsNullOrEmpty(avatarClaim)
            ? Url.Content("~/images/default-avatar.svg")
            : Url.Content(avatarClaim.StartsWith("~") ? avatarClaim : "~/" + avatarClaim.TrimStart('/'));

        var activePage = ViewData["ActivePage"]?.ToString() ?? "";
    }

    <!-- ===== TOP NAV ===== -->
    <nav class="gv-topnav">
        <a asp-area="GiaoVien" asp-controller="GiaoVien" asp-action="Index" class="gv-topnav-logo">
            LMS Quốc Học
        </a>
        @if (!string.IsNullOrEmpty(ViewData["PageTitle"]?.ToString()))
        {
            <span class="gv-page-title">@ViewData["PageTitle"]</span>
        }

        <div class="gv-topnav-right">
            @await RenderSectionAsync("TopbarAction", required: false)

            <button type="button" class="gv-user-btn" onclick="toggleProfileDropdown(event)">
                <img src="@avatarUrl" class="gv-avatar" alt="avatar" />
                <span class="d-none d-md-inline">@User.Identity!.Name</span>
            </button>

            <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                @Html.AntiForgeryToken()
                <button type="submit" class="gv-logout-btn">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                    <span class="d-none d-sm-inline">Đăng xuất</span>
                </button>
            </form>
        </div>
    </nav>

    <!-- ===== SIDEBAR ===== -->
    <aside class="gv-sidebar">
        <nav class="gv-sidenav">

            <!-- Tổng quan -->
            <a asp-area="GiaoVien" asp-controller="GiaoVien" asp-action="Index"
               class="gv-nav-item @(activePage == "Dashboard" ? "active" : "")">
                <div class="gv-nav-icon">🏠</div>
                <span class="gv-nav-label">Tổng quan</span>
            </a>

            <!-- Lớp chủ nhiệm -->
            <a asp-area="GiaoVien" asp-controller="GiaoVien" asp-action="LopChuNhiem"
               class="gv-nav-item @(activePage == "LopChuNhiem" ? "active" : "")">
                <div class="gv-nav-icon">👥</div>
                <span class="gv-nav-label">Chủ nhiệm</span>
            </a>

            <div class="gv-nav-divider"></div>

            <!-- Lớp học -->
            <a asp-area="GiaoVien" asp-controller="GiangDay" asp-action="Index"
               class="gv-nav-item @(activePage == "GiangDay" ? "active" : "")">
                <div class="gv-nav-icon">📚</div>
                <span class="gv-nav-label">Lớp học</span>
            </a>

            <!-- Bài tập -->
            <a asp-area="GiaoVien" asp-controller="GiaoVien" asp-action="QuanLyBaiTap"
               class="gv-nav-item @(activePage == "BaiTap" ? "active" : "")">
                <div class="gv-nav-icon">📝</div>
                <span class="gv-nav-label">Bài tập</span>
            </a>

            <!-- Điểm số -->
            <a asp-area="GiaoVien" asp-controller="GiaoVien" asp-action="QuanLyDiemSo"
               class="gv-nav-item @(activePage == "DiemSo" ? "active" : "")">
                <div class="gv-nav-icon">🏆</div>
                <span class="gv-nav-label">Điểm số</span>
            </a>

            <div class="gv-nav-divider"></div>

            <!-- Tiến độ -->
            <a asp-area="GiaoVien" asp-controller="GiaoVien" asp-action="TienDo"
               class="gv-nav-item @(activePage == "TienDo" ? "active" : "")">
                <div class="gv-nav-icon">📊</div>
                <span class="gv-nav-label">Tiến độ</span>
            </a>

            <!-- Lịch dạy -->
            <a asp-area="GiaoVien" asp-controller="GiaoVien" asp-action="LichDay"
               class="gv-nav-item @(activePage == "LichDay" ? "active" : "")">
                <div class="gv-nav-icon">📅</div>
                <span class="gv-nav-label">Lịch dạy</span>
            </a>

            <!-- Yêu cầu -->
            <a asp-area="GiaoVien" asp-controller="YeuCau" asp-action="MyRequests"
               class="gv-nav-item @(activePage == "YeuCau" ? "active" : "")">
                <div class="gv-nav-icon">✉️</div>
                <span class="gv-nav-label">Yêu cầu</span>
            </a>

        </nav>

    </aside>

    <!-- Profile dropdown -->
    <div class="gv-profile-dropdown" id="gvProfileDropdown" onclick="event.stopPropagation()">
        <div class="gv-profile-header">
            <img src="@avatarUrl" alt="avatar" />
            <div class="gv-profile-info">
                <div class="name">@User.Identity!.Name</div>
                <div class="role">Giáo viên</div>
            </div>
        </div>
        <a class="gv-dd-item" asp-area="" asp-controller="Profile" asp-action="Edit">
            <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
            Sửa thông tin cá nhân
        </a>
        <a class="gv-dd-item" asp-area="" asp-controller="DoiMatKhau" asp-action="Index">
            <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            Đổi mật khẩu
        </a>
        <div class="gv-dd-sep"></div>
        <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" style="margin:0;">
            @Html.AntiForgeryToken()
            <button type="submit" class="gv-dd-item danger">
                <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                Đăng xuất
            </button>
        </form>
    </div>

    <!-- ===== MAIN CONTENT ===== -->
    <main class="gv-content">
        @RenderBody()
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <!-- ===== CUSTOM DELETE CONFIRM MODAL ===== -->
    <div id="gvDeleteModal" style="display:none;position:fixed;inset:0;z-index:9999;align-items:center;justify-content:center;">
        <!-- Backdrop -->
        <div id="gvDeleteBackdrop" onclick="dongModalXoa()"
             style="position:absolute;inset:0;background:rgba(15,23,42,0.55);backdrop-filter:blur(4px);transition:opacity .25s;"></div>
        <!-- Dialog -->
        <div id="gvDeleteDialog"
             style="position:relative;z-index:1;background:#fff;border-radius:20px;padding:2rem 2rem 1.6rem;
                    max-width:420px;width:calc(100% - 2rem);box-shadow:0 24px 64px rgba(0,0,0,0.22);
                    transform:scale(0.92) translateY(12px);transition:transform .25s,opacity .25s;opacity:0;">
            <!-- Icon vùng nguy hiểm -->
            <div style="width:56px;height:56px;border-radius:14px;background:#fef2f2;display:flex;align-items:center;
                         justify-content:center;margin:0 auto 1.2rem;border:1.5px solid #fecaca;">
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>
                    <path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/>
                </svg>
            </div>
            <h3 id="gvDeleteTitle" style="text-align:center;font-size:1.1rem;font-weight:800;color:#1e293b;
                                          letter-spacing:-0.02em;margin:0 0 .5rem;">Xác nhận xóa</h3>
            <p id="gvDeleteMsg" style="text-align:center;font-size:0.9rem;color:#64748b;
                                        line-height:1.55;margin:0 0 1.6rem;"></p>
            <!-- Warning note -->
            <div style="background:#fef9c3;border:1px solid #fde047;border-radius:10px;
                        padding:.65rem 1rem;margin-bottom:1.4rem;display:flex;align-items:flex-start;gap:.6rem;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#ca8a04" stroke-width="2"
                     stroke-linecap="round" style="flex-shrink:0;margin-top:1px;">
                    <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
                    <line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/>
                </svg>
                <span style="font-size:.82rem;color:#92400e;font-weight:500;line-height:1.45;">
                    Hành động này <strong>không thể hoàn tác</strong>. Dữ liệu sẽ bị xóa vĩnh viễn.
                </span>
            </div>
            <!-- Buttons -->
            <div style="display:flex;gap:.75rem;">
                <button onclick="dongModalXoa()"
                        style="flex:1;padding:.7rem;border-radius:10px;border:1.5px solid #e2e8f0;
                               background:#f8fafc;color:#475569;font-weight:600;font-size:.9rem;
                               cursor:pointer;transition:all .15s;">
                    Hủy bỏ
                </button>
                <button id="gvDeleteConfirmBtn"
                        style="flex:1;padding:.7rem;border-radius:10px;border:none;
                               background:linear-gradient(135deg,#dc2626,#b91c1c);color:#fff;
                               font-weight:700;font-size:.9rem;cursor:pointer;
                               box-shadow:0 4px 12px rgba(220,38,38,.35);transition:all .15s;letter-spacing:-0.01em;">
                    Xóa
                </button>
            </div>
        </div>
    </div>

    <script>
        /* ── Custom Delete Confirm Modal ── */
        var _gvPendingForm = null;

        function xacNhanXoa(form, msg) {
            _gvPendingForm = form;
            var modal = document.getElementById('gvDeleteModal');
            var dialog = document.getElementById('gvDeleteDialog');
            document.getElementById('gvDeleteMsg').textContent = msg || 'Bạn có chắc chắn muốn xóa mục này?';
            modal.style.display = 'flex';
            requestAnimationFrame(function() {
                dialog.style.opacity = '1';
                dialog.style.transform = 'scale(1) translateY(0)';
            });
        }

        function dongModalXoa() {
            var modal = document.getElementById('gvDeleteModal');
            var dialog = document.getElementById('gvDeleteDialog');
            dialog.style.opacity = '0';
            dialog.style.transform = 'scale(0.92) translateY(12px)';
            setTimeout(function() { modal.style.display = 'none'; _gvPendingForm = null; }, 220);
        }

        document.getElementById('gvDeleteConfirmBtn').addEventListener('click', function() {
            if (_gvPendingForm) {
                dongModalXoa();
                setTimeout(function() { _gvPendingForm.submit(); }, 50);
            }
        });

        /* Đóng khi nhấn Escape */
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') dongModalXoa();
        });

        /* ── Profile dropdown ── */
        function toggleProfileDropdown(e) {
            e.stopPropagation();
            var dd = document.getElementById('gvProfileDropdown');
            dd.classList.toggle('show');
        }

        document.addEventListener('click', function() {
            var dd = document.getElementById('gvProfileDropdown');
            if (dd) dd.classList.remove('show');
        });

        /* ── Toast ── */
        function showToast(msg, type) {
            type = type || 'success';
            var cls = type === 'error' ? 'toast-error' : type === 'info' ? 'toast-info' : 'toast-success';
            var t = document.createElement('div');
            t.className = 'toast ' + cls;
            t.textContent = msg;
            document.body.appendChild(t);
            setTimeout(function() { t.style.opacity = '0'; t.style.transition = 'opacity .3s'; setTimeout(function() { t.remove(); }, 300); }, 2800);
        }
    </script>

</body>
</html>
