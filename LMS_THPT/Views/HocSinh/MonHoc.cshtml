@model List<LMS_THPT.Models.LopMonHoc>
@{
    ViewData["Title"] = "Môn học của tôi";
    Layout = "~/Views/Shared/_LayoutHocSinh.cshtml";
    string[][] palettes = {
        new[]{"#6366f1","#4338ca"}, new[]{"#0ea5e9","#0284c7"},
        new[]{"#10b981","#059669"}, new[]{"#f59e0b","#d97706"},
        new[]{"#ef4444","#dc2626"}, new[]{"#8b5cf6","#7c3aed"},
        new[]{"#06b6d4","#0891b2"}, new[]{"#f43f5e","#e11d48"},
        new[]{"#84cc16","#65a30d"}, new[]{"#fb923c","#ea580c"},
    };
    string Grad(int i){ var p=palettes[i%palettes.Length]; return $"linear-gradient(135deg,{p[0]},{p[1]})"; }
    string Init(string n){ var p=n.Trim().Split(' '); return p.Length>=2?$"{p[0][0]}{p[^1][0]}".ToUpper():n.Length>=2?n[..2].ToUpper():n.ToUpper(); }
    var user = (LMS_THPT.Models.NguoiDung?)ViewBag.User;
}
<style>
/* ===== FIX FONT: Buộc dùng Inter cho toàn bộ trang môn học ===== */
.mon-page, .mon-page * {
    font-family: 'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, 'Noto Sans', sans-serif;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
}
.mon-page-title{font-size:1.5rem;font-weight:800;color:#1e293b;letter-spacing:-0.02em;font-family:inherit}
.mon-subtitle{color:#64748b;font-size:.9rem;margin-top:.2rem;font-family:inherit}
.mon-card{background:#fff;border-radius:14px;box-shadow:0 2px 12px rgba(0,0,0,.07);border:1px solid rgba(0,0,0,.06);overflow:hidden;transition:transform .2s,box-shadow .2s;cursor:pointer;text-decoration:none;color:inherit;display:flex;flex-direction:column;height:100%}
.mon-card:hover{transform:translateY(-5px);box-shadow:0 12px 36px rgba(0,0,0,.14);color:inherit}
.mon-card-header{height:110px;display:flex;align-items:flex-end;justify-content:space-between;padding:1rem 1.2rem;position:relative;overflow:hidden}
.mon-card-header::after{content:'';position:absolute;top:-30%;right:-10%;width:130px;height:130px;border-radius:50%;background:rgba(255,255,255,.12)}
.mon-card-header::before{content:'';position:absolute;bottom:-40%;left:-5%;width:100px;height:100px;border-radius:50%;background:rgba(255,255,255,.08)}
.mon-initials{width:48px;height:48px;border-radius:12px;background:rgba(255,255,255,.25);display:flex;align-items:center;justify-content:center;font-size:1.1rem;font-weight:800;color:#fff;position:relative;z-index:1;font-family:inherit;letter-spacing:-.02em}
.mon-chevron{color:rgba(255,255,255,.7);font-size:1.2rem;position:relative;z-index:1;transition:transform .2s}
.mon-card:hover .mon-chevron{transform:translateX(4px)}
.mon-card-body{padding:1rem 1.2rem;flex-grow:1;display:flex;flex-direction:column}
.mon-card-name{font-weight:700;font-size:1rem;color:#1e293b;margin-bottom:.3rem;line-height:1.3;font-family:inherit}
.mon-card-gv{font-size:.82rem;color:#64748b;display:flex;align-items:center;gap:.3rem;font-family:inherit}
.mon-card-footer{padding:.8rem 1.2rem;border-top:1px solid #f1f5f9;display:flex;align-items:center;gap:1rem}
.mon-quick{font-size:.75rem;color:#94a3b8;padding:.25rem .5rem;border-radius:6px;transition:all .15s;font-family:inherit}
.mon-quick:hover{background:#f1f5f9;color:#475569}
.section-badge{display:inline-flex;align-items:center;gap:.4rem;background:#eff6ff;color:#3730a3;border-radius:999px;padding:.3rem .9rem;font-size:.78rem;font-weight:600;font-family:inherit}
.empty-hs{text-align:center;padding:5rem 1rem;color:#94a3b8;font-family:inherit}
</style>


<div class="mon-page">
<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-3">
    <div>
        <h1 class="mon-page-title">📚 Môn học của tôi</h1>
        <p class="mon-subtitle">
            @if (Model.Count > 0)
            { <text>Bạn đang học <strong>@Model.Count môn</strong>. Chọn môn để bắt đầu học.</text> }
            else { <text>Chưa có môn học nào được phân công.</text> }
        </p>
    </div>
    <span class="section-badge">🎓 @(user?.Lop?.TenLop ?? "Chưa có lớp")</span>
</div>

@if (Model.Count == 0)
{
    <div class="empty-hs">
        <div style="font-size:4rem;margin-bottom:1rem">📭</div>
        <h5>Chưa có môn học nào</h5>
        <p>Bạn chưa được phân lớp hoặc lớp chưa có môn học được thiết lập.</p>
    </div>
}
else
{
    <div class="row g-4">
        @for (int i = 0; i < Model.Count; i++)
        {
            var lm = Model[i];
            if (lm.MonHoc == null) continue;
            string gvName = lm.GiaoVien?.HoTen ?? lm.MonHoc.GiaoVien?.HoTen ?? "Chưa phân công GV";
            <div class="col-sm-6 col-lg-4 col-xl-3">
                <a href="@Url.Action("ChiTietMonHoc","HocSinh",new{id=lm.MonHoc.Id})" class="mon-card">
                    <div class="mon-card-header" style="background:@Grad(i)">
                        <div class="mon-initials">@Init(lm.MonHoc.TenMonHoc)</div>
                        <span class="mon-chevron">→</span>
                    </div>
                    <div class="mon-card-body">
                        <div class="mon-card-name">@lm.MonHoc.TenMonHoc</div>
                        <div class="mon-card-gv"><span>👨‍🏫</span><span>@gvName</span></div>
                        @if (!string.IsNullOrEmpty(lm.MonHoc.MoTa))
                        {
                            <div class="text-muted mt-2" style="font-size:.8rem;line-height:1.4;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden">@lm.MonHoc.MoTa</div>
                        }
                    </div>
                    <div class="mon-card-footer">
                        <span class="mon-quick">📖 Bài giảng</span>
                        <span class="mon-quick">📝 Bài tập</span>
                        <span class="mon-quick">🏆 Điểm</span>
                    </div>
                </a>
            </div>
        }
    </div>
}
</div>
