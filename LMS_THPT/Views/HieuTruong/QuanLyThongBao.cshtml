@model IEnumerable<LMS_THPT.Models.ThongBao>
@{
    ViewData["Title"] = "Quản Lý Thông Báo";
}

<style>
    /* MONOCHROME MINIMALIST STYLE */
    .page-header {
        display: flex;
        align-items: center;
        gap: 16px;
        margin-bottom: 24px;
        border-bottom: 2px solid #000;
        padding-bottom: 16px;
    }

    .page-header-icon {
        font-size: 32px;
        background: #fff;
        color: #000;
        border: 2px solid #000;
        border-radius: 0;
        width: 60px; height: 60px;
        display: flex; align-items: center; justify-content: center;
        box-shadow: 4px 4px 0px rgba(0,0,0,1);
    }

    .page-header h1 {
        font-size: 24px;
        font-weight: 900;
        color: #000;
        margin: 0 0 3px 0;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .page-header p {
        font-size: 13px;
        font-weight: 600;
        color: #555;
        margin: 0;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .main-grid {
        display: grid;
        grid-template-columns: 1.4fr 1fr;
        gap: 24px;
        align-items: start;
    }

    /* PANEL */
    .panel {
        background: #fff;
        border-radius: 0;
        padding: 24px;
        box-shadow: 4px 4px 0px rgba(0,0,0,1);
        border: 2px solid #000;
    }

    .panel-title {
        font-size: 16px;
        font-weight: 900;
        color: #000;
        margin-bottom: 18px;
        padding-bottom: 12px;
        border-bottom: 2px solid #000;
        display: flex;
        align-items: center;
        gap: 8px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    /* FORM */
    .form-group { margin-bottom: 16px; }

    .form-group label {
        display: block;
        font-size: 13px;
        font-weight: 800;
        color: #000;
        margin-bottom: 8px;
        text-transform: uppercase;
    }

    .form-input {
        width: 100%;
        padding: 12px;
        border: 2px solid #000;
        border-radius: 0;
        font-size: 14px;
        font-weight: 600;
        background: #fff;
        outline: none;
        transition: all 0.2s;
        box-sizing: border-box;
    }

    .form-input:focus { box-shadow: 2px 2px 0px #000; }

    textarea.form-input { resize: vertical; min-height: 120px; line-height: 1.6; }

    .btn-submit {
        width: 100%;
        padding: 14px;
        background: #000;
        color: #fff;
        border: 2px solid #000;
        border-radius: 0;
        font-size: 14px;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 1px;
        cursor: pointer;
        transition: all 0.2s;
    }

    .btn-submit:hover { background: #fff; color: #000; box-shadow: 4px 4px 0px #000; transform: translate(-2px, -2px); }

    /* LIST */
    .tb-item {
        border: 2px solid #000;
        border-radius: 0;
        padding: 16px;
        margin-bottom: 16px;
        transition: all 0.2s;
        background: #fff;
    }

    .tb-item:hover { box-shadow: 4px 4px 0px #000; transform: translate(-2px, -2px); }

    .tb-item-header {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        margin-bottom: 8px;
    }

    .tb-title {
        font-size: 15px;
        font-weight: 900;
        color: #000;
        flex: 1;
        line-height: 1.4;
        text-transform: uppercase;
    }

    .tb-content {
        font-size: 14px;
        color: #000;
        font-weight: 500;
        line-height: 1.6;
        margin-bottom: 12px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .tb-footer {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }

    .tb-time { font-size: 12px; color: #555; font-weight: 700; flex: 1; text-transform: uppercase;}

    .badge-hienthi {
        font-size: 11px;
        font-weight: 800;
        padding: 4px 8px;
        border-radius: 0;
        text-transform: uppercase;
    }

    .badge-on  { background: #fff; color: #000; border: 2px solid #000; }
    .badge-off { background: #f5f5f5; color: #000; border: 2px dashed #000; }

    .btn-toggle, .btn-xoa {
        padding: 6px 12px;
        border-radius: 0;
        font-size: 12px;
        font-weight: 800;
        text-transform: uppercase;
        border: 2px solid #000;
        cursor: pointer;
        transition: all 0.2s;
    }

    .btn-toggle-on  { background: #fff; color: #000; }
    .btn-toggle-off { background: #e0e0e0; color: #000; }
    .btn-toggle:hover { box-shadow: 2px 2px 0px #000; transform: translate(-1px, -1px); }

    .btn-xoa { background: #fff; color: #000; border: 2px dashed #000; }
    .btn-xoa:hover { background: #000; color: #fff; box-shadow: 2px 2px 0px #000; transform: translate(-1px, -1px); }

    .empty-state {
        text-align: center;
        padding: 40px 20px;
        color: #000;
        font-weight: 800;
        text-transform: uppercase;
    }

    .empty-state .empty-icon { font-size: 40px; margin-bottom: 16px; display: block; }
    .empty-state p { font-size: 14px; margin: 0; }

    .btn-back-link {
        padding: 10px 20px;
        background: #fff;
        color: #000;
        border: 2px solid #000;
        border-radius: 0;
        font-size: 13px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        text-decoration: none;
        display: inline-block;
        margin-bottom: 8px;
        transition: all 0.2s;
    }

    .btn-back-link:hover { background: #000; text-decoration: none; color:#fff; box-shadow: 2px 2px 0px #000; }

    @@media(max-width: 768px) { .main-grid { grid-template-columns: 1fr; } }
</style>

<div class="page-header">
    <div>
        <h1>Quản Lý Thông Báo</h1>
        <p>Phân hệ đăng tin và điều hành thông báo toàn trường</p>
    </div>
    <a asp-action="Index" class="btn-back-link ms-auto">← Dashboard</a>
</div>

<!-- ALERTS -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 mb-3" role="alert">
        ✅ @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-3" role="alert">
        ❌ @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="main-grid">

    <!-- DANH SÁCH THÔNG BÁO -->
    <div class="panel">
        <div class="panel-title">
            Danh Sách Các Thông Báo Đã Đăng
            <span style="font-size:12px;font-weight:500;color:#718096;margin-left:6px;">(@(Model?.Count() ?? 0) bản ghi)</span>
        </div>

        @if (Model != null && Model.Any())
        {
            foreach (var tb in Model)
            {
                <div class="tb-item">
                    <div class="tb-item-header">
                        <div class="tb-title">@tb.TieuDe</div>
                        <span class="badge-hienthi @(tb.HienThi ? "badge-on" : "badge-off")">
                            @(tb.HienThi ? "Đang hiển thị" : "Đang ẩn")
                        </span>
                    </div>
                    <div class="tb-content">@tb.NoiDung</div>
                    <div class="tb-footer">
                        <span class="tb-time">🕐 @tb.NgayDang.ToString("dd/MM/yyyy HH:mm")</span>

                        <form asp-action="ToggleThongBao" method="post" style="display:inline;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@tb.Id" />
                            <button type="submit" class="btn-toggle @(tb.HienThi ? "btn-toggle-off" : "btn-toggle-on")">
                                @(tb.HienThi ? "👁️ Ẩn" : "👁️ Hiện")
                            </button>
                        </form>

                        <form asp-action="XoaThongBao" method="post" style="display:inline;"
                              onsubmit="return confirm('Xác nhận xóa thông báo này?')">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@tb.Id" />
                            <button type="submit" class="btn-xoa">Xóa bản ghi</button>
                        </form>

                        <a asp-action="SuaThongBao" asp-route-id="@tb.Id" class="btn-toggle btn-toggle-on" style="text-decoration:none;margin-left:4px;">Chỉnh sửa</a>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="empty-state">
                <div class="empty-icon">📭</div>
                <p>Chưa có thông báo nào</p>
            </div>
        }
    </div>

    <div class="panel" style="position:sticky;top:80px;">
        <div class="panel-title">Đăng Thông Báo Mới</div>

        <form asp-action="TaoThongBao" method="post">
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label for="tieuDe">Tiêu đề <span style="color:#000; font-weight:bold;">*</span></label>
                <input type="text" id="tieuDe" name="tieuDe" class="form-input"
                       placeholder="Nhập tiêu đề thông báo..." maxlength="200" required />
            </div>

            <div class="form-group">
                <label for="noiDung">Nội dung <span style="color:#000; font-weight:bold;">*</span></label>
                <textarea id="noiDung" name="noiDung" class="form-input"
                          placeholder="Nhập nội dung thông báo..." required></textarea>
            </div>

            <button type="submit" class="btn-submit">Lưu và Đăng Tin</button>
        </form>
    </div>

</div>
