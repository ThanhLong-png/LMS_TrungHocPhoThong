@using System.Collections
@{
    ViewData["Title"] = "Danh Sách Giáo Viên";
    var search = ViewBag.Search as string;
}

<style>
    /* MONOCHROME MINIMALIST STYLE */
    .page-header {
        display: flex;
        align-items: center;
        gap: 16px;
        margin-bottom: 24px;
        border-bottom: 2px solid #000;
        padding-bottom: 16px;
    }

    .page-header-icon {
        font-size: 32px;
        background: #fff;
        color: #000;
        border: 2px solid #000;
        border-radius: 0;
        width: 60px; height: 60px;
        display: flex; align-items: center; justify-content: center;
        box-shadow: 4px 4px 0px rgba(0,0,0,1);
    }

    .page-header h1 {
        font-size: 24px;
        font-weight: 900;
        color: #000;
        margin: 0 0 3px 0;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .page-header p {
        font-size: 13px;
        font-weight: 600;
        color: #555;
        margin: 0;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .toolbar {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 24px;
        background: #fff;
        padding: 16px 20px;
        border-radius: 0;
        box-shadow: 4px 4px 0px rgba(0,0,0,1);
        border: 2px solid #000;
        flex-wrap: wrap;
    }

    .search-box {
        flex: 1;
        min-width: 220px;
        position: relative;
    }

    .search-box input {
        width: 100%;
        padding: 10px 14px 10px 38px;
        border: 2px solid #000;
        border-radius: 0;
        font-size: 14px;
        font-weight: 600;
        background: #fff;
        outline: none;
        transition: all 0.2s;
    }

    .search-box input:focus { box-shadow: 2px 2px 0px #000; }

    .search-box .search-icon {
        position: absolute;
        left: 12px; top: 50%;
        transform: translateY(-50%);
        color: #000;
        font-size: 15px;
        font-weight: bold;
    }

    .btn-search {
        padding: 10px 24px;
        background: #000;
        color: #fff;
        border: 2px solid #000;
        border-radius: 0;
        font-size: 13px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        cursor: pointer;
        transition: all 0.2s;
        white-space: nowrap;
    }

    .btn-search:hover { background: #fff; color: #000; box-shadow: 2px 2px 0px #000; }

    .btn-back {
        padding: 10px 20px;
        background: #fff;
        color: #000;
        border: 2px solid #000;
        border-radius: 0;
        font-size: 13px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        text-decoration: none;
        white-space: nowrap;
        transition: all 0.2s;
    }

    .btn-back:hover { background: #000; color:#fff; box-shadow: 2px 2px 0px #000; }

    .badge-count {
        background: #fff;
        color: #000;
        border-radius: 0;
        padding: 8px 16px;
        font-size: 13px;
        font-weight: 800;
        white-space: nowrap;
        border: 2px solid #000;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    /* TABLE */
    .table-wrap {
        background: #fff;
        border-radius: 0;
        box-shadow: 4px 4px 0px rgba(0,0,0,1);
        overflow: hidden;
        border: 2px solid #000;
    }

    .gv-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 14px;
    }

    .gv-table thead tr {
        background: #f5f5f5;
        color: #000;
    }

    .gv-table thead th {
        padding: 16px;
        font-weight: 800;
        font-size: 13px;
        text-align: left;
        white-space: nowrap;
        letter-spacing: 1px;
        text-transform: uppercase;
        border-bottom: 2px solid #000;
    }

    .gv-table tbody tr {
        border-bottom: 1px solid #ccc;
        transition: background 0.15s;
    }

    .gv-table tbody tr:last-child { border-bottom: none; }
    .gv-table tbody tr:hover { background: #f5f5f5; }

    .gv-table td {
        padding: 15px 16px;
        vertical-align: middle;
        color: #000;
        font-weight: 500;
    }

    .avatar-cell {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .avatar-circle {
        width: 40px; height: 40px;
        border-radius: 0;
        background: #000;
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        font-weight: 900;
        flex-shrink: 0;
        border: 2px solid #000;
    }

    .gv-name { font-weight: 800; color: #000; text-transform: uppercase; }
    .gv-sub  { font-size: 12px; color: #555; font-weight: 600; text-transform: uppercase; }

    .badge-mon {
        display: inline-block;
        background: #fff;
        color: #000;
        border-radius: 0;
        padding: 4px 10px;
        font-size: 11px;
        font-weight: 800;
        margin: 2px;
        border: 1px solid #000;
        text-transform: uppercase;
    }

    .badge-lop {
        display: inline-block;
        background: #000;
        color: #fff;
        border-radius: 0;
        padding: 4px 10px;
        font-size: 12px;
        font-weight: 800;
        border: 1px solid #000;
        text-transform: uppercase;
    }

    .badge-chuaphan {
        color: #888;
        font-size: 12px;
        font-weight: bold;
        font-style: italic;
    }

    .empty-state {
        text-align: center;
        padding: 60px 20px;
        color: #000;
        font-weight: 800;
        text-transform: uppercase;
    }

    .empty-state .empty-icon { font-size: 48px; margin-bottom: 16px; display: block; }
    .empty-state p { font-size: 15px; margin: 0; }
</style>

<div class="page-header">
    <div class="page-header-icon">👨‍🏫</div>
    <div>
        <h1>Danh Sách Giáo Viên</h1>
        <p>Xem thông tin đội ngũ giáo viên toàn trường</p>
    </div>
</div>

<!-- ALERT -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 mb-3" role="alert">
        ✅ @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- TOOLBAR -->
<div class="toolbar">
    <form method="get" asp-action="DanhSachGiaoVien" class="d-flex gap-2 flex-1" style="flex:1;min-width:220px;">
        <div class="search-box">
            <span class="search-icon">🔍</span>
            <input type="text" name="search" value="@search" placeholder="Tìm theo tên giáo viên..." />
        </div>
        <button type="submit" class="btn-search">Tìm</button>
        @if (!string.IsNullOrEmpty(search))
        {
            <a asp-action="DanhSachGiaoVien" class="btn-back">✕ Xóa lọc</a>
        }
    </form>

    <span class="badge-count">👨‍🏫 @ViewBag.SoLuong giáo viên</span>

    <a asp-action="Index" class="btn-back">← Dashboard</a>
</div>

<!-- TABLE -->
<div class="table-wrap">
    @{
        var model = Model as IEnumerable<dynamic>;
    }
    @if (model != null && model.Any())
    {
        <table class="gv-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Giáo Viên</th>
                    <th>Mã GV</th>
                    <th>Giới Tính</th>
                    <th>Chuyên Môn</th>
                    <th>Chức Vụ</th>
                    <th>Lớp CN</th>
                    <th>Môn Phụ Trách</th>
                    <th>Trạng Thái</th>
                </tr>
            </thead>
            <tbody>
                @{int stt = 1;}
                @foreach (var item in model)
                {
                    var user = item.User as LMS_THPT.Models.NguoiDung;
                    if (user == null) continue;

                    var tenHienThi = string.IsNullOrEmpty(user.HoTen) ? user.UserName : user.HoTen;
                    var firstChar = tenHienThi?.Length > 0 ? tenHienThi[0].ToString().ToUpper() : "?";

                    <tr>
                        <td style="color:#a0aec0;font-size:13px;">@(stt++)</td>
                        <td>
                            <div class="avatar-cell">
                                <div class="avatar-circle">@firstChar</div>
                                <div>
                                    <div class="gv-name">@tenHienThi</div>
                                    <div class="gv-sub">@user.Email</div>
                                </div>
                            </div>
                        </td>
                        <td><code style="font-size:13px;color:#553c9a;">@user.UserName</code></td>
                        <td style="font-size:13px;">@(user.GioiTinh ?? "—")</td>
                        <td style="font-size:13px;">@(user.ChuyenMon ?? "—")</td>
                        <td style="font-size:13px;">@(user.ChucVu ?? "—")</td>
                        <td>
                            @{
                                var tenLop = (string?)item.TenLop;
                                var tenKhoi = (string?)item.TenKhoi;
                            }
                            @if (!string.IsNullOrEmpty(tenLop) && tenLop != "---")
                            {
                                <span class="badge-lop">@tenLop</span>
                                <div style="font-size:11px;color:#718096;margin-top:2px;">@tenKhoi</div>
                            }
                            else
                            {
                                <span class="badge-chuaphan">Chưa phân</span>
                            }
                        </td>
                        <td>
                            @{
                                var mons = item.MonPhanCong as IEnumerable<string?>;
                            }
                            @if (mons != null && mons.Any())
                            {
                                foreach (var mon in mons)
                                {
                                    <span class="badge-mon">@mon</span>
                                }
                            }
                            else
                            {
                                <span style="color:#a0aec0;font-size:12px;">Chưa có</span>
                            }
                        </td>
                        <td>
                            @if (user.IsActive)
                            {
                                <span style="display:inline-block; border:2px solid #000; padding:4px 8px; font-weight:800; font-size:11px; text-transform:uppercase;">HOẠT ĐỘNG</span>
                            }
                            else
                            {
                                <span style="display:inline-block; border:2px solid #000; background:#000; color:#fff; padding:4px 8px; font-weight:800; font-size:11px; text-transform:uppercase;">ĐÃ KHÓA</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="empty-state">
            <div class="empty-icon">👨‍🏫</div>
            <p>Không có giáo viên nào@(string.IsNullOrEmpty(search) ? "" : $" phù hợp với \"{search}\"")</p>
        </div>
    }
</div>
