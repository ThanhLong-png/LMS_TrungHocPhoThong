@{
    ViewData["Title"] = "Thống Kê Chất Lượng Học Tập";
    var thongKe = ViewBag.ThongKe;
}

<style>
    .page-header {
        display: flex;
        align-items: center;
        gap: 16px;
        margin-bottom: 24px;
        border-bottom: 2px solid #000;
        padding-bottom: 16px;
    }
    
    .page-header-icon {
        font-size: 32px;
        background: #fff;
        color: #000;
        border: 2px solid #000;
        border-radius: 0;
        width: 60px; height: 60px;
        display: flex; align-items: center; justify-content: center;
        box-shadow: 4px 4px 0px rgba(0,0,0,1);
    }
    
    .page-header h1 {
        font-size: 24px;
        font-weight: 900;
        color: #000;
        margin: 0 0 3px 0;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .page-header p {
        font-size: 13px;
        font-weight: 600;
        color: #555;
        margin: 0;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .chart-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 24px;
    }
    .panel {
        background: #fff;
        border-radius: 0;
        padding: 24px;
        box-shadow: 4px 4px 0px rgba(0,0,0,1);
        border: 2px solid #000;
    }
    .panel-title {
        font-weight: 900;
        font-size: 16px;
        margin-bottom: 20px;
        color: #000;
        border-left: none;
        padding-left: 0;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        border-bottom: 2px solid #000;
        padding-bottom: 10px;
    }
    .stat-summary {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
        margin-bottom: 24px;
    }
    .stat-box {
        padding: 20px 15px;
        border-radius: 0;
        text-align: center;
        border: 2px solid #000;
        background: #fff;
        box-shadow: 4px 4px 0px rgba(0,0,0,1);
        transition: all 0.2s;
    }
    
    .stat-box:hover {
        transform: translate(-4px, -4px);
        box-shadow: 8px 8px 0px rgba(0,0,0,1);
    }
    
    .stat-val { font-size: 26px; font-weight: 900; display: block; color: #000; }
    .stat-lab { font-size: 13px; font-weight: 800; text-transform: uppercase; margin-top: 4px; display: block; color: #000; }
    
    /* Removed old bg colors */
    .bg-gioi { background: #fff; }
    .bg-gioi .stat-val { color: #000; }
    .bg-gioi .stat-lab { color: #555; }
    
    .bg-kha { background: #f9f9f9; }
    .bg-kha .stat-val { color: #000; }
    .bg-kha .stat-lab { color: #555; }

    .bg-tb { background: #e0e0e0; }
    .bg-tb .stat-val { color: #000; }
    .bg-tb .stat-lab { color: #555; }

    .bg-yeu { background: #d0d0d0; }
    .bg-yeu .stat-val { color: #000; }
    .bg-yeu .stat-lab { color: #555; }

    .btn-back {
        padding: 10px 20px;
        background: #fff;
        color: #000;
        border: 2px solid #000;
        border-radius: 0;
        font-size: 13px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        text-decoration: none;
        white-space: nowrap;
        transition: all 0.2s;
    }

    .btn-back:hover { background: #000; color:#fff; box-shadow: 2px 2px 0px #000; text-decoration: none; }

    @@media(max-width: 992px) {
        .chart-grid { grid-template-columns: 1fr; }
        .stat-summary { grid-template-columns: repeat(2, 1fr); }
    }
</style>

<div class="page-header justify-content-between">
    <div class="d-flex align-items-center gap-3">
        <div class="page-header-icon">📊</div>
        <div>
            <h1>Thống Kê Chất Lượng</h1>
            <p>Phân tích tỉ lệ xếp loại học lực học kỳ</p>
        </div>
    </div>
    <a asp-action="Index" class="btn-back">← Dashboard</a>
</div>

<div class="stat-summary">
    <div class="stat-box bg-gioi">
        <span class="stat-val">@thongKe.Gioi</span>
        <span class="stat-lab">Loại Giỏi</span>
    </div>
    <div class="stat-box bg-kha">
        <span class="stat-val">@thongKe.Kha</span>
        <span class="stat-lab">Loại Khá</span>
    </div>
    <div class="stat-box bg-tb">
        <span class="stat-val">@thongKe.TrungBinh</span>
        <span class="stat-lab">Loại TB</span>
    </div>
    <div class="stat-box bg-yeu">
        <span class="stat-val">@thongKe.Yeu</span>
        <span class="stat-lab">Loại Yếu</span>
    </div>
</div>

<div class="chart-grid">
    <div class="panel">
        <div class="panel-title">Tỉ lệ phần trăm xếp loại</div>
        <div style="max-width: 400px; margin: 0 auto;">
            <canvas id="pieChart"></canvas>
        </div>
    </div>
    <div class="panel">
        <div class="panel-title">So sánh số lượng học sinh</div>
        <canvas id="barChart"></canvas>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const ctxPie = document.getElementById('pieChart').getContext('2d');
        const ctxBar = document.getElementById('barChart').getContext('2d');
        
        const data = {
            labels: ['Giỏi', 'Khá', 'Trung Bình', 'Yếu'],
            datasets: [{
                data: [@thongKe.Gioi, @thongKe.Kha, @thongKe.TrungBinh, @thongKe.Yeu],
                backgroundColor: ['#000000', '#555555', '#bbbbbb', '#ffffff'],
                borderColor: '#000000',
                borderWidth: 2
            }]
        };

        Chart.defaults.color = '#000';
        Chart.defaults.font.family = 'inherit';
        Chart.defaults.font.weight = 'bold';

        new Chart(ctxPie, {
            type: 'doughnut',
            data: data,
            options: {
                plugins: {
                    legend: { position: 'bottom', labels: { font: { weight: 'bold' } } }
                },
                cutout: '60%'
            }
        });

        new Chart(ctxBar, {
            type: 'bar',
            data: data,
            options: {
                plugins: {
                    legend: { display: false }
                },
                scales: {
                    y: { 
                        beginAtZero: true, 
                        grid: { color: '#e5e5e5' },
                        ticks: { font: { weight: 'bold' }, stepSize: 1 }
                    },
                    x: { 
                        grid: { display: false },
                        ticks: { font: { weight: 'bold', size: 13 } }
                    }
                },
                borderRadius: 0,
                borderSkipped: false
            }
        });
    </script>
}
