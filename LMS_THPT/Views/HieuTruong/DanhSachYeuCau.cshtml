@model IEnumerable<LMS_THPT.Models.YeuCauGiaoVien>
@{
    ViewData["Title"] = "Duyệt Yêu Cầu Giáo Viên";
}

<style>
    /* MONOCHROME MINIMALIST STYLE */
    .page-header {
        display: flex;
        align-items: center;
        gap: 16px;
        margin-bottom: 24px;
        border-bottom: 2px solid #000;
        padding-bottom: 16px;
    }

    .page-header-icon {
        font-size: 32px;
        background: #fff;
        color: #000;
        border: 2px solid #000;
        border-radius: 0;
        width: 60px; height: 60px;
        display: flex; align-items: center; justify-content: center;
        box-shadow: 4px 4px 0px rgba(0,0,0,1);
    }

    .page-header h1 {
        font-size: 24px;
        font-weight: 900;
        color: #000;
        margin: 0 0 3px 0;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .page-header p {
        font-size: 13px;
        font-weight: 600;
        color: #555;
        margin: 0;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .yc-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(400px, 1fr));
        gap: 24px;
    }

    .yc-card {
        background: #fff;
        border-radius: 0;
        padding: 24px;
        box-shadow: 4px 4px 0px rgba(0,0,0,1);
        border: 2px solid #000;
        position: relative;
        overflow: hidden;
    }

    .yc-card.yc-pending { border-left: 6px solid #aaa; }
    .yc-card.yc-approved { border-left: 6px solid #000; }
    .yc-card.yc-rejected { border-left: 6px solid #444; }

    .yc-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 15px;
    }

    .yc-type {
        font-size: 11px;
        font-weight: 800;
        text-transform: uppercase;
        padding: 4px 10px;
        border-radius: 0;
        background: #fff;
        color: #000;
        border: 1px solid #000;
    }

    .yc-status {
        font-size: 12px;
        font-weight: 800;
        text-transform: uppercase;
    }

    .yc-gv {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 12px;
    }

    .yc-gv-info b { color: #000; font-size: 16px; font-weight: 900; text-transform: uppercase; }
    .yc-gv-info p { margin: 0; font-size: 12px; color: #555; font-weight: 700; }

    .yc-title {
        font-weight: 800;
        font-size: 16px;
        color: #000;
        margin-bottom: 8px;
        text-transform: uppercase;
    }

    .yc-body {
        font-size: 14px;
        color: #000;
        line-height: 1.6;
        background: #fff;
        padding: 12px;
        border-radius: 0;
        border: 1px dashed #000;
        margin-bottom: 15px;
        font-weight: 500;
    }

    .yc-footer {
        font-size: 12px;
        color: #555;
        font-weight: 700;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .btn-action {
        padding: 8px 16px;
        border-radius: 0;
        font-size: 12px;
        font-weight: 800;
        text-transform: uppercase;
        cursor: pointer;
        border: 2px solid #000;
        transition: all 0.2s;
    }

    .btn-approve { background: #000; color: #fff; }
    .btn-reject { background: #fff; color: #000; }
    
    .btn-action:hover { box-shadow: 2px 2px 0px #000; transform: translate(-2px, -2px); }

    .modal-overlay {
        position: fixed;
        top: 0; left: 0; right: 0; bottom: 0;
        background: rgba(0,0,0,0.8);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 1000;
    }

    .modal-content {
        background: #fff;
        padding: 32px;
        border-radius: 0;
        border: 2px solid #000;
        box-shadow: 8px 8px 0px #000;
        width: 100%;
        max-width: 450px;
    }

    .form-input {
        width: 100%;
        padding: 12px;
        border: 2px solid #000;
        border-radius: 0;
        margin-top: 8px;
        margin-bottom: 20px;
        font-weight: 500;
        outline: none;
    }
    
    .form-input:focus { box-shadow: 2px 2px 0px #000; }
    
    .btn-back-link {
        padding: 10px 20px;
        background: #fff;
        color: #000;
        border: 2px solid #000;
        border-radius: 0;
        font-size: 13px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        text-decoration: none;
        white-space: nowrap;
        transition: all 0.2s;
    }

    .btn-back-link:hover { background: #000; color:#fff; box-shadow: 2px 2px 0px #000; text-decoration: none; }

</style>

<div class="page-header">
    <div>
        <h1>Duyệt Yêu Cầu Giáo Viên</h1>
        <p>Phân hệ xử lý các văn bản đề nghị từ đội ngũ giáo viên</p>
    </div>
    <a asp-action="Index" class="btn-back-link ms-auto">← Dashboard</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3" role="alert">
        ✅ @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="yc-grid">
    @foreach (var yc in Model)
    {
        var statusClass = yc.TrangThai == LMS_THPT.Models.TrangThaiYeuCau.ChoDuyet ? "yc-pending" :
                         yc.TrangThai == LMS_THPT.Models.TrangThaiYeuCau.DaDuyet ? "yc-approved" : "yc-rejected";
        
        <div class="yc-card @statusClass">
            <div class="yc-header">
                <span class="yc-type">@yc.LoaiYeuCau</span>
                <span class="yc-status" style="color: #000; border-bottom: 2px solid @(yc.TrangThai == LMS_THPT.Models.TrangThaiYeuCau.ChoDuyet ? "#000" : yc.TrangThai == LMS_THPT.Models.TrangThaiYeuCau.DaDuyet ? "#276749" : "#c53030")">
                    @(yc.TrangThai == LMS_THPT.Models.TrangThaiYeuCau.ChoDuyet ? "CHỜ DUYỆT" : 
                      yc.TrangThai == LMS_THPT.Models.TrangThaiYeuCau.DaDuyet ? "ĐÃ DUYỆT" : "TỪ CHỐI")
                </span>
            </div>

            <div class="yc-gv">
                <div class="yc-gv-info">
                    <b>@yc.GiaoVien?.HoTen</b>
                    <p>Mã GV: @yc.MaGiaoVien</p>
                </div>
            </div>

            <div class="yc-title">@yc.TieuDe</div>
            <div class="yc-body">@yc.NoiDung</div>

            @if (!string.IsNullOrEmpty(yc.GhiChuAdmin))
            {
                <div style="font-size:12px; font-style:italic; color:#718096; margin-bottom:10px; padding:8px; border-top:1px dashed #ddd;">
                    💬 HT ghi chú: @yc.GhiChuAdmin
                </div>
            }

            <div class="yc-footer">
                <span>📅 @yc.NgayGui.ToString("dd/MM/yyyy HH:mm")</span>
                
                @if (yc.TrangThai == LMS_THPT.Models.TrangThaiYeuCau.ChoDuyet)
                {
                    <div style="display:flex; gap:8px;">
                        <button class="btn-action btn-approve" onclick="openReviewModal(@yc.Id, 'DaDuyet')">Duyệt</button>
                        <button class="btn-action btn-reject" onclick="openReviewModal(@yc.Id, 'TuChoi')">Từ chối</button>
                    </div>
                }
            </div>
        </div>
    }
</div>

<!-- Modal xử lý -->
<div id="reviewModal" class="modal-overlay">
    <div class="modal-content">
        <h3 id="modalTitle" style="margin-bottom:15px; font-size:18px; font-weight:700;">Xử lý yêu cầu</h3>
        <form asp-action="XuLyYeuCau" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" id="modalYcId" name="id" />
            <input type="hidden" id="modalTrangThai" name="trangThai" />
            
            <label style="font-size:13px; font-weight:800; text-transform:uppercase; color:#000;">GHI CHÚ CỦA HIỆU TRƯỞNG:</label>
            <textarea name="ghiChu" class="form-input" rows="3" placeholder="Nhập lý do phản hồi..."></textarea>
            
            <div style="display:flex; gap:10px; justify-content:flex-end;">
                <button type="button" class="btn-action btn-reject" onclick="closeReviewModal()">Hủy</button>
                <button type="submit" id="modalSubmitBtn" class="btn-action btn-approve">Xác nhận</button>
            </div>
        </form>
    </div>
</div>

<script>
    function openReviewModal(id, status) {
        document.getElementById('modalYcId').value = id;
        document.getElementById('modalTrangThai').value = status;
        document.getElementById('modalTitle').innerText = status === 'DaDuyet' ? 'Phê duyệt yêu cầu' : 'Từ chối yêu cầu';
        
        const submitBtn = document.getElementById('modalSubmitBtn');
        if(status === 'DaDuyet') {
            submitBtn.className = 'btn-action btn-approve';
            submitBtn.innerText = 'Chấp nhận';
        } else {
            submitBtn.className = 'btn-action btn-reject';
            submitBtn.innerText = 'Từ chối';
        }
        
        document.getElementById('reviewModal').style.display = 'flex';
    }

    function closeReviewModal() {
        document.getElementById('reviewModal').style.display = 'none';
    }

    window.onclick = function(event) {
        const modal = document.getElementById('reviewModal');
        if (event.target == modal) {
            closeReviewModal();
        }
    }
</script>
