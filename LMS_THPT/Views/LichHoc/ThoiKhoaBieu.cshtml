@model List<LMS_THPT.Models.LichHoc>
@{
    ViewData["Title"] = "Quản lý Lịch Học";
    var lops = ViewBag.Lops as List<LMS_THPT.Models.Lop>;
    var selectedLopId = Context.Request.Query["lopId"].ToString();
    var leaves = ViewBag.Leaves as List<LMS_THPT.Models.YeuCauGiaoVien>;
    
    DateTime selectedDate = DateTime.Parse(ViewBag.SelectedDate);
    string dayOfWeekStr = "";
    switch (selectedDate.DayOfWeek)
    {
        case DayOfWeek.Monday: dayOfWeekStr = "Thứ Hai"; break;
        case DayOfWeek.Tuesday: dayOfWeekStr = "Thứ Ba"; break;
        case DayOfWeek.Wednesday: dayOfWeekStr = "Thứ Tư"; break;
        case DayOfWeek.Thursday: dayOfWeekStr = "Thứ Năm"; break;
        case DayOfWeek.Friday: dayOfWeekStr = "Thứ Sáu"; break;
        case DayOfWeek.Saturday: dayOfWeekStr = "Thứ Bảy"; break;
        case DayOfWeek.Sunday: dayOfWeekStr = "Chủ Nhật"; break;
    }
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<style>
    /* 
     * MONOCHROME MINIMALIST STYLE 
     */
    .bw-card {
        background: #ffffff;
        padding: 24px;
        border: 1px solid #111111;
        border-radius: 8px;
        box-shadow: 4px 4px 0px rgba(0,0,0,1);
        margin-bottom: 24px;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .period-item {
        display: flex;
        border-bottom: 1px solid #e0e0e0;
        padding: 20px 0;
        transition: background-color 0.2s ease;
    }
    
    .period-item:hover {
        background-color: #fafafa;
    }

    .period-item:last-child {
        border-bottom: none;
    }

    .period-num {
        width: 85px;
        font-weight: 800;
        color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #000000;
        border-radius: 0px;
        margin-right: 25px;
        font-size: 13px;
        letter-spacing: 1px;
        text-transform: uppercase;
        flex-shrink: 0;
    }

    .lesson-card {
        background: #ffffff;
        border-left: 4px solid #000000;
        padding: 16px 20px;
        border-radius: 0;
        border-top: 1px solid #eeeeee;
        border-right: 1px solid #eeeeee;
        border-bottom: 1px solid #eeeeee;
    }

    .lesson-title {
        font-weight: 900;
        color: #000000;
        font-size: 18px;
        margin-bottom: 6px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .lesson-info {
        font-size: 13px;
        color: #555555;
        font-weight: 500;
    }

    .leave-badge {
        display: inline-block;
        background: #000000;
        color: #ffffff;
        padding: 6px 12px;
        border-radius: 0;
        font-size: 11px;
        font-weight: 800;
        margin-top: 12px;
        letter-spacing: 1px;
    }

    .bw-btn {
        background: #000000;
        color: #ffffff;
        border: 1px solid #000000;
        border-radius: 0px;
        font-weight: 700;
        text-transform: uppercase;
        padding: 10px 16px;
        font-size: 12px;
        letter-spacing: 1px;
        transition: all 0.2s ease;
    }

    .bw-btn:hover {
        background: #ffffff;
        color: #000000;
        box-shadow: 2px 2px 0px #000000;
    }

    .bw-btn-outline {
        background: transparent;
        color: #000000;
        border: 1px solid #000000;
        border-radius: 0px;
        box-shadow: 2px 2px 0px #000000;
        font-weight: 700;
        transition: all 0.2s ease;
    }
    
    .bw-btn-outline:hover {
        background: #000000;
        color: #ffffff;
        box-shadow: none;
    }

    /* CẢI THIỆN GIAO DIỆN LỊCH (FLATPICKR) */
    .flatpickr-calendar {
        width: 100% !important;
        box-shadow: 4px 4px 0px rgba(0,0,0,1) !important;
        border: 2px solid #000000 !important;
        border-radius: 6px !important;
        font-family: inherit;
        padding: 10px;
    }
    
    .flatpickr-month {
        color: #000 !important;
        font-weight: 800 !important;
        text-transform: uppercase;
        margin-bottom: 10px;
    }
    
    .flatpickr-current-month {
        font-size: 110% !important;
    }

    .flatpickr-weekdays {
        display: grid !important;
        grid-template-columns: repeat(7, 1fr) !important;
        border-bottom: 2px solid #000;
        margin-bottom: 15px;
        padding-bottom: 5px;
        width: 100% !important;
    }
    
    .flatpickr-weekdaycontainer {
        display: contents !important;
    }

    span.flatpickr-weekday {
        width: 100% !important;
        max-width: 100% !important;
        color: #000 !important;
        font-weight: 900 !important;
        font-size: 12px;
    }
    
    .flatpickr-day {
        width: 100% !important;
        max-width: 100% !important;
        height: 38px !important;
        line-height: 38px !important;
        margin: 0 !important;
        color: #333 !important;
        font-weight: 700 !important;
        border-radius: 4px !important;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .flatpickr-day:hover {
        background: #f5f5f5 !important;
        border-color: #ddd !important;
    }

    .flatpickr-day.selected {
        background: #000000 !important;
        color: #ffffff !important;
        border-color: #000000 !important;
        box-shadow: 2px 2px 0px rgba(0,0,0,0.3) !important;
        transform: scale(1.05);
        border-radius: 6px !important;
        z-index: 2;
    }
    
    .flatpickr-day.today {
        border: 2px dashed #000000 !important;
    }

    .flatpickr-innerContainer, .flatpickr-rContainer, .flatpickr-days {
        width: 100% !important;
        min-width: 100% !important;
        max-width: 100% !important;
        display: block !important;
    }
    
    .dayContainer {
        display: grid !important;
        grid-template-columns: repeat(7, 1fr) !important;
        width: 100% !important;
        min-width: 100% !important;
        max-width: 100% !important;
        gap: 6px 0px;
    }
    
    .empty-period {
        color: #999999;
        font-style: italic;
        font-size: 14px;
        font-weight: 500;
    }
    
    .view-header {
        font-size: 28px;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: -0.5px;
        border-bottom: 4px solid #000000;
        padding-bottom: 12px;
        margin-bottom: 24px;
    }
</style>

<div class="container-fluid py-4">
    <!-- NÚT QUAY LẠI -->
    <a href="@Url.Action("Index", "Admin")" class="bw-btn text-decoration-none mb-4 d-inline-flex align-items-center gap-2">
        <i class="fa-solid fa-arrow-left"></i> TRỞ VỀ DASHBOARD
    </a>

    <div class="row">
        <!-- BẢNG ĐIỀU KHIỂN & LỊCH -->
        <div class="col-md-4 col-lg-4">
            <h1 class="view-header">Bộ Lọc TKB</h1>
            
            <div class="bw-card mb-4">
                <h5 class="fw-bold mb-4" style="text-transform: uppercase; font-size: 14px; letter-spacing: 1px;">1. Chọn lớp học</h5>
                
                <form method="get" id="filterForm">
                    <div class="mb-4">
                        <select name="lopId" class="form-select border-black rounded-0 shadow-none" style="border: 1px solid #000; padding: 12px;" onchange="document.getElementById('filterForm').submit()">
                            <option value="">-- CHỌN LỚP --</option>
                            @if (lops != null)
                            {
                                foreach (var lop in lops)
                                {
                                    <option value="@lop.Id" selected="@(selectedLopId == lop.Id.ToString())">LỚP @lop.TenLop</option>
                                }
                            }
                        </select>
                    </div>
                    
                    <div class="mb-2">
                        <h5 class="fw-bold mb-3 mt-4" style="text-transform: uppercase; font-size: 14px; letter-spacing: 1px;">2. Chọn Ngày áp dụng</h5>
                        <input type="hidden" name="date" id="selectedDate" value="@ViewBag.SelectedDate" />
                        <div id="inlineCalendar"></div>
                    </div>
                </form>
            </div>
            
            <div class="bw-card border-0 mb-4" style="background:#f9f9f9; border: 1px solid #ddd !important; box-shadow: none;">
                <h6 class="fw-bold text-dark mb-3" style="text-transform: uppercase; font-size: 13px;"><i class="fa-solid fa-file-excel me-2"></i>Nhập thời khóa biểu từ Excel</h6>
                <form asp-action="ImportExcel" method="post" enctype="multipart/form-data">
                    <input type="hidden" name="lopId" value="@selectedLopId" />
                    <input type="file" name="file" class="form-control rounded-0 mb-3" style="border: 1px dashed #999; font-size: 12px;" accept=".xlsx, .xls" required />
                    <button type="submit" class="bw-btn w-100" @(string.IsNullOrEmpty(selectedLopId) ? "disabled" : "")>Tải Dữ Liệu Lên</button>
                </form>
                <a href="~/templates/Template_ThoiKhoaBieu.xlsx" class="d-block text-center mt-3 text-dark text-decoration-underline" style="font-size:12px; font-weight:600;">Tải Form Mẫu</a>
            </div>
        </div>
        
        <!-- CHI TIẾT LỊCH TRONG NGÀY -->
        <div class="col-md-8 col-lg-8">
            <h1 class="view-header text-end">Chi Tiết Ngày</h1>
            
            @if (string.IsNullOrEmpty(selectedLopId))
            {
                <div class="bw-card d-flex align-items-center p-5 text-center justify-content-center" style="min-height: 300px; border-style: dashed;">
                    <div>
                        <h4 class="fw-bold mb-2">BẠN CHƯA QUYẾT ĐỊNH LỚP HỌC</h4>
                        <p class="m-0 text-muted">Vui lòng điều hướng bằng thẻ chọn lớp phía bên trái giao diện.</p>
                    </div>
                </div>
            }
            else
            {
                <div class="bw-card timeline">
                    <div class="d-flex justify-content-between align-items-end mb-4 border-bottom pb-4 border-black">
                        <div>
                            <h3 class="fw-bold mb-1" style="text-transform:uppercase; font-size: 22px;">HIỂN THỊ LỊCH NGÀY @selectedDate.ToString("dd/MM/yyyy")</h3>
                            <p class="text-muted m-0 fw-bold" style="letter-spacing:2px; text-transform:uppercase; font-size: 14px;">@dayOfWeekStr</p>
                        </div>
                    </div>
                    
                    <div class="timeline-body">
                        @for (int i = 1; i <= 10; i++)
                        {
                            var lesson = Model?.FirstOrDefault(l => l.TietHoc == i);
                            var leave = lesson != null && leaves != null ? leaves.FirstOrDefault(y => y.MaGiaoVien == lesson.GiaoVienId && y.TuTiet <= i && y.DenTiet >= i) : null;
                            
                            <div class="period-item">
                                <div class="period-num">TIẾT @i</div>
                                <div class="period-content w-100">
                                    @if (lesson != null)
                                    {
                                        <div class="lesson-card w-100">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <div>
                                                    <div class="lesson-title">@lesson.MonHoc?.TenMonHoc</div>
                                                    <div class="lesson-info">
                                                        <span><b style="color: #000;">GV:</b> @lesson.GiaoVien?.HoTen</span> &nbsp;|&nbsp;
                                                        <span><b style="color: #000;">PHÒNG:</b> @lesson.PhongHoc</span>
                                                    </div>
                                                    @if(leave != null)
                                                    {
                                                        <div class="leave-badge"><i class="fa-solid fa-ban me-2"></i>GIÁO VIÊN ĐÃ ĐƯỢC DUYỆT NGHỈ PHÉP</div>
                                                    }
                                                </div>
                                                <div class="d-flex gap-2">
                                                    <a asp-action="Edit" asp-route-id="@lesson.Id" asp-route-date="@selectedDate.ToString("yyyy-MM-dd")" class="bw-btn-outline px-3 py-2 text-decoration-none" style="font-size: 12px; display:inline-flex; align-items:center;" title="Ghi đè thông tin"><i class="fa-solid fa-pen"></i></a>
                                                    <form asp-action="Delete" asp-route-id="@lesson.Id" asp-route-date="@selectedDate.ToString("yyyy-MM-dd")" method="post" style="display:inline;">
                                                        <button class="bw-btn-outline px-3 py-2" style="font-size: 12px; display:inline-flex; align-items:center;" title="Hủy tiết định dạng" onclick="return confirm('Toàn quyền XÓA TIẾT HỌC này?');"><i class="fa-solid fa-trash"></i></button>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="empty-period d-flex justify-content-between align-items-center w-100" style="padding-left: 10px;">
                                            <span>(Khoảng thời gian trống)</span>
                                            <a asp-action="Create" asp-route-thu="@((int)selectedDate.DayOfWeek == 0 ? 8 : (int)selectedDate.DayOfWeek + 1)" asp-route-tietHoc="@i" asp-route-lopId="@selectedLopId" asp-route-date="@selectedDate.ToString("yyyy-MM-dd")" class="bw-btn text-decoration-none">THÊM MỚI</a>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://npmcdn.com/flatpickr/dist/l10n/vn.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var selectedDate = document.getElementById('selectedDate').value;
            
            flatpickr("#inlineCalendar", {
                inline: true,
                defaultDate: selectedDate,
                locale: "vn",
                dateFormat: "Y-m-d",
                onChange: function(selectedDates, dateStr, instance) {
                    document.getElementById('selectedDate').value = dateStr;
                    document.getElementById('filterForm').submit();
                }
            });
        });
    </script>
}