@using Microsoft.AspNetCore.Mvc.Rendering
@model LMS_THPT.Models.MonHoc

@{
    ViewData["Title"] = "Chi tiết môn học";
}

<div class="lms-page">

    <!-- HEADER -->
    <div class="lms-header">
        <div>
            <h2> @Model.TenMonHoc</h2>
            <p>Quản lý giáo viên & phân công lớp học</p>
        </div>

        <a asp-action="Index" class="btn-back">← Quay lại</a>
    </div>

    <!-- NOTIFICATION -->
    @if (TempData["Success"] != null)
    {
        <div class="alert success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert error">@TempData["Error"]</div>
    }

    <div class="grid">

        <!-- LEFT: LIST -->
        <div class="card">

            <div class="card-header">
                <div> Giáo viên đang phân công</div>
            </div>

            <div class="card-body">

                @if (Model.MonHocGiaoViens != null && Model.MonHocGiaoViens.Any())
                {
                    <div class="list">

                        @foreach (var gv in Model.MonHocGiaoViens
                            .GroupBy(x => x.GiaoVien))
                        {
                            <div class="teacher-item">

                                <div class="info">
                                    <div class="name">
                                        @(gv.Key?.HoTen ?? "Không rõ")
                                    </div>

                                    <div class="meta">
                                        Giáo viên
                                        <br />

                                        →
                                        @string.Join(", ",
                                            gv.Where(x => x.Lop != null)
                                              .Select(x => x.Lop.TenLop)
                                              .Distinct()
                                        )
                                    </div>
                                </div>

                                <!-- NÚT XÓA TOÀN BỘ PHÂN CÔNG -->
                                <form asp-action="RemoveGiaoVien" method="post"
                                      onsubmit="return confirm('Xóa toàn bộ phân công của giáo viên này?');">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden" name="monHocId" value="@Model.Id" />
                                    <input type="hidden" name="nguoiDungId" value="@gv.Key.Id" />

                                    <button class="btn-delete">Xóa tất cả</button>

                                </form>

                            </div>
                        }

                    </div>
                }
                else
                {
                    <div class="empty">Chưa có giáo viên được phân công</div>
                }

            </div>
        </div>

        <!-- RIGHT: ADD FORM -->
        <div class="card">

            <div class="card-header">
                ➕ Thêm giáo viên
            </div>

            <div class="card-body">

                <form asp-action="AddGiaoVien" method="post" class="form">

                    <input type="hidden" name="monHocId" value="@Model.Id" />

                    <label>Giáo viên</label>
                    <select name="nguoiDungId" required>
                        <option value="">-- Chọn giáo viên --</option>
                        @foreach (var it in (ViewBag.GiaoViens as IEnumerable<SelectListItem>) ?? Enumerable.Empty<SelectListItem>())
                        {
                            <option value="@it.Value">@it.Text</option>
                        }
                    </select>

                    <label>Lớp</label>
                    <select name="lopIds" multiple class="multi-select">
                        <option value="">Không phân lớp</option>
                        @foreach (var it in (ViewBag.Lops as IEnumerable<SelectListItem>) ?? Enumerable.Empty<SelectListItem>())
                        {
                            <option value="@it.Value">@it.Text</option>
                        }
                    </select>

                    <button class="btn-primary">+ Thêm giáo viên</button>

                </form>

                <div class="hint">
                    Chọn giáo viên và lớp để phân công giảng dạy
                </div>

            </div>

        </div>

    </div>

</div>