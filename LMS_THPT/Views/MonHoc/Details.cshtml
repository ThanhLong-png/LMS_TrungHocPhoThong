@using Microsoft.AspNetCore.Mvc.Rendering
@model LMS_THPT.Models.MonHoc

<h2 class="mb-4 fw-bold">@Model.TenMonHoc</h2>

<div class="mb-3">
    <a asp-action="Index" class="btn btn-outline-secondary">← Quay lại</a>
</div>

<!-- Thông báo -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<!-- Danh sách -->
<div class="card mb-4">
    <div class="card-header bg-white fw-bold">Giáo viên đã thêm</div>
    <div class="card-body p-0">
        <table class="table mb-0 align-middle">
            <thead class="border-bottom">
                <tr>
                    <th class="py-3">Họ tên</th>
                    <th class="py-3">Chức vụ</th>
                    <th class="py-3">Lớp</th>
                    <th class="py-3"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var mg in Model.MonHocGiaoViens ?? Enumerable.Empty<LMS_THPT.Models.MonHocGiaoVien>())
                {
                    <tr>
                        <td class="py-3">@(mg.GiaoVien?.HoTen ?? "-")</td>
                        <td class="py-3">@(mg.GiaoVien?.ChucVu ?? "-")</td>
                        <td class="py-3">@(mg.Lop?.TenLop ?? "-")</td>
                        <td class="py-3 text-end">
                            <form asp-action="RemoveGiaoVien" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn xóa giáo viên này khỏi môn học?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="monHocId" value="@Model.Id" />
                                <input type="hidden" name="nguoiDungId" value="@mg.NguoiDungId" />
                                <input type="hidden" name="lopId" value="@(mg.LopId?.ToString() ?? "")" />
                                <button type="submit" class="btn btn-sm btn-dark">Xóa</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<style>
    /* Giao diện đen trắng cho trang Details (khung, bảng, nút) */
    .card {
        background: #fff;
        border: 1px solid #e6e6e6;
        border-radius: 8px;
        box-shadow: none;
    }

    .card-header, .card-header.bg-white {
        background: #f8f8f8 !important;
        color: #000;
        border-bottom: 1px solid #e6e6e6;
        font-weight: 700;
    }

    .card-body {
        background: #fff;
        color: #000;
        padding: 16px;
    }

    .table {
        color: #000;
        margin-bottom: 0;
    }

    .table th {
        font-weight: 700;
        color: #000;
        border-bottom: 1px solid #eee;
    }

    .table td {
        border-top: 1px solid #f5f5f5;
        color: #000;
    }

    /* Nút đen với chữ trắng */
    .btn-sm.btn-dark, .btn-dark {
        background: #111;
        border-color: #111;
        color: #fff;
    }

    /* Nút quay lại nhẹ nhàng */
    a.btn.btn-outline-secondary {
        color: #111;
        border-color: #ddd;
        background: #fff;
    }
</style>

<!-- Form -->
<div class="card">
    <div class="card-header fw-bold">Thêm giáo viên</div>

    <div class="card-body">
        <form asp-action="AddGiaoVien" method="post">
            <input type="hidden" name="monHocId" value="@Model.Id" />

            <div class="row g-3">
                <div class="col-md-4">
                    <select name="nguoiDungId" class="form-select" required>
                        <option value="">-- Chọn giáo viên --</option>
                        @{
                            var gvs = ViewBag.GiaoViens as IEnumerable<SelectListItem>;
                            if (gvs != null)
                            {
                                foreach (var it in gvs)
                                {
                                    <option value="@it.Value">@it.Text</option>
                                }
                            }
                        }
                    </select>
                </div>

                <div class="col-md-3">
                    <select name="lopId" class="form-select">
                        <option value="">Không phân lớp</option>
                        @{
                            var lps = ViewBag.Lops as IEnumerable<SelectListItem>;
                            if (lps != null)
                            {
                                foreach (var it in lps)
                                {
                                    <option value="@it.Value">@it.Text</option>
                                }
                            }
                        }
                    </select>
                </div>

                <!-- removed multi-select for monHocIds (moved to create-teacher page) -->

                <div class="col-md-2">
                    <button class="btn btn-dark w-100">Thêm</button>
                </div>
            </div>
            <div class="form-text mt-2">Chọn một hoặc nhiều môn để thêm giáo viên vào các môn đó.</div>
        </form>
    </div>
</div>@using Microsoft.AspNetCore.Mvc.Rendering
@model LMS_THPT.Models.MonHoc

@{
    ViewData["Title"] = "Chi tiết môn học";
}

<div class="lms-page">

    <!-- HEADER -->
    <div class="lms-header">
        <div>
            <h2> @Model.TenMonHoc</h2>
            <p>Quản lý giáo viên & phân công lớp học</p>
        </div>

        <a asp-action="Index" class="btn-back">← Quay lại</a>
    </div>

    <!-- NOTIFICATION -->
    @if (TempData["Success"] != null)
    {
        <div class="alert success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert error">@TempData["Error"]</div>
    }

    <div class="grid">

        <!-- LEFT: LIST -->
        <div class="card">

            <div class="card-header">
                <div> Giáo viên đang phân công</div>
            </div>

            <div class="card-body">

                @if (Model.MonHocGiaoViens != null && Model.MonHocGiaoViens.Any())
                {
                    <div class="list">

                        @foreach (var gv in Model.MonHocGiaoViens
                            .GroupBy(x => x.GiaoVien))
                        {
                            <div class="teacher-item">

                                <div class="info">
                                    <div class="name">
                                        @(gv.Key?.HoTen ?? "Không rõ")
                                    </div>

                                    <div class="meta">
                                        Giáo viên
                                        <br />

                                        →
                                        @string.Join(", ",
                                            gv.Where(x => x.Lop != null)
                                              .Select(x => x.Lop.TenLop)
                                              .Distinct()
                                        )
                                    </div>
                                </div>

                                <!-- NÚT XÓA TOÀN BỘ PHÂN CÔNG -->
                                <form asp-action="RemoveGiaoVien" method="post"
                                      onsubmit="return confirm('Xóa toàn bộ phân công của giáo viên này?');">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden" name="monHocId" value="@Model.Id" />
                                    <input type="hidden" name="nguoiDungId" value="@gv.Key.Id" />

                                    <button class="btn-delete">Xóa tất cả</button>

                                </form>

                            </div>
                        }

                    </div>
                }
                else
                {
                    <div class="empty">Chưa có giáo viên được phân công</div>
                }

            </div>
        </div>

        <!-- RIGHT: ADD FORM -->
        <div class="card">

            <div class="card-header">
                ➕ Thêm giáo viên
            </div>

            <div class="card-body">

                <form asp-action="AddGiaoVien" method="post" class="form">

                    <input type="hidden" name="monHocId" value="@Model.Id" />

                    <label>Giáo viên</label>
                    <select name="nguoiDungId" required>
                        <option value="">-- Chọn giáo viên --</option>
                        @foreach (var it in (ViewBag.GiaoViens as IEnumerable<SelectListItem>) ?? Enumerable.Empty<SelectListItem>())
                        {
                            <option value="@it.Value">@it.Text</option>
                        }
                    </select>

                    <label>Lớp</label>
                    <select name="lopIds" multiple class="multi-select">
                        <option value="">Không phân lớp</option>
                        @foreach (var it in (ViewBag.Lops as IEnumerable<SelectListItem>) ?? Enumerable.Empty<SelectListItem>())
                        {
                            <option value="@it.Value">@it.Text</option>
                        }
                    </select>

                    <button class="btn-primary">+ Thêm giáo viên</button>

                </form>

                <div class="hint">
                    Chọn giáo viên và lớp để phân công giảng dạy
                </div>

            </div>

        </div>

    </div>

</div>