@model IEnumerable<LMS_THPT.Models.ThongBao>

@{
    ViewData["Title"] = "Quản lý thông báo";
}

<style>
    :root {
        --black: #111;
        --gray: #6b7280;
        --border: #e5e7eb;
        --bg: #f9fafb;
        --white: #fff;
        --radius: 12px;
    }

    .page {
        background: var(--bg);
        min-height: 100vh;
        padding: 2rem;
    }

    .header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
    }

        .header h2 {
            font-size: 1.4rem;
            font-weight: 600;
            color: var(--black);
        }

    .btn-create {
        background: var(--black);
        color: #fff;
        padding: 0.5rem 1rem;
        border-radius: 8px;
        text-decoration: none;
        font-size: 0.85rem;
    }

    .card {
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        overflow: hidden;
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    thead {
        background: var(--black);
    }

        thead th {
            color: #fff;
            font-size: 0.75rem;
            text-transform: uppercase;
            padding: 0.8rem;
            text-align: left;
        }

    tbody tr {
        border-bottom: 1px solid var(--border);
    }

        tbody tr:hover {
            background: #f3f4f6;
        }

    td {
        padding: 0.75rem;
        font-size: 0.85rem;
        color: #374151;
    }

    .title {
        font-weight: 600;
        color: var(--black);
    }

    .date {
        font-size: 0.75rem;
        color: var(--gray);
    }

    .badge {
        padding: 0.2rem 0.6rem;
        border-radius: 50px;
        font-size: 0.7rem;
        font-weight: 600;
    }

    .show {
        background: #d1fae5;
        color: #065f46;
    }

    .hide {
        background: #fee2e2;
        color: #991b1b;
    }

    .actions a {
        margin-right: 0.4rem;
        text-decoration: none;
        font-size: 0.75rem;
        color: var(--black);
    }

    .empty {
        text-align: center;
        padding: 2rem;
        color: var(--gray);
    }
    .header-actions {
    display: flex;
    gap: 0.5rem;
    align-items: center;
}
</style>

<div class="page">

    <div class="header">
        <h2>📢 Quản lý thông báo</h2>

        <div class="header-actions">
            <a asp-controller="Admin" asp-action="Index" class="btn-back">← Quay lại</a>
            <a asp-action="Create" class="btn-create">+ Tạo thông báo</a>
        </div>
    </div>

    <div class="card">
        <table>
            <thead>
                <tr>
                    <th>Tiêu đề</th>
                    <th>Ngày đăng</th>
                    <th>Trạng thái</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>

                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="4">
                            <div class="empty">Không có thông báo</div>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var tb in Model)
                    {
                        <tr>
                            <td class="title">@tb.TieuDe</td>
                            <td class="date">@tb.NgayDang.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                @if (tb.HienThi)
                                {
                                    <span class="badge show">Hiển thị</span>
                                }
                                else
                                {
                                    <span class="badge hide">Ẩn</span>
                                }
                            </td>
                            <td class="actions">

                                <!-- Toggle -->
                                <form asp-action="ToggleHienThi" asp-route-id="@tb.Id" method="post" style="display:inline">
                                    <button type="submit" class="btn-action">
                                        @(tb.HienThi ? "Ẩn" : "Hiển thị")
                                    </button>
                                </form>

                                <!-- Delete -->
                                <form asp-action="Delete" asp-route-id="@tb.Id" method="post" style="display:inline"
                                      onsubmit="return confirm('Xóa thông báo này?');">
                                    <button type="submit" class="btn-delete">Xóa</button>
                                </form>

                            </td>
                        </tr>
                    }
                }

            </tbody>
        </table>
    </div>

</div>