@model LMS_THPT.Models.ThongBao

@{
    ViewData["Title"] = "Tạo thông báo";
}

<style>
    :root {
        --black: #111;
        --gray: #6b7280;
        --border: #e5e7eb;
        --bg: #f4f6f8;
        --white: #fff;
        --radius: 14px;
    }

    .form-page {
        background: var(--bg);
        min-height: 100vh;
        padding: 2rem;
        display: flex;
        justify-content: center;
        align-items: flex-start;
    }

    .form-card {
        width: 100%;
        max-width: 650px;
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 2rem;
        box-shadow: 0 10px 25px rgba(0,0,0,0.05);
        transition: 0.2s;
    }

        .form-card:hover {
            transform: translateY(-2px);
        }

    .top-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.2rem;
    }

    .btn-back {
        font-size: 0.85rem;
        color: var(--gray);
        text-decoration: none;
        transition: 0.2s;
    }

        .btn-back:hover {
            color: var(--black);
        }

    h2 {
        font-size: 1.4rem;
        color: var(--black);
        margin: 0;
    }

    .form-group {
        margin-bottom: 1.2rem;
    }

    label {
        font-size: 0.8rem;
        font-weight: 600;
        color: var(--gray);
        display: block;
        margin-bottom: 0.4rem;
    }

    input, textarea {
        width: 100%;
        border: 1px solid var(--border);
        border-radius: 10px;
        padding: 0.65rem;
        font-size: 0.9rem;
        transition: 0.2s;
        background: #fff;
    }

        input:focus, textarea:focus {
            outline: none;
            border-color: var(--black);
            box-shadow: 0 0 0 3px rgba(17,17,17,0.08);
        }

    textarea {
        min-height: 140px;
        resize: vertical;
    }

    .form-check {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-top: 0.5rem;
        font-size: 0.85rem;
        color: var(--gray);
    }

        .form-check input {
            width: auto;
        }

    .btn-submit {
        width: 100%;
        background: var(--black);
        color: white;
        border: none;
        padding: 0.75rem;
        border-radius: 10px;
        font-size: 0.9rem;
        font-weight: 600;
        cursor: pointer;
        transition: 0.2s;
        margin-top: 1rem;
    }

        .btn-submit:hover {
            background: #000;
            transform: translateY(-1px);
        }

        .btn-submit:active {
            transform: scale(0.99);
        }
</style>

<div class="form-page">

    <div class="form-card">

        <div class="top-bar">
            <a asp-action="Index" class="btn-back">← Quay lại</a>
        </div>

        <h2>📢 Tạo thông báo</h2>

        <form asp-action="Create" method="post">

            <div class="form-group">
                <label>Tiêu đề</label>
                <input asp-for="TieuDe" placeholder="Nhập tiêu đề thông báo..." />
            </div>

            <div class="form-group">
                <label>Nội dung</label>
                <textarea asp-for="NoiDung" placeholder="Nhập nội dung thông báo..."></textarea>
            </div>

            <div class="form-check">
                <input asp-for="HienThi" type="checkbox" />
                <label>Hiển thị ngay</label>
            </div>

            <button type="submit" class="btn-submit">
                Đăng thông báo
            </button>

        </form>

    </div>

</div>