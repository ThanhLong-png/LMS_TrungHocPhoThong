@model List<LMS_THPT.ViewModels.NhapDiemItem>
@{
    ViewData["Title"] = "Quản lý điểm số";
    ViewData["PageTitle"] = "Điểm số theo lớp";
    ViewData["ActivePage"] = "DiemSo";
    
    var lopMonHocs = ViewBag.LopMonHocs as List<LMS_THPT.Models.LopMonHoc> ?? new List<LMS_THPT.Models.LopMonHoc>();
    var allLopMonHocs = ViewBag.AllLopMonHocs as List<LMS_THPT.Models.LopMonHoc> ?? lopMonHocs;
    var danhSachKhoi = ViewBag.DanhSachKhoi as List<LMS_THPT.Models.Khoi> ?? new List<LMS_THPT.Models.Khoi>();
    var khoiId = (int)(ViewBag.KhoiHienTai ?? 0);
    var lopId = (int)(ViewBag.LopHienTai ?? 0);
    var monHocId = (int)(ViewBag.MonHocHienTai ?? 0);
}


<style>
    .page-header {
        background: linear-gradient(135deg, #1a1f36 0%, #3730a3 100%);
        border-radius: 16px; padding: 1.6rem 2rem;
        color: #fff; margin-bottom: 1.5rem;
        position: relative; overflow: hidden;
    }
    .page-header::after {
        content: ''; position: absolute;
        top: -30%; right: -5%; width: 200px; height: 200px;
        border-radius: 50%; background: rgba(255,255,255,.06);
    }
    /* ── Khối tabs ── */
    .khoi-tab-bar {
        display: flex; gap: 8px; flex-wrap: wrap;
        margin-bottom: 1rem;
    }
    .khoi-tab {
        display: inline-flex; align-items: center; gap: 6px;
        padding: 8px 20px; border-radius: 999px;
        font-size: 0.88rem; font-weight: 600;
        text-decoration: none; transition: all .18s;
        border: 2px solid #e2e8f0; color: #475569; background: #fff;
    }
    .khoi-tab:hover { border-color: #6366f1; color: #6366f1; background: #eef2ff; }
    .khoi-tab.active {
        background: linear-gradient(135deg, #4f46e5, #7c3aed);
        color: #fff; border-color: transparent;
        box-shadow: 0 4px 12px rgba(79,70,229,0.3);
    }
    /* ── Lớp tabs ── */
    .lop-khoi-bar {
        display: flex; gap: 6px; flex-wrap: wrap;
        padding: 12px 16px;
        background: #f8fafc;
        border-radius: 12px;
        margin-bottom: 1.2rem;
    }
    .lop-khoi-tab {
        display: inline-flex; align-items: center; gap: 5px;
        padding: 6px 16px; border-radius: 8px;
        font-size: 0.85rem; font-weight: 500;
        text-decoration: none; transition: all .15s;
        color: #475569; border: 1.5px solid #e2e8f0; background: #fff;
    }
    .lop-khoi-tab:hover { border-color: #6366f1; color: #6366f1; }
    .lop-khoi-tab.active { background: #6366f1; color: #fff; border-color: #6366f1; font-weight: 600; }
</style>

<div class="page-header">
    <div class="d-flex align-items-center gap-3" style="position:relative;z-index:1;">
        <div style="font-size:2.2rem;"></div>
        <div>
            <h1 class="fw-bold mb-0" style="font-size:1.5rem;">Quản lý điểm số</h1>
            <p class="mb-0 opacity-75" style="font-size:.88rem;">
                @if (!string.IsNullOrEmpty(ViewBag.TenLopHienTai as string))
                { <text>Lớp <strong>@ViewBag.TenLopHienTai</strong> &middot; Môn <strong>@ViewBag.TenMonHienTai</strong></text> }
                else { <text>Chọn lớp và môn học để xem bảng điểm</text> }
            </p>
        </div>
    </div>
</div>

@* ── Bộ lọc Khối ── *@
@if (danhSachKhoi.Any())
{
    <div class="khoi-tab-bar">
        @foreach (var khoi in danhSachKhoi)
        {
            <a asp-action="QuanLyDiemSo" asp-route-khoiId="@khoi.Id"
               class="khoi-tab @(khoi.Id == khoiId ? "active" : "")">
                 @khoi.TenKhoi
            </a>
        }
    </div>
}

@* ── Bộ lọc Lớp trong khối ── *@
@{
    var lopsOfKhoi = lopMonHocs
        .Where(x => x.Lop != null)
        .Select(x => x.Lop!)
        .DistinctBy(l => l.Id)
        .OrderBy(l => l.TenLop)
        .ToList();
}
@if (lopsOfKhoi.Any())
{
    <div class="lop-khoi-bar">
        <span style="font-size:0.82rem;font-weight:600;color:#64748b;align-self:center;"> Lớp:</span>
        @foreach (var lop in lopsOfKhoi)
        {
            var firstMon = lopMonHocs.FirstOrDefault(x => x.LopId == lop.Id);
            <a asp-action="QuanLyDiemSo"
               asp-route-khoiId="@khoiId"
               asp-route-lopId="@lop.Id"
               asp-route-monHocId="@(lop.Id == lopId ? monHocId : firstMon?.MonHocId ?? 0)"
               class="lop-khoi-tab @(lop.Id == lopId ? "active" : "")">
                @lop.TenLop
            </a>
        }
    </div>
}

@* ── Tab chọn môn (theo lớp đang chọn) ── *@
@{
    var monsOfLopDs = lopMonHocs
        .Where(x => x.LopId == lopId && x.MonHoc != null)
        .Select(x => x.MonHoc!)
        .ToList();
}
@if (monsOfLopDs.Count > 1)
{
    <div style="display:flex;gap:6px;flex-wrap:wrap;margin-bottom:1.2rem;padding:10px 14px;background:#eff6ff;border-radius:12px;">
        <span style="font-size:0.82rem;font-weight:600;color:#1d4ed8;align-self:center;"> Môn:</span>
        @foreach (var mon in monsOfLopDs)
        {
            <a asp-action="QuanLyDiemSo"
               asp-route-khoiId="@khoiId"
               asp-route-lopId="@lopId"
               asp-route-monHocId="@mon.Id"
               style="display:inline-flex;align-items:center;padding:5px 14px;border-radius:8px;font-size:0.85rem;font-weight:500;text-decoration:none;transition:all .15s;border:1.5px solid @(mon.Id == monHocId ? "transparent" : "#bfdbfe");background:@(mon.Id == monHocId ? "#1d4ed8" : "#fff");color:@(mon.Id == monHocId ? "#fff" : "#1d4ed8");">
                @mon.TenMonHoc
            </a>
        }
    </div>
}

<div class="card mb-16">
    <div class="card-header">
        <span class="card-title">Bảng điểm lớp @ViewBag.TenLopHienTai - Môn @ViewBag.TenMonHienTai</span>
    </div>
    <div class="table-wrap">
        @Html.AntiForgeryToken()
        <table>
            <thead>
                <tr>
                    <th>Học sinh</th>
                    <th width="80">Miệng 1</th>
                    <th width="80">Miệng 2</th>
                    <th width="80">Miệng 3</th>
                    <th width="80">Miệng 4</th>
                    <th width="120">Giữa kỳ(40%)</th>
                    <th width="120">Cuối kỳ(60%)</th>
                    <th width="120">Tổng kết</th>
                    <th>Xếp loại</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var g in Model)
                {
                    <tr data-hs-id="@g.HocSinhId" data-mon-hoc-id="@monHocId">
                        <td class="fw-medium">@g.TenHocSinh</td>
                        <td>
                            <input type="number" class="input-inline dm1-input" value="@g.DiemMieng" min="0" max="10" step="0.1" placeholder="--" onchange="tinhTongKet(this)" onblur="autoLuuDiem(this)"/>
                        </td>
                        <td>
                            <input type="number" class="input-inline dm2-input" value="@g.DiemMieng2" min="0" max="10" step="0.1" placeholder="--" onchange="tinhTongKet(this)" onblur="autoLuuDiem(this)"/>
                        </td>
                        <td>
                            <input type="number" class="input-inline dm3-input" value="@g.DiemMieng3" min="0" max="10" step="0.1" placeholder="--" onchange="tinhTongKet(this)" onblur="autoLuuDiem(this)"/>
                        </td>
                        <td>
                            <input type="number" class="input-inline dm4-input" value="@g.DiemMieng4" min="0" max="10" step="0.1" placeholder="--" onchange="tinhTongKet(this)" onblur="autoLuuDiem(this)"/>
                        </td>
                        <td>
                            <input type="number" class="input-inline gk-input"
                                   value="@g.DiemGiuaKy" min="0" max="10" step="0.1"
                                   placeholder="--" onchange="tinhTongKet(this)" onblur="autoLuuDiem(this)" />
                        </td>
                        <td>
                            <input type="number" class="input-inline ck-input"
                                   value="@g.DiemCuoiKy" min="0" max="10" step="0.1"
                                   placeholder="--" onchange="tinhTongKet(this)" onblur="autoLuuDiem(this)" />
                        </td>
                        <td class="td-tongket fw-bold" style="color:var(--blue)">
                            @(g.DiemTongKet?.ToString("0.#") ?? "--")
                        </td>
                        <td>
                            <span class="badge td-xeploai @(g.DiemTongKet >= 5 ? "badge-green" : g.DiemTongKet != null ? "badge-red" : "badge-amber")">
                                @g.XepLoai
                            </span>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="9" class="text-center">Chưa có dữ liệu học sinh trong lớp này.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        function getToken() {
            return document.querySelector('input[name="__RequestVerificationToken"]').value;
        }

        function tinhTongKet(input) {
            const row = input.closest('tr');
            const dm1 = parseFloat(row.querySelector('.dm1-input').value);
            const dm2 = parseFloat(row.querySelector('.dm2-input').value);
            const dm3 = parseFloat(row.querySelector('.dm3-input').value);
            const dm4 = parseFloat(row.querySelector('.dm4-input').value);
            const gk = parseFloat(row.querySelector('.gk-input').value);
            const ck = parseFloat(row.querySelector('.ck-input').value);
            const badge = row.querySelector('.td-xeploai');

            if (!isNaN(gk) && !isNaN(ck)) {
                let dms = [];
                if (!isNaN(dm1)) dms.push(dm1);
                if (!isNaN(dm2)) dms.push(dm2);
                if (!isNaN(dm3)) dms.push(dm3);
                if (!isNaN(dm4)) dms.push(dm4);

                let tong = 0;
                if (dms.length > 0) {
                    const avgDm = dms.reduce((a, b) => a + b, 0) / dms.length;
                    tong = (avgDm + gk * 2 + ck * 3) / 6;
                } else {
                    tong = (gk * 0.4 + ck * 0.6);
                }
                tong = tong.toFixed(1);
                row.querySelector('.td-tongket').textContent = tong;

                let xl = 'Yếu', cls = 'badge-red';
                const d = parseFloat(tong);
                if (d >= 9.0) { xl = 'Xuất sắc'; cls = 'badge-green'; }
                else if (d >= 8.0) { xl = 'Giỏi'; cls = 'badge-green'; }
                else if (d >= 6.5) { xl = 'Khá'; cls = 'badge-blue'; }
                else if (d >= 5.0) { xl = 'Trung bình'; cls = 'badge-amber'; }

                badge.textContent = xl;
                badge.className = 'badge td-xeploai ' + cls;
            }
        }

        function buildPayload(row) {
            return {
                HocSinhId : row.dataset.hsId,
                MonHocId  : parseInt(row.dataset.monHocId),
                DiemMieng : parseFloat(row.querySelector('.dm1-input').value) || null,
                DiemMieng2: parseFloat(row.querySelector('.dm2-input').value) || null,
                DiemMieng3: parseFloat(row.querySelector('.dm3-input').value) || null,
                DiemMieng4: parseFloat(row.querySelector('.dm4-input').value) || null,
                DiemGiuaKy: parseFloat(row.querySelector('.gk-input').value) || null,
                DiemCuoiKy: parseFloat(row.querySelector('.ck-input').value) || null
            };
        }

        function autoLuuDiem(input) {
            const row = input.closest('tr');
            if (!input.value) return;
            const payload = buildPayload(row);
            fetch('@Url.Action("LuuDiem", "GiaoVien", new { area = "GiaoVien" })',{
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getToken() },
                body: JSON.stringify(payload)
            }).then(r => r.json()).then(d => {
                if (d.success) {
                    input.style.borderColor = '#22c55e';
                    setTimeout(() => { input.style.borderColor = ''; }, 1200);
                }
            }).catch(() => {});
        }
    </script>
}