@model LMS_THPT.ViewModels.BaiTapManageViewModel
@{
    ViewData["Title"] = "Bài tập & Đánh giá";
    ViewData["ActivePage"] = "BaiTap";
    ViewData["PageTitle"] = "Bài tập & Đánh giá";
    var lopId = (int)(ViewBag.LopHienTai ?? 0);
    var monHocId = (int)(ViewBag.MonHocHienTai ?? 0);
    var lopMonHocs = ViewBag.LopMonHocs as List<LMS_THPT.Models.LopMonHoc> ?? new List<LMS_THPT.Models.LopMonHoc>();
    var tenLop = ViewBag.TenLopHienTai as string ?? "";
    var tenMon = ViewBag.TenMonHienTai as string ?? "";

    var lops = lopMonHocs.Select(x => x.Lop).Where(x => x != null).DistinctBy(x => x!.Id).OrderBy(x => x!.TenLop).ToList();
    var mons = lopMonHocs.Where(x => x.LopId == lopId).Select(x => x.MonHoc).Where(x => x != null).ToList();

    var pending = Model.BaiNopChoChoam.Count(x => x.TrangThai == "pending");
    var graded = Model.BaiNopChoChoam.Count(x => x.TrangThai == "graded");
    var gradedDiem = Model.BaiNopChoChoam.Where(x => x.Diem.HasValue).ToList();
    var diemTB = gradedDiem.Any() ? gradedDiem.Average(x => x.Diem!.Value).ToString("0.#") : "--";
}

@section TopbarAction {
    <div style="display:flex; gap:8px; align-items:center;">
        @if (!string.IsNullOrEmpty(tenLop) && !string.IsNullOrEmpty(tenMon))
        {
            <span style="font-size:13px;color:var(--text3);">
                <i class="fa-solid fa-location-dot" style="color:var(--primary)"></i>
                Lớp <strong>@tenLop</strong> &ndash; <strong>@tenMon</strong>
            </span>
        }
        <button type="button" class="btn btn-primary" onclick="luuTatCaDiemBT()">
            <i class="fa fa-save"></i> Lưu tất cả điểm
        </button>
    </div>
}

@Html.AntiForgeryToken()

<style>
    /* ── Class tab bar ── */
    .lop-tab-bar {
        display: flex;
        gap: 4px;
        flex-wrap: wrap;
        margin-bottom: 0;
        border-bottom: 2px solid var(--border);
        padding-bottom: 0;
    }

    .lop-tab-item {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 10px 20px;
        border-radius: 8px 8px 0 0;
        font-size: 13.5px;
        font-weight: 500;
        color: var(--text2);
        text-decoration: none;
        border: 2px solid transparent;
        border-bottom: none;
        position: relative;
        bottom: -2px;
        transition: all .18s ease;
        background: transparent;
        cursor: pointer;
    }

    .lop-tab-item:hover {
        background: var(--bg-hover, rgba(99,102,241,.07));
        color: var(--primary);
    }

    .lop-tab-item.active {
        background: var(--card-bg, #fff);
        color: var(--primary);
        border-color: var(--border) var(--border) var(--card-bg, #fff) var(--border);
        font-weight: 600;
    }

    /* ── Subject pill tabs ── */
    .mon-tab-bar {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        padding: 14px 16px 0 16px;
        background: var(--card-bg, #fff);
        border-left: 2px solid var(--border);
        border-right: 2px solid var(--border);
    }

    .mon-tab-item {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 12.5px;
        font-weight: 500;
        color: var(--text2);
        text-decoration: none;
        border: 1.5px solid var(--border);
        background: transparent;
        transition: all .15s ease;
        cursor: pointer;
    }

    .mon-tab-item:hover {
        border-color: var(--primary);
        color: var(--primary);
        background: rgba(99,102,241,.06);
    }

    .mon-tab-item.active {
        background: var(--primary);
        color: #fff;
        border-color: var(--primary);
        font-weight: 600;
    }

    .mon-tab-item .mon-count {
        font-size: 10px;
        padding: 1px 5px;
        border-radius: 8px;
        background: rgba(255,255,255,.25);
    }

    .mon-tab-item:not(.active) .mon-count {
        background: var(--bg-color);
        color: var(--text3);
    }

    /* ── Tab content panel ── */
    .tab-panel-body {
        background: var(--card-bg, #fff);
        border: 2px solid var(--border);
        border-top: none;
        border-radius: 0 0 12px 12px;
        padding: 20px;
        margin-bottom: 20px;
    }

    /* ── Empty state ── */
    .empty-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 48px 20px;
        color: var(--text3);
        font-size: 14px;
        gap: 12px;
    }

    .empty-state i {
        font-size: 36px;
        color: var(--border);
    }
</style>

@if (!lops.Any())
{
    <div class="empty-state">
        <i class="fa-solid fa-inbox"></i>
        <div>Chưa có lớp học nào được phân công.</div>
    </div>
}
else
{
    <!-- ── Class Tabs ── -->
    <div class="lop-tab-bar">
        @foreach (var lop in lops)
        {
            var isActive = (lop!.Id == lopId);
            <a asp-action="QuanLyBaiTap" asp-route-lopId="@lop.Id"
               class="lop-tab-item @(isActive ? "active" : "")">
                <i class="fa-solid fa-users" style="font-size:11px;opacity:.7"></i>
                Lớp @lop.TenLop
            </a>
        }
    </div>

    <!-- ── Subject Sub-Tabs ── -->
    @if (mons.Any())
    {
        <div class="mon-tab-bar">
            @foreach (var mon in mons)
            {
                var isMonActive = (mon!.Id == monHocId);
                <a asp-action="QuanLyBaiTap" asp-route-lopId="@lopId" asp-route-monHocId="@mon.Id"
                   class="mon-tab-item @(isMonActive ? "active" : "")">
                    <i class="fa-solid fa-book-open" style="font-size:10px;opacity:.8"></i>
                    @mon.TenMonHoc
                </a>
            }
        </div>
    }

    <!-- ── Panel body ── -->
    <div class="tab-panel-body">

        @if (!mons.Any())
        {
            <div class="empty-state">
                <i class="fa-solid fa-book"></i>
                <div>Lớp này chưa có môn học nào được phân công.</div>
            </div>
        }
        else
        {
            <!-- Stats row -->
            <div class="stats-grid mb-16" style="grid-template-columns:repeat(4,1fr)">
                <div class="stat-card">
                    <div class="stat-label">Tổng bài nộp</div>
                    <div class="stat-value">@Model.BaiNopChoChoam.Count</div>
                </div>
                <div class="stat-card">
                    <div class="stat-label">Chờ chấm</div>
                    <div class="stat-value @(pending > 0 ? "danger" : "")">@pending</div>
                </div>
                <div class="stat-card">
                    <div class="stat-label">Đã chấm</div>
                    <div class="stat-value success">@graded</div>
                </div>
                <div class="stat-card">
                    <div class="stat-label">Điểm TB</div>
                    <div class="stat-value">@diemTB</div>
                </div>
            </div>

            <div class="two-col mb-16">
                <!-- Recent submissions -->
                <div class="card">
                    <div class="card-header">
                        <span class="card-title">Bài nộp gần đây</span>
                        @if (pending > 0)
                        {
                            <span class="badge badge-amber">@pending chờ chấm</span>
                        }
                    </div>
                    @if (!Model.BaiNopChoChoam.Any())
                    {
                        <div style="color:var(--text3);font-size:13px;padding:12px 0">Không có bài nộp nào.</div>
                    }
                    @foreach (var bn in Model.BaiNopChoChoam)
                    {
                        <div class="student-row">
                            <div class="avatar-sm">@bn.TenVietTat</div>
                            <div class="student-info">
                                <div class="student-name">@bn.TenHocSinh</div>
                                <div class="student-meta">@bn.TenBaiTap · @bn.ThoiGianNop</div>
                            </div>
                            @if (bn.TrangThai == "pending")
                            {
                                <button class="btn btn-primary btn-sm" onclick="scrollToDiem(@bn.BaiNopId)">Chấm</button>
                            }
                            else
                            {
                                <div style="text-align:right">
                                    <div style="font-size:13px;font-weight:600;color:var(--green)">@bn.Diem?.ToString("0.#")</div>
                                    <div style="font-size:10px;color:var(--text3)">Đã chấm</div>
                                </div>
                            }
                        </div>
                    }
                </div>

                <!-- Grade detail table -->
                <div class="card" id="diemCard">
                    <div class="card-header">
                        <span class="card-title">Chi tiết điểm số & nhận xét</span>
                    </div>
                    @if (!Model.DanhSachDiem.Any())
                    {
                        <div style="color:var(--text3);font-size:13px;padding:12px 0">Chưa có dữ liệu bài nộp để chấm điểm.</div>
                    }
                    <div class="table-wrap">
                        <table>
                            <thead>
                                <tr>
                                    <th>Học sinh</th>
                                    <th>Bài tập</th>
                                    <th>Điểm</th>
                                    <th>Nhận xét</th>
                                    <th>Trạng thái</th>
                                    <th>Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var d in Model.DanhSachDiem)
                                {
                                    <tr data-bainop-id="@d.BaiNopId" id="row-@d.BaiNopId">
                                        <td>@d.TenHocSinh</td>
                                        <td style="color:var(--text2);font-size:12px">@d.TenBaiTap</td>
                                        <td>
                                            <input type="number" class="input-inline diem-input"
                                                   value="@d.Diem" min="0" max="100" step="0.5" placeholder="--" />
                                        </td>
                                        <td>
                                            <input type="text" class="input-inline input-inline-wide nhanxet-input"
                                                   value="@d.NhanXet" placeholder="Nhận xét..." />
                                        </td>
                                        <td>
                                            <span class="badge @(d.TrangThai == "graded" ? "badge-green" : "badge-amber") tt-badge">
                                                @(d.TrangThai == "graded" ? "Đã chấm" : "Chờ chấm")
                                            </span>
                                        </td>
                                        <td>
                                            <button class="btn-link" onclick="luuDiemBaiTap(this)">Lưu</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    </div>
}

@section Scripts {
    <script>
        const monHocId = @monHocId;
        const lopId = @lopId;

        function getToken() {
            return document.querySelector('input[name="__RequestVerificationToken"]').value;
        }

        function luuDiemBaiTap(btn) {
            const row = btn.closest('tr');
            const payload = {
                BaiNopId : parseInt(row.dataset.bainopId),
                Diem     : parseFloat(row.querySelector('.diem-input').value) || null,
                NhanXet  : row.querySelector('.nhanxet-input').value
            };

            fetch('@Url.Action("LuuDiemBaiTap", "GiaoVien", new { area = "GiaoVien" })',{
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getToken() },
                body: JSON.stringify(payload)
            }).then(r => r.json()).then(d => {
                if (d.success) {
                    const badge = row.querySelector('.tt-badge');
                    badge.textContent = 'Đã chấm';
                    badge.className   = 'badge badge-green tt-badge';
                }
                showToast(d.message, d.success ? 'success' : 'error');
            });
        }

        function luuTatCaDiemBT() {
            const rows = document.querySelectorAll('tbody tr[data-bainop-id]');
            let completed = 0;
            let sent = 0;

            rows.forEach(row => {
                const diem = row.querySelector('.diem-input')?.value;
                if (diem !== "") {
                    sent++;
                    fetch('@Url.Action("LuuDiemBaiTap", "GiaoVien", new { area = "GiaoVien" })',{
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getToken() },
                        body: JSON.stringify({
                            BaiNopId: parseInt(row.dataset.bainopId),
                            Diem    : parseFloat(diem),
                            NhanXet : row.querySelector('.nhanxet-input')?.value ?? ''
                        })
                    }).then(() => {
                        completed++;
                        if (completed === sent) {
                            showToast('Đã lưu tất cả điểm!', 'success');
                            setTimeout(() => location.reload(), 1000);
                        }
                    });
                }
            });

            if (sent === 0) showToast('Không có điểm nào để lưu.', 'error');
        }

        function scrollToDiem(baiNopId) {
            const row = document.getElementById('row-' + baiNopId);
            if (row) {
                row.scrollIntoView({ behavior: 'smooth', block: 'center' });
                setTimeout(() => {
                    row.style.background = '#f0f7ff';
                    row.querySelector('.diem-input')?.focus();
                    setTimeout(() => row.style.background = '', 2000);
                }, 400);
            }
        }
    </script>
}
