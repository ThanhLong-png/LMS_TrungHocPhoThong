@model LMS_THPT.ViewModels.BaiTapManageViewModel
@{
    ViewData["Title"] = "Bài tập & Đánh giá";
    ViewData["ActivePage"] = "BaiTap";
    ViewData["PageTitle"] = "Bài tập & Đánh giá";
    var monHocHienTai = (int)(ViewBag.MonHocHienTai ?? 0);
}

@section TopbarAction {
    <div style="display:flex; gap:8px;">
        <button type="button" class="btn btn-primary" onclick="luuTatCaDiemBT()">
            <i class="fa fa-save"></i> Lưu tất cả điểm
        </button>
    </div>
}

@Html.AntiForgeryToken()

<div class="two-col mb-16">
    <div class="card">
        <div class="card-header">
            <span class="card-title">Bài nộp gần đây</span>
            @{
                var pending = Model.BaiNopChoChoam.Count(x => x.TrangThai == "pending");
            }
            @if (pending > 0)
            {
                <span class="badge badge-amber">@pending chờ chấm</span>
            }
        </div>
        @if (!Model.BaiNopChoChoam.Any())
        {
            <div style="color:var(--text3);font-size:13px;padding:12px 0">Không có bài nộp nào.</div>
        }
        @foreach (var bn in Model.BaiNopChoChoam)
        {
            <div class="student-row">
                <div class="avatar-sm">@bn.TenVietTat</div>
                <div class="student-info">
                    <div class="student-name">@bn.TenHocSinh</div>
                    <div class="student-meta">@bn.TenBaiTap · @bn.ThoiGianNop</div>
                </div>
                @if (bn.TrangThai == "pending")
                {
                    <button class="btn btn-primary btn-sm" onclick="scrollToDiem(@bn.BaiNopId)">Chấm</button>
                }
                else
                {
                    <div style="text-align:right">
                        <div style="font-size:13px;font-weight:600;color:var(--green)">@bn.Diem?.ToString("0.#")</div>
                        <div style="font-size:10px;color:var(--text3)">Đã chấm</div>
                    </div>
                }
            </div>
        }
    </div>

    <div class="card">
        <div class="card-header">
            <span class="card-title">Tổng hợp nhanh</span>
        </div>
        <div class="stats-grid" style="grid-template-columns:1fr 1fr">
            <div class="stat-card">
                <div class="stat-label">Tổng bài nộp</div>
                <div class="stat-value">@Model.BaiNopChoChoam.Count</div>
            </div>
            <div class="stat-card">
                <div class="stat-label">Chờ chấm</div>
                <div class="stat-value @(pending > 0 ? "danger" : "")">@pending</div>
            </div>
            <div class="stat-card">
                <div class="stat-label">Đã chấm</div>
                <div class="stat-value success">@Model.BaiNopChoChoam.Count(x => x.TrangThai == "graded")</div>
            </div>
            <div class="stat-card">
                <div class="stat-label">Điểm TB</div>
                <div class="stat-value">
                    @{
                        var graded = Model.BaiNopChoChoam.Where(x => x.Diem.HasValue).ToList();
                        var tb = graded.Any() ? graded.Average(x => x.Diem!.Value).ToString("0.#") : "--";
                    }
                    @tb
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card" id="diemCard">
    <div class="card-header">
        <span class="card-title">Chi tiết điểm số &amp; nhận xét</span>
    </div>
    @if (!Model.DanhSachDiem.Any())
    {
        <div style="color:var(--text3);font-size:13px;padding:12px 0">Chưa có dữ liệu bài nộp để chấm điểm.</div>
    }
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Học sinh</th>
                    <th>Bài tập</th>
                    <th>Điểm</th>
                    <th>Nhận xét</th>
                    <th>Trạng thái</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var group in Model.DanhSachDiem.GroupBy(x => x.TenLop).OrderBy(g => g.Key))
                {
                    <tr>
                        <td colspan="6" style="background-color: var(--bg-color); font-weight: 600; padding: 10px 16px;">
                            <i class="fa-solid fa-users" style="margin-right:8px;color:var(--primary)"></i> Lớp @(string.IsNullOrEmpty(group.Key) ? "Chưa có lớp" : group.Key)
                        </td>
                    </tr>
                    @foreach (var d in group)
                    {
                        <tr data-bainop-id="@d.BaiNopId" id="row-@d.BaiNopId">
                            <td style="padding-left: 24px;">@d.TenHocSinh</td>
                            <td style="color:var(--text2);font-size:12px">@d.TenBaiTap</td>
                            <td>
                                <input type="number" class="input-inline diem-input"
                                       value="@d.Diem" min="0" max="100" step="0.5" placeholder="--" />
                            </td>
                            <td>
                                <input type="text" class="input-inline input-inline-wide nhanxet-input"
                                       value="@d.NhanXet" placeholder="Nhận xét..." />
                            </td>
                            <td>
                                <span class="badge @(d.TrangThai == "graded" ? "badge-green" : "badge-amber") tt-badge">
                                    @(d.TrangThai == "graded" ? "Đã chấm" : "Chờ chấm")
                                </span>
                            </td>
                            <td>
                                <button class="btn-link" onclick="luuDiemBaiTap(this)">Lưu</button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        const monHocId = @monHocHienTai;

        function getToken() {
            return document.querySelector('input[name="__RequestVerificationToken"]').value;
        }

        function luuDiemBaiTap(btn) {
            const row = btn.closest('tr');
            const payload = {
                BaiNopId : parseInt(row.dataset.bainopId),
                Diem     : parseFloat(row.querySelector('.diem-input').value) || null,
                NhanXet  : row.querySelector('.nhanxet-input').value
            };

            fetch('@Url.Action("LuuDiemBaiTap", "GiaoVien", new { area = "GiaoVien" })',{
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getToken() },
                body: JSON.stringify(payload)
            }).then(r => r.json()).then(d => {
                if (d.success) {
                    const badge = row.querySelector('.tt-badge');
                    badge.textContent = 'Đã chấm';
                    badge.className   = 'badge badge-green tt-badge';
                }
                showToast(d.message, d.success ? 'success' : 'error');
            });
        }

        function luuTatCaDiemBT() {
            const rows = document.querySelectorAll('tbody tr');
            let completed = 0;

            rows.forEach(row => {
                const diem = row.querySelector('.diem-input')?.value;
                if (diem !== "") {
                    fetch('@Url.Action("LuuDiemBaiTap", "GiaoVien", new { area = "GiaoVien" })',{
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getToken() },
                        body: JSON.stringify({
                            BaiNopId: parseInt(row.dataset.bainopId),
                            Diem    : parseFloat(diem),
                            NhanXet : row.querySelector('.nhanxet-input')?.value ?? ''
                        })
                    }).then(() => {
                        completed++;
                        if(completed === rows.length) {
                            showToast('Đã lưu tất cả điểm!', 'success');
                            setTimeout(() => location.reload(), 1000);
                        }
                    });
                }
            });
        }

        function scrollToDiem(baiNopId) {
            const row = document.getElementById('row-' + baiNopId);
            if (row) {
                row.scrollIntoView({ behavior: 'smooth', block: 'center' });
                setTimeout(() => {
                    row.style.background = '#f0f7ff';
                    row.querySelector('.diem-input')?.focus();
                    setTimeout(() => row.style.background = '', 2000);
                }, 400);
            }
        }
    </script>
}
