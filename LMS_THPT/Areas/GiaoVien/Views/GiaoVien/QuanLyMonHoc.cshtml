@* Views/GiaoVien/QuanLyMonHoc.cshtml *@
@model LMS_THPT.ViewModels.MonHocManageViewModel
@{
    var isIframeVal = Context.Request.Query["isIframe"].ToString();
    var isIframe = !string.IsNullOrEmpty(isIframeVal) && isIframeVal.Equals("true", StringComparison.OrdinalIgnoreCase);
    if (isIframe) { Layout = "_IframeLayout"; }
    
    ViewData["Title"] = "Môn học";
    ViewData["ActivePage"] = "MonHoc";
    ViewData["PageTitle"] = "Quản lý môn học";
    var monHocIds = ViewBag.MonHocIds as List<int> ?? new();
    var monHocHienTai = (int)(ViewBag.MonHocHienTai ?? 0);
    var teacherMonHocs = ViewBag.TeacherMonHocs as List<LMS_THPT.Models.MonHoc> ?? new();
    var lopMonHocs = ViewBag.LopMonHocs as List<LMS_THPT.Models.LopMonHoc> ?? new();
}

@section TopbarAction {
    <button type="button" class="btn btn-primary" onclick="luuTatCaDiem()">
        <i class="fa fa-save"></i> Lưu tất cả điểm
    </button>
}

@if (teacherMonHocs.Any())
{
    <div class="tab-bar mb-16">
        @foreach (var m in teacherMonHocs)
        {
            <a asp-action="QuanLyMonHoc" asp-route-monHocId="@m.Id"
               class="tab-item @(m.Id == monHocHienTai ? "active" : "")">
                @m.TenMonHoc
            </a>
        }
    </div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success" style="padding:12px 16px; background:#dcfce7; color:#166534; border-radius:8px; margin-bottom:16px;">
        @TempData["Success"]
    </div>
}

<div class="card mb-16">
    <div class="card-header">
        <span class="card-title">Thông tin môn học: @Model.MonHoc?.TenMonHoc</span>
    </div>
    <div class="card-body">
        <form asp-action="CapNhatMonHoc" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Id" value="@Model.MonHoc?.Id" />
            <input type="hidden" name="TenMonHoc" value="@Model.MonHoc?.TenMonHoc" />
            
            <div class="form-row" style="margin-bottom:12px;">
                <label class="form-label" style="font-weight:600; display:block; margin-bottom:8px;">Nội dung/Mô tả</label>
                <textarea name="MoTa" class="form-control" rows="3" placeholder="Nhập mô tả môn học..." style="width:100%;">@Model.MonHoc?.MoTa</textarea>
            </div>
            <div class="form-row" style="margin-bottom:16px;">
                <label class="form-label" style="font-weight:600; display:block; margin-bottom:8px;">Mục tiêu khóa học</label>
                <textarea name="MucTieu" class="form-control" rows="3" placeholder="Nhập mục tiêu khóa học..." style="width:100%;">@Model.MonHoc?.MucTieu</textarea>
            </div>
            <div>
                <button type="submit" class="btn btn-primary" style="padding:8px 16px; border:none; border-radius:6px; background:var(--primary); color:#fff; cursor:pointer;">
                    <i class="fa fa-save"></i> Lưu nội dung môn học
                </button>
            </div>
        </form>
    </div>
</div>

<div class="two-col mb-16">
    <div class="card">
        <div class="card-header">
            <span class="card-title">Cập nhật môn học theo lớp</span>
        </div>
        <div class="card-body">
            <div class="mb-12">
                <strong style="font-size: 14px;">Chọn lớp đang dạy</strong>
                <div class="small text-muted">Click vào lớp bên dưới để cập nhật nội dung môn học cho lớp đó.</div>
            </div>

            <div class="class-list-container">
                @if (lopMonHocs.Any())
                {
                    @foreach (var lmh in lopMonHocs)
                    {
                        <div class="class-card-item" onclick="openUpdateClassModal(@lmh.LopId, @lmh.MonHocId, '@lmh.Lop?.TenLop')">
                            <div class="class-card-icon">
                                <i class="fa fa-chalkboard-teacher"></i>
                            </div>
                            <div class="class-card-info">
                                <div class="name">Lớp @lmh.Lop?.TenLop</div>
                                <div class="sub">Môn @Model.MonHoc?.TenMonHoc</div>
                            </div>
                            <i class="fa fa-chevron-right arrow"></i>
                        </div>
                    }
                }
                else
                {
                    <div class="text-muted p-12" style="font-size:13px">Chưa có lớp nào được gán cho môn này.</div>
                }
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <span class="card-title">Yêu cầu thay đổi trạng thái</span>
        </div>
        <div class="card-body">
            @Html.AntiForgeryToken()
            <div class="form-row">
                <label class="form-label">Học sinh</label>
                <select id="ycHocSinhId" class="form-control">
                    @foreach (var hs in Model.DanhSachHocSinh)
                    {
                        <option value="@hs.Id">@hs.HoTen (@hs.TenLop)</option>
                    }
                </select>
            </div>
            <div class="form-row">
                <label class="form-label">Loại yêu cầu</label>
                <select id="ycTrangThai" class="form-control">
                    @foreach (var opt in Model.TuyChonTrangThai)
                    {
                        <option value="@opt">@opt</option>
                    }
                </select>
            </div>
            <div class="form-row">
                <label class="form-label">Lý do cụ thể</label>
                <textarea id="ycLyDo" class="form-control" rows="2" placeholder="Nêu lý do chi tiết..."></textarea>
            </div>
            <button class="btn btn-secondary w-full mt-4" onclick="guiYeuCau()">Gửi yêu cầu</button>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <span class="card-title">Bảng điểm môn @Model.MonHoc?.TenMonHoc</span>
    </div>
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Học sinh</th>
                    <th width="80">Miệng 1</th>
                    <th width="80">Miệng 2</th>
                    <th width="80">Miệng 3</th>
                    <th width="80">Miệng 4</th>
                    <th width="160">Điểm giữa kỳ (40%)</th>
                    <th width="160">Điểm cuối kỳ (60%)</th>
                    <th width="140">Tổng kết</th>
                    <th>Xếp loại</th>
                    <th width="80"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var g in Model.DanhSachDiem)
                {
                    <tr data-hs-id="@g.HocSinhId" data-mon-hoc-id="@monHocHienTai">
                        <td class="fw-medium">@g.TenHocSinh</td>
                        <td>
                            <input type="number" class="input-inline dm1-input" value="@g.DiemMieng" min="0" max="10" step="0.1" placeholder="--" onchange="tinhTongKet(this)"/>
                        </td>
                        <td>
                            <input type="number" class="input-inline dm2-input" value="@g.DiemMieng2" min="0" max="10" step="0.1" placeholder="--" onchange="tinhTongKet(this)"/>
                        </td>
                        <td>
                            <input type="number" class="input-inline dm3-input" value="@g.DiemMieng3" min="0" max="10" step="0.1" placeholder="--" onchange="tinhTongKet(this)"/>
                        </td>
                        <td>
                            <input type="number" class="input-inline dm4-input" value="@g.DiemMieng4" min="0" max="10" step="0.1" placeholder="--" onchange="tinhTongKet(this)"/>
                        </td>
                        <td>
                            <input type="number" class="input-inline gk-input"
                                   value="@g.DiemGiuaKy" min="0" max="10" step="0.1"
                                   placeholder="--" onchange="tinhTongKet(this)" />
                        </td>
                        <td>
                            <input type="number" class="input-inline ck-input"
                                   value="@g.DiemCuoiKy" min="0" max="10" step="0.1"
                                   placeholder="--" onchange="tinhTongKet(this)" />
                        </td>
                        <td class="td-tongket fw-bold" style="color:var(--blue)">
                            @(g.DiemTongKet?.ToString("0.#") ?? "--")
                        </td>
                        <td>
                            <span class="badge td-xeploai @(g.DiemTongKet >= 5 ? "badge-green" : g.DiemTongKet != null ? "badge-red" : "badge-amber")">
                                @g.XepLoai
                            </span>
                        </td>
                        <td>
                            <button class="btn-link" onclick="luuDiem(this)">Lưu</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        const monHocId = @monHocHienTai;

        function getToken() {
            return document.querySelector('input[name="__RequestVerificationToken"]').value;
        }

        function openUpdateClassModal(lopId, monHocId, tenLop) {
            showToast('Mở trình cập nhật nội dung lớp ' + tenLop, 'info');
            // Logic: Có thể Redirect hoặc mở Modal để giáo viên sửa thông tin MonHoc riêng cho lớp này
        }

        function tinhTongKet(input) {
            const row = input.closest('tr');
            const dm1 = parseFloat(row.querySelector('.dm1-input').value);
            const dm2 = parseFloat(row.querySelector('.dm2-input').value);
            const dm3 = parseFloat(row.querySelector('.dm3-input').value);
            const dm4 = parseFloat(row.querySelector('.dm4-input').value);
            const gk = parseFloat(row.querySelector('.gk-input').value);
            const ck = parseFloat(row.querySelector('.ck-input').value);
            const badge = row.querySelector('.td-xeploai');

            if (!isNaN(gk) && !isNaN(ck)) {
                let dms = [];
                if (!isNaN(dm1)) dms.push(dm1);
                if (!isNaN(dm2)) dms.push(dm2);
                if (!isNaN(dm3)) dms.push(dm3);
                if (!isNaN(dm4)) dms.push(dm4);

                let tong = 0;
                if (dms.length > 0) {
                    const avgDm = dms.reduce((a, b) => a + b, 0) / dms.length;
                    tong = (avgDm + gk * 2 + ck * 3) / 6;
                } else {
                    tong = (gk * 0.4 + ck * 0.6);
                }
                tong = tong.toFixed(1);
                row.querySelector('.td-tongket').textContent = tong;

                let xl = 'Yếu', cls = 'badge-red';
                const d = parseFloat(tong);
                if (d >= 9.0) { xl = 'Xuất sắc'; cls = 'badge-green'; }
                else if (d >= 8.0) { xl = 'Giỏi'; cls = 'badge-green'; }
                else if (d >= 6.5) { xl = 'Khá'; cls = 'badge-blue'; }
                else if (d >= 5.0) { xl = 'Trung bình'; cls = 'badge-amber'; }

                badge.textContent = xl;
                badge.className = 'badge td-xeploai ' + cls;
            }
        }

        function luuDiem(btn) {
            const row = btn.closest('tr');
            const payload = {
                HocSinhId : row.dataset.hsId,
                MonHocId  : parseInt(row.dataset.monHocId),
                DiemMieng : parseFloat(row.querySelector('.dm1-input').value) || null,
                DiemMieng2: parseFloat(row.querySelector('.dm2-input').value) || null,
                DiemMieng3: parseFloat(row.querySelector('.dm3-input').value) || null,
                DiemMieng4: parseFloat(row.querySelector('.dm4-input').value) || null,
                DiemGiuaKy: parseFloat(row.querySelector('.gk-input').value) || null,
                DiemCuoiKy: parseFloat(row.querySelector('.ck-input').value) || null
            };
            fetch('@Url.Action("LuuDiem", "GiaoVien", new { area = "GiaoVien" })',{
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getToken() },
                body: JSON.stringify(payload)
            }).then(r => r.json()).then(d => showToast(d.message, d.success ? 'success' : 'error'));
        }

        function luuTatCaDiem() {
            const rows = document.querySelectorAll('tbody tr');
            rows.forEach(row => {
                const dm1 = row.querySelector('.dm1-input')?.value;
                const dm2 = row.querySelector('.dm2-input')?.value;
                const dm3 = row.querySelector('.dm3-input')?.value;
                const dm4 = row.querySelector('.dm4-input')?.value;
                const gk = row.querySelector('.gk-input')?.value;
                const ck = row.querySelector('.ck-input')?.value;
                if (dm1 || dm2 || dm3 || dm4 || gk || ck) {
                    fetch('@Url.Action("LuuDiem", "GiaoVien", new { area = "GiaoVien" })',{
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getToken() },
                        body: JSON.stringify({
                            HocSinhId : row.dataset.hsId,
                            MonHocId  : parseInt(row.dataset.monHocId),
                            DiemMieng : parseFloat(dm1) || null,
                            DiemMieng2: parseFloat(dm2) || null,
                            DiemMieng3: parseFloat(dm3) || null,
                            DiemMieng4: parseFloat(dm4) || null,
                            DiemGiuaKy: parseFloat(gk) || null,
                            DiemCuoiKy: parseFloat(ck) || null
                        })
                    });
                }
            });
            showToast('Đã gửi yêu cầu lưu toàn bộ điểm!', 'success');
        }

        function guiYeuCau() {
            const payload = {
                HocSinhId: document.getElementById('ycHocSinhId').value,
                TrangThai: document.getElementById('ycTrangThai').value,
                LyDo     : document.getElementById('ycLyDo').value
            };
            if (!payload.LyDo.trim()) { showToast('Vui lòng nhập lý do!', 'error'); return; }
            fetch('@Url.Action("GuiYeuCauTrangThai", "GiaoVien", new { area = "GiaoVien" })',{
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getToken() },
                body: JSON.stringify(payload)
            }).then(r => r.json()).then(d => {
                showToast(d.message, d.success ? 'success' : 'error');
                if (d.success) document.getElementById('ycLyDo').value = '';
            });
        }
    </script>
}

<style>
    .class-list-container {
        display: flex;
        flex-direction: column;
        gap: 8px;
        margin-top: 10px;
    }

    .class-card-item {
        display: flex;
        align-items: center;
        padding: 12px 16px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        cursor: pointer;
        transition: all 0.2s ease;
    }

        .class-card-item:hover {
            background: #ffffff;
            border-color: #2563eb;
            box-shadow: 0 4px 12px rgba(37, 99, 235, 0.1);
            transform: translateX(5px);
        }

    .class-card-icon {
        width: 38px;
        height: 38px;
        background: #eff6ff;
        color: #2563eb;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        margin-right: 14px;
    }

    .class-card-info {
        flex: 1;
    }

        .class-card-info .name {
            font-weight: 600;
            font-size: 14px;
            color: #1e293b;
        }

        .class-card-info .sub {
            font-size: 11px;
            color: #64748b;
            margin-top: 2px;
        }

    .class-card-item .arrow {
        font-size: 12px;
        color: #cbd5e1;
        transition: color 0.2s;
    }

    .class-card-item:hover .arrow {
        color: #2563eb;
    }
</style>