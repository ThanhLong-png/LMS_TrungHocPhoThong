@{
    ViewData["Title"] = "Tạo bài giảng";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
<script src="https://cdn.ckeditor.com/4.21.0/standard/ckeditor.js"></script>

<style>
    /* Button styles for GiangDay forms */
    .btn-primary-soft { background:#111; color:#fff; border:none; padding:8px 14px; border-radius:8px; text-decoration:none; display:inline-block; }
    .btn-outline-soft { background:#fff; color:#111; border:1px solid #111; padding:8px 12px; border-radius:8px; text-decoration:none; display:inline-block; }
    .btn-outline-soft:hover { background:#111; color:#fff; }
    /* Ensure anchors used as buttons don't show underline */
    .btn-primary-soft, .btn-outline-soft, .gd-back, .btn.btn-dark, .btn.btn-sm { text-decoration:none !important; }
</style>

<div class="card p-3">
    <h4>Tạo bài giảng mới</h4>
    <form asp-action="CreateBaiGiang" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input type="hidden" name="lopId" value="@ViewBag.LopId" />
        <div class="mb-3">
            <label class="form-label">Tiêu đề</label>
            <input name="title" class="form-control" required />
        </div>
        <div class="mb-3">
            <label class="form-label">Nội dung</label>
            <textarea name="content" id="editor" rows="10" class="form-control"></textarea>
        </div>
        <div class="mb-3">
            <label class="form-label">Tệp đính kèm</label>
            <input type="file" name="attachments" multiple class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label">Chọn môn học (bắt buộc để đăng bài vào môn)</label>
            <select name="monHocId" class="form-select">
                <option value="">-- Chọn môn --</option>
                @foreach(var m in (ViewBag.TatCaMonHoc as IEnumerable<LMS_THPT.Models.MonHoc> ?? Enumerable.Empty<LMS_THPT.Models.MonHoc>()))
                {
                    var selected = ViewBag.MonHoc != null && ((LMS_THPT.Models.MonHoc)ViewBag.MonHoc).Id == m.Id;
                    var optionHtml = $"<option value=\"{m.Id}\"{(selected ? " selected=\"selected\"" : "")}>" + System.Net.WebUtility.HtmlEncode(m.TenMonHoc) + "</option>";
                    @Html.Raw(optionHtml)
                }
            </select>
        </div>
        <div class="d-flex gap-2" style="align-items:center;">
            <button type="submit" class="btn-primary-soft">Đăng bài</button>
            <a asp-action="Index" asp-route-lopId="@ViewBag.LopId" asp-route-monHocId="@ViewBag.MonHocId" class="btn-outline-soft">Hủy</a>
        </div>
    </form>
</div>

<script>
    CKEDITOR.replace('editor');
</script>