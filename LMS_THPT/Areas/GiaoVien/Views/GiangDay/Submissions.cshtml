@model IEnumerable<LMS_THPT.Models.BaiNop>
@{
    ViewData["Title"] = "Danh sách nộp bài";
    var baiTap = ViewBag.BaiTap as LMS_THPT.Models.BaiTap;
}

<style>
.btn-outline-soft { background:#fff; color:#111; border:1px solid #111; padding:8px 14px; border-radius:8px; text-decoration:none; display:inline-block; }
.btn-outline-soft:hover { background:#111; color:#fff; }
</style>

<div style="display:flex; align-items:center; gap:12px; margin-bottom:16px;">
   <a asp-action="DetailsBaiTap" asp-route-id="@baiTap?.Id" asp-route-lopId="@ViewBag.LopId" class="btn-outline-soft">← Quay lại</a>
    <h3 style="margin:0;">Danh sách nộp bài - @baiTap?.TieuDe</h3>
</div>

@Html.AntiForgeryToken()

<table class="table">
    <thead>
        <tr>
            <th>Học sinh</th>
            <th>Ngày nộp</th>
            <th>File / Nội dung</th>
            <th>Trạng thái</th>
            <th>Điểm</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var s in Model)
        {
            <tr>
                <td>@(s.HocSinh?.HoTen ?? s.HocSinhId)</td>
                <td>@s.NgayNop.ToString("g")</td>
                <td>
                    @if (!string.IsNullOrEmpty(s.DuongDanFile))
                    {
                        <a href="@s.DuongDanFile" target="_blank">Tệp nộp</a>
                    }
                    else
                    {
                        @s.NoiDung
                    }
                </td>
                <td>@s.TrangThai</td>
                <td>
                    <div style="display:flex; gap:8px;">
                        <input type="number" class="form-control form-control-sm" style="width:70px" id="diem-@s.Id" value="@s.Diem?.ToString("0.#")" step="0.1" min="0" max="10" placeholder="--" />
                        <button class="btn btn-sm btn-primary" onclick="chamDiem(@s.Id)">Lưu</button>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>

<script>
    function getToken() {
        return document.querySelector('input[name="__RequestVerificationToken"]').value;
    }

    function chamDiem(baiNopId) {
        var diem = document.getElementById('diem-' + baiNopId).value;
        if(diem === "") {
            alert("Vui lòng nhập điểm!");
            return;
        }

        fetch('@Url.Action("ChamDiemBaiTap", "GiangDay", new { area = "GiaoVien" })', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': getToken()
            },
            body: JSON.stringify({ baiNopId: baiNopId, diem: parseFloat(diem) })
        }).then(r => r.json()).then(d => {
            if(d.success) {
                alert("Lưu điểm thành công!");
                // Cập nhật lại UI nếu cần
            } else {
                alert("Lỗi: " + d.message);
            }
        }).catch(e => {
            alert("Đã xảy ra lỗi mạng!");
        });
    }
</script>