@{
    ViewData["Title"] = "Tạo bài tập";
}

<script src="https://cdn.ckeditor.com/4.21.0/standard/ckeditor.js"></script>

<div class="card p-3">
    <h4>Tạo bài tập mới</h4>
    <form asp-action="CreateBaiTap" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input type="hidden" name="lopId" value="@ViewBag.LopId" />
        <input type="hidden" name="monHocId" value="@ViewBag.MonHocId" />
        <div class="mb-3">
            <label class="form-label">Tiêu đề</label>
            <input name="title" class="form-control" required />
        </div>
        <div class="mb-3">
            <label class="form-label">Nội dung / Yêu cầu</label>
            <textarea name="content" id="editor" rows="8" class="form-control"></textarea>
        </div>
        <div class="row">
            <div class="col-md-4 mb-3">
                <label class="form-label">Hạn nộp - Ngày</label>
                <input type="date" name="dueDate" class="form-control" />
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label">Hạn nộp - Giờ</label>
                <input type="time" name="dueTime" class="form-control" />
            </div>
            <div class="col-md-3 mb-3">
                <label class="form-label">Điểm tối đa</label>
                <input type="number" name="maxPoint" class="form-control" value="10" readonly />
            </div>
            <div class="col-md-3 mb-3">
                <label class="form-label">Loại điểm (Ghi sổ)</label>
                <select name="loaiDiem" class="form-control">
                    <option value="BaiTap">Khác (Không ghi sổ)</option>
                    <option value="MiengKiemTra">Điểm miệng / 15 phút</option>
                    <option value="GiuaKy">Điểm giữa kỳ (40%)</option>
                    <option value="CuoiKy">Điểm cuối kỳ (60%)</option>
                </select>
            </div>
            <div class="col-12 mb-3">
                <small class="text-muted">Khi chọn ngày, hệ thống sẽ hiển thị ngày trong tuần tương ứng (ví dụ: Thứ Hai, Thứ Ba...)</small>
            </div>
        </div>
        <div class="mb-3">
            <label class="form-label">Tệp đính kèm</label>
            <input type="file" name="attachments" multiple class="form-control" />
        </div>
        <div class="d-flex gap-2" style="align-items:center;">
            <button type="submit" class="btn-primary-soft">Tạo bài tập</button>
            <a asp-action="Index" asp-route-lopId="@ViewBag.LopId" asp-route-monHocId="@ViewBag.MonHocId" class="btn-outline-soft">Hủy</a>
        </div>
    </form>
</div>

<script>
    CKEDITOR.replace('editor');
</script>

<script>
    // Hiển thị ngày trong tuần khi thay đổi ngày
    document.addEventListener('DOMContentLoaded', function () {
        var dateInput = document.querySelector('input[name="dueDate"]');
        if (!dateInput) return;

        var info = document.createElement('div');
        info.style.marginTop = '8px';
        info.style.color = '#555';
        dateInput.parentElement.appendChild(info);

        function updateDay() {
            var v = dateInput.value;
            if (!v) { info.textContent = ''; return; }
            var d = new Date(v + 'T00:00:00');
            var days = ['Chủ Nhật','Thứ Hai','Thứ Ba','Thứ Tư','Thứ Năm','Thứ Sáu','Thứ Bảy'];
            info.textContent = 'Ngày ' + d.toLocaleDateString() + ' — ' + days[d.getDay()];
        }

        dateInput.addEventListener('change', updateDay);
        updateDay();
    });
</script>