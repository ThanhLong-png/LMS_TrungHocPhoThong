@{
    ViewData["Title"] = "Đăng ký lớp chủ nhiệm";
    var availableClasses = ViewData["AvailableClasses"] as List<LMS_THPT.Models.Lop> ?? new();
}

<div style="max-width: 600px; margin: 0 auto; padding: 40px 20px;">
    <h2 style="margin-bottom: 30px; text-align: center;">📚 Đăng ký lớp chủ nhiệm</h2>

    <div style="background: white; padding: 30px; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
        <form method="post" action="@Url.Action("RegisterClass")">
            <!-- Danh sách lớp -->
            <div style="margin-bottom: 20px;">
                <label style="display: block; font-weight: 600; margin-bottom: 8px; color: #1f2937;">
                    Chọn lớp <span style="color: #ef4444;">*</span>
                </label>
                <select name="lopId" required style="width: 100%; padding: 10px 12px; border: 1px solid #d1d5db; border-radius: 6px; font-size: 14px;">
                    <option value="">-- Chọn lớp --</option>
                    @foreach (var lop in availableClasses)
                    {
                        <option value="@lop.Id">@lop.TenLop (@lop.Khoi?.TenKhoi ?? "Không xác định")</option>
                    }
                </select>
                @if (availableClasses.Count == 0)
                {
                    <p style="color: #ef4444; font-size: 13px; margin-top: 8px;">
                        ⚠️ Không có lớp nào sẵn sàng để đăng ký
                    </p>
                }
            </div>

            <!-- Lý do đăng ký -->
            <div style="margin-bottom: 20px;">
                <label style="display: block; font-weight: 600; margin-bottom: 8px; color: #1f2937;">
                    Lý do đăng ký
                </label>
                <textarea name="moTa" placeholder="Vui lòng nhập lý do của bạn..." style="width: 100%; padding: 10px 12px; border: 1px solid #d1d5db; border-radius: 6px; font-size: 14px; resize: vertical; min-height: 100px;"></textarea>
                <p style="font-size: 12px; color: #6b7280; margin-top: 4px;">Tối đa 500 ký tự</p>
            </div>

            <!-- Nút gửi -->
            <div style="display: flex; gap: 10px;">
                <button type="submit" style="flex: 1; background: #3b82f6; color: white; padding: 10px; border: none; border-radius: 6px; font-weight: 600; cursor: pointer; font-size: 14px;">
                    ✅ Gửi yêu cầu
                </button>
                <a href="@Url.Action("MyRequests")" style="flex: 1; background: #6b7280; color: white; padding: 10px; border-radius: 6px; text-align: center; font-weight: 600; text-decoration: none; font-size: 14px;">
                    ❌ Hủy
                </a>
            </div>
        </form>
    </div>

    <!-- Thông tin hướng dẫn -->
    <div style="background: #eff6ff; border: 1px solid #bfdbfe; padding: 20px; border-radius: 8px; margin-top: 20px;">
        <h4 style="color: #1e40af; margin-top: 0;">ℹ️ Hướng dẫn</h4>
        <ul style="color: #1e40af; padding-left: 20px; margin-bottom: 0;">
            <li>Chọn lớp bạn muốn đăng ký làm chủ nhiệm</li>
            <li>Nhập lý do hoặc mục tiêu của bạn</li>
            <li>Gửi yêu cầu và chờ admin xem xét</li>
            <li>Bạn có thể theo dõi trạng thái tại mục "Yêu cầu của tôi"</li>
        </ul>
    </div>
</div>

<style>
    body {
        background: #f3f4f6;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
    }
</style>
