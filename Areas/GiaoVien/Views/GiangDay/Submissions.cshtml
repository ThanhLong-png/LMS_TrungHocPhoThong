@model IEnumerable<LMS_THPT.Models.BaiNop>
@{
    ViewData["Title"] = "Danh sách nộp bài";
    var baiTap = ViewBag.BaiTap as LMS_THPT.Models.BaiTap;
}

<style>
.btn-outline-soft { background:#fff; color:#111; border:1px solid #111; padding:8px 14px; border-radius:8px; text-decoration:none; display:inline-block; }
.btn-outline-soft:hover { background:#111; color:#fff; }
</style>

<div style="margin-bottom:16px;">
    <h3 style="margin:0;">Danh sách nộp bài - @baiTap?.TieuDe</h3>
</div>

@Html.AntiForgeryToken()

<table class="table">
    <thead>
        <tr>
            <th>Học sinh</th>
            <th>Ngày nộp</th>
            <th>Bài nộp của học sinh</th>
            <th>Trạng thái</th>
            <th>Điểm</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var s in Model)
        {
            <tr>
                <td>@(s.HocSinh?.HoTen ?? s.HocSinhId)</td>
                <td>@s.NgayNop.ToString("g")</td>
                <td style="max-width: 300px; word-break: break-word;">
                    @if (!string.IsNullOrEmpty(s.NoiDung))
                    {
                        <div style="margin-bottom: 6px;">@s.NoiDung</div>
                    }
                    @if (!string.IsNullOrEmpty(s.DuongDanFile))
                    {
                        <a href="@s.DuongDanFile" target="_blank" style="display:inline-flex; align-items:center; gap:4px; font-size:13px; color:#0d6efd; text-decoration:none; background:#eef5ff; padding:4px 10px; border-radius:6px;">
                            <i class="fa fa-paperclip"></i> Xem tệp đính kèm
                        </a>
                    }
                    @if (string.IsNullOrEmpty(s.NoiDung) && string.IsNullOrEmpty(s.DuongDanFile))
                    {
                        <span style="color:#888; font-style:italic;">Không có nội dung</span>
                    }
                </td>
                <td>@s.TrangThai</td>
                <td>
                    <div style="display:flex; gap:8px;">
                        <input type="number" class="form-control form-control-sm" style="width:70px" id="diem-@s.Id" value="@s.Diem?.ToString("0.#")" step="0.1" min="0" max="10" placeholder="--" onchange="chamDiem(@s.Id)" />
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>

<script>
    function getToken() {
        return document.querySelector('input[name="__RequestVerificationToken"]').value;
    }

    function chamDiem(baiNopId) {
        var inputEl = document.getElementById('diem-' + baiNopId);
        var diemStr = inputEl.value;
        var diem = diemStr === "" ? null : parseFloat(diemStr);

        // Hiệu ứng đang lưu
        inputEl.style.opacity = '0.5';

        fetch('@Url.Action("ChamDiemBaiTap", "GiangDay", new { area = "GiaoVien" })', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': getToken()
            },
            body: JSON.stringify({ baiNopId: baiNopId, diem: diem })
        }).then(r => r.json()).then(d => {
            inputEl.style.opacity = '1';
            if(d.success) {
                // Nháy xanh báo thành công
                var oldBg = inputEl.style.backgroundColor;
                inputEl.style.backgroundColor = '#dcfce7'; // xanh lục nhạt
                setTimeout(() => {
                    inputEl.style.backgroundColor = oldBg;
                }, 1000);
            } else {
                alert("Lỗi: " + d.message);
            }
        }).catch(e => {
            inputEl.style.opacity = '1';
            alert("Đã xảy ra lỗi mạng!");
        });
    }
</script>