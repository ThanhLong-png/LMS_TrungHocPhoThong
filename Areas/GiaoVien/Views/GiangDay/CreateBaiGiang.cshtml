@{
    ViewData["Title"] = "Tạo bài giảng";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
<script src="https://cdn.ckeditor.com/4.21.0/standard/ckeditor.js"></script>

<style>
@@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');
.bg-wrap{font-family:'Inter',sans-serif;max-width:820px;margin:0 auto;padding:0 4px}
.bg-hero{background:linear-gradient(135deg,#ff6b00 0%,#ff8c00 100%);border-radius:20px;padding:1.8rem 2rem;color:#fff;margin-bottom:1.8rem;position:relative;overflow:hidden;display:flex;align-items:center;gap:1rem;box-shadow:0 10px 30px rgba(255,107,0,0.15)}
.bg-hero::after{content:'';position:absolute;top:-30%;right:-5%;width:240px;height:240px;border-radius:50%;background:rgba(255,255,255,.07);pointer-events:none}
.bg-hero::before{content:'';position:absolute;bottom:-40%;left:5%;width:160px;height:160px;border-radius:50%;background:rgba(255,255,255,.05);pointer-events:none}
.bg-hero-icon{width:56px;height:56px;border-radius:14px;background:rgba(255,255,255,.18);display:flex;align-items:center;justify-content:center;font-size:1.5rem;flex-shrink:0;position:relative;z-index:1}
.bg-hero-text{position:relative;z-index:1;flex:1}
.bg-hero-text h1{font-size:1.5rem;font-weight:800;margin:0 0 .25rem}
.bg-hero-text p{font-size:.88rem;opacity:.75;margin:0}
.bg-back{display:inline-flex;align-items:center;gap:.4rem;padding:.4rem .85rem;border-radius:10px;background:rgba(255,255,255,.15);color:#fff;text-decoration:none;font-size:.82rem;font-weight:600;position:relative;z-index:1;transition:background .15s;white-space:nowrap}
.bg-back:hover{background:rgba(255,255,255,.25);color:#fff}
.bg-card{background:#fff;border-radius:16px;border:1px solid rgba(0,0,0,.06);box-shadow:0 4px 20px rgba(0,0,0,.07);overflow:hidden}
.bg-card-head{height:8px;background:linear-gradient(90deg,#ff6b00,#ff8c00,#ea580c)}
.bg-body{padding:2rem}
.bg-field{margin-bottom:1.4rem}
.bg-field label{display:block;font-size:.82rem;font-weight:700;color:#374151;margin-bottom:.5rem;text-transform:uppercase;letter-spacing:.04em}
.bg-field input[type=text],
.bg-field select,
.bg-field input[type=url],
.bg-field input[type=file]{width:100%;padding:10px 14px;border:1.5px solid #e2e8f0;border-radius:10px;font-size:.9rem;font-family:'Inter',sans-serif;color:#1e293b;background:#f8fafc;transition:border .2s;outline:none;box-sizing:border-box}
.bg-field input:focus,
.bg-field select:focus{border-color:#ff6b00;background:#fff;box-shadow:0 0 0 3px rgba(255,107,0,.1)}
.bg-field textarea.form-control{border:1.5px solid #e2e8f0;border-radius:10px;font-family:'Inter',sans-serif}
.bg-toggle-wrap{background:#fff7ed;border:1.5px solid #fed7aa;border-radius:12px;padding:1rem 1.2rem}
.bg-toggle-wrap .form-check-label{font-weight:600;color:#ff6b00;font-size:.9rem}
.bg-sub-field{background:#fff;border:1.5px solid #fed7aa;border-radius:10px;padding:.9rem 1rem;margin-top:.8rem}
.bg-sub-field label{font-size:.82rem;color:#ff6b00;margin-bottom:.4rem;display:block}
.bg-footer{display:flex;gap:10px;justify-content:flex-end;margin-top:1.8rem;padding-top:1.2rem;border-top:1px solid #f1f5f9}
.btn-post{background:linear-gradient(135deg,#ff6b00,#ea580c);color:#fff;padding:.7rem 1.6rem;border-radius:10px;border:none;font-size:.9rem;font-weight:700;cursor:pointer;font-family:'Inter',sans-serif;transition:all .18s;box-shadow:0 4px 12px rgba(255,107,0,.3);text-decoration:none;display:inline-flex;align-items:center;gap:.4rem}
.btn-post:hover{transform:translateY(-2px);box-shadow:0 8px 20px rgba(255,107,0,.4);color:#fff}
.btn-cancel-outline{background:#f1f5f9;color:#64748b;padding:.7rem 1.4rem;border-radius:10px;text-decoration:none;font-size:.9rem;font-weight:600;border:1.5px solid #e2e8f0;transition:all .15s}
.btn-cancel-outline:hover{background:#e2e8f0;color:#374151}
</style>

@{
    var lopsOfMonBG = ViewBag.LopsOfMon as List<LMS_THPT.Models.LopMonHoc> ?? new List<LMS_THPT.Models.LopMonHoc>();
    int defaultLopIdBG = (int)(ViewBag.DefaultLopId ?? 0);
}

<div class="bg-wrap">
  <div class="bg-hero">
    <div class="bg-hero-icon">📖</div>
    <div class="bg-hero-text">
      <h1>Tạo bài giảng mới</h1>
      <p>Soạn nội dung bài giảng và chia sẻ tài liệu cho học sinh</p>
    </div>
    <a asp-action="Index" asp-route-lopId="@ViewBag.LopId" asp-route-monHocId="@ViewBag.MonHocId" class="bg-back">← Quay lại</a>
  </div>

  <div class="bg-card">
    <div class="bg-card-head"></div>
    <div class="bg-body">
      <form asp-action="CreateBaiGiang" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()

        @* ── Chọn lớp ── *@
        <div class="bg-field">
          <label>Đăng cho lớp <span style="color:#ef4444">*</span></label>
          @if (!lopsOfMonBG.Any())
          {
              <div style="background:#fef3c7;border:1.5px solid #fde68a;border-radius:10px;padding:10px 14px;font-size:.88rem;color:#92400e;">
                  ⚠️ Bạn chưa được phân công lớp nào cho môn học này.
              </div>
          }
          else
          {
              <div style="display:flex;flex-wrap:wrap;gap:10px;padding:14px;background:#f8fafc;border-radius:12px;border:1.5px solid #e2e8f0;">
                  @foreach (var lmh in lopsOfMonBG)
                  {
                      bool isDefaultBG = lmh.LopId == defaultLopIdBG || (defaultLopIdBG == 0 && lmh == lopsOfMonBG.First());
                      <label style="display:inline-flex;align-items:center;gap:8px;cursor:pointer;padding:8px 16px;border-radius:10px;border:2px solid @(isDefaultBG ? "#ff6b00" : "#e2e8f0");background:@(isDefaultBG ? "#fff7ed" : "#fff");font-weight:600;font-size:.88rem;color:@(isDefaultBG ? "#ff6b00" : "#475569");transition:all .15s;">
                          <input type="checkbox" name="lopIds" value="@lmh.LopId"
                                 @(isDefaultBG ? "checked" : "")
                                 style="accent-color:#ff6b00;width:16px;height:16px;"
                                 onchange="updateLopLabelBG(this)" />
                          🏫 @(lmh.Lop?.TenLop ?? $"Lớp #{lmh.LopId}")
                      </label>
                  }
              </div>
              <div style="margin-top:6px;font-size:.78rem;color:#94a3b8;">Tick chọn một hoặc nhiều lớp để đăng bài giảng.</div>
          }
        </div>

        <div class="bg-field">
          <label>Tiêu đề bài giảng <span style="color:#ef4444">*</span></label>
          <input name="title" type="text" placeholder="Nhập tiêu đề bài giảng..." required />
        </div>

        <div class="bg-field">
          <label>Nội dung bài giảng</label>
          <textarea name="content" id="editor" rows="10" class="form-control"></textarea>
        </div>

        <div class="bg-field">
          <label>Tệp đính kèm</label>
          <input type="file" name="attachments" multiple />
          <div style="font-size:.78rem;color:#94a3b8;margin-top:4px">Hỗ trợ PDF, Word, hình ảnh, video...</div>
        </div>

        <div class="bg-field">
          <label>Chọn môn học</label>
          <select name="monHocId">
            <option value="">-- Chọn môn --</option>
            @foreach (var m in (ViewBag.TatCaMonHoc as IEnumerable<LMS_THPT.Models.MonHoc> ?? Enumerable.Empty<LMS_THPT.Models.MonHoc>()))
            {
              var selected = ViewBag.MonHoc != null && ((LMS_THPT.Models.MonHoc)ViewBag.MonHoc).Id == m.Id;
              var optHtml = $"<option value=\"{m.Id}\"{(selected ? " selected=\"selected\"" : "")}>" + System.Net.WebUtility.HtmlEncode(m.TenMonHoc) + "</option>";
              @Html.Raw(optHtml)
            }
          </select>
        </div>

        <div class="bg-field">
          <div class="bg-toggle-wrap">
            <div class="form-check form-switch mb-0">
              <input class="form-check-input" type="checkbox" id="tinhTienDo" name="tinhTienDo" value="true">
              <label class="form-check-label" for="tinhTienDo">Yêu cầu hoàn thành bài tập trắc nghiệm để tính tiến độ</label>
            </div>
            <div id="tracNghiemContainer" style="display:none" class="bg-sub-field">
              <label>Đường dẫn bài tập trắc nghiệm (Google Form, Quizizz, Microsoft Forms...)</label>
              <input type="url" name="linkTracNghiem" placeholder="https://..." />
            </div>
          </div>
        </div>

        <div class="bg-footer">
          <a asp-action="Index" asp-route-lopId="@ViewBag.LopId" asp-route-monHocId="@ViewBag.MonHocId" class="btn-cancel-outline">Hủy</a>
          <button type="submit" class="btn-post">📤 Đăng bài giảng</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
CKEDITOR.replace('editor');
document.getElementById('tinhTienDo').addEventListener('change', function() {
    document.getElementById('tracNghiemContainer').style.display = this.checked ? 'block' : 'none';
    if (!this.checked) document.querySelector('input[name="linkTracNghiem"]').value = '';
});

function updateLopLabelBG(cb) {
    var label = cb.closest('label');
    if (!label) return;
    if (cb.checked) {
        label.style.borderColor = '#ff6b00';
        label.style.background = '#fff7ed';
        label.style.color = '#ff6b00';
    } else {
        label.style.borderColor = '#e2e8f0';
        label.style.background = '#fff';
        label.style.color = '#475569';
    }
}
</script>